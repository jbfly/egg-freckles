local paths:=[[25,152,37,110,49,152],[30,134,44,134],[67,110,67,150,91,150],[109,150,109,110,127,110,133,117,127,128,109,128],[151,110,151,150],[175,110,175,150],[151,130,175,130],[193,152,205,110,217,152],[198,134,212,134],[25,212,37,170,49,212],[30,194,44,194],[67,170,67,210,91,210],[109,210,109,170,127,170,133,177,127,188,109,188],[151,170,151,210],[175,170,175,210],[151,190,175,190],[193,212,205,170,217,212],[198,194,212,194],[25,272,37,230,49,272],[30,254,44,254],[67,230,67,270,91,270],[109,270,109,230,127,230,133,237,127,248,109,248],[151,230,151,270],[175,230,175,270],[151,250,175,250],[193,272,205,230,217,272],[198,254,212,254],[25,332,37,290,49,332],[30,314,44,314],[67,290,67,330,91,330],[109,330,109,290,127,290,133,297,127,308,109,308],[151,290,151,330],[175,290,175,330],[151,310,175,310],[193,332,205,290,217,332],[198,314,212,314]]; local data:=[]; foreach path in paths do begin local target:=170; local packed:=[5,target]; local segments:=(Length(path) div 2)-1; local point:=0; while point<target do begin local x:=0; local y:=0; if point=(target-1) then begin x:=path[Length(path)-2]; y:=path[Length(path)-1]; end else begin local scaled:=(point*segments*1000) div (target-1); local seg:=scaled div 1000; local frac:=scaled-(seg*1000); local at:=seg*2; x:=path[at]+(((path[at+2]-path[at])*frac) div 1000); y:=path[at+1]+(((path[at+3]-path[at+1])*frac) div 1000); end; AddArraySlot(packed,x); AddArraySlot(packed,y); point:=point+1; end; AddArraySlot(data,{viewStationery:'poly,viewBounds:{left:0,top:0,right:320,bottom:428},points:ArrayToPoints(packed)}); end; local paper:=GetRoot().paperroll; local note:=paper:MakeTextNote("EF11 four-part watchdog proof",nil); note.data:=data; paper:NewNote(note,nil,nil); EntryChangeXmit(note,nil); "uid="&EntryUniqueID(note)&" strokes="&Length(note.data)&" rawExpected=6120 minY=110 maxY=332";
