local paths:=[[25,152,37,110,49,152],[30,134,44,134],[67,110,67,150,91,150],[109,150,109,110,127,110,133,117,127,128,109,128],[151,110,151,150],[175,110,175,150],[151,130,175,130],[193,152,205,110,217,152],[198,134,212,134],[25,180,25,220],[25,180,43,180,49,188,43,198,25,198],[25,198,44,198,50,208,44,220,25,220],[67,220,67,180,85,180,91,187,85,198,67,198],[79,198,92,220],[109,220,121,180,133,220],[114,204,128,204],[151,180,163,220,175,180],[199,180,211,180,217,187,217,213,211,220,199,220,193,213,193,187,199,180],[25,302,37,260,49,302],[30,284,44,284],[67,260,67,300,91,300],[109,300,109,260,127,260,133,267,127,278,109,278],[151,260,151,300],[175,260,175,300],[151,280,175,280],[193,302,205,260,217,302],[198,284,212,284]]; local data:=[]; local stroke:=0; foreach path in paths do begin local target:=85; if stroke>=18 then target:=100; local packed:=[5,target]; local segments:=(Length(path) div 2)-1; local point:=0; while point<target do begin local x:=0; local y:=0; if point=(target-1) then begin x:=path[Length(path)-2]; y:=path[Length(path)-1]; end else begin local scaled:=(point*segments*1000) div (target-1); local seg:=scaled div 1000; local frac:=scaled-(seg*1000); local at:=seg*2; x:=path[at]+(((path[at+2]-path[at])*frac) div 1000); y:=path[at+1]+(((path[at+3]-path[at+1])*frac) div 1000); end; AddArraySlot(packed,x); AddArraySlot(packed,y); point:=point+1; end; AddArraySlot(data,{viewStationery:'poly,viewBounds:{left:0,top:0,right:320,bottom:428},points:ArrayToPoints(packed)}); stroke:=stroke+1; end; local paper:=GetRoot().paperroll; local note:=paper:MakeTextNote("EF10 point-budget split proof",nil); note.data:=data; paper:NewNote(note,nil,nil); EntryChangeXmit(note,nil); "uid="&EntryUniqueID(note)&" strokes="&Length(note.data)&" expectedRaw=2430 minY=110 maxY=302";
