state/
__pycache__/
examples/hello/*.pkg
runtime/
# ponytail: evidence is tracked only when a doc cites it -- `git add -f` the
# specific files a round's notes reference; everything else stays local.
!runtime/evidence/
runtime/evidence/*
secrets/
.env

# Mirrored recovery binaries are kept locally; metadata and fetch script are tracked.
downloads/recovery/*.pkg

# Apple-copyrighted reference material and NIE distributions are never tracked.
# Run refs/fetch-refs.sh and downloads/fetch-downloads.sh once after cloning;
# each verifies its downloads against the SHA256SUMS beside it.
refs/*.pdf
refs/*.txt
refs/nie11/
refs/qa/
downloads/*.ZIP
downloads/*.EXE
downloads/*.sea.hqx
downloads/NIM-source.zip
