kAppSymbol := '|InkPad:jbfly|;
kAppTitle := "Ink Pad";
kVersion := "1.0";

mainView := {
    _proto: protoFloatNGo,
    viewBounds: {left: 8, top: 24, right: 312, bottom: 440},
    title: kAppTitle,
    appSymbol: kAppSymbol,
    strokeCount: 0,
    strokes: [],
    inkLeft: 0,
    inkTop: 0,
    pending: nil,
    busy: nil,
    gotReply: nil,
    statusView: nil,
    inkView: nil,
    endpointClass: {_proto: protoBasicEndpoint},
    endpoint: nil,
    linkID: nil,

    ViewSetupDoneScript: func()
    begin
        inherited:?ViewSetupDoneScript();
        self.strokes := [];
        AddDelayedCall(func(view) view:Wire(), [self], 300);
    end,

    // ponytail: find children by geometry because Newton reorders child views
    // and viewFrontKey points at whichever control was tapped last.
    Wire: func()
    begin
        local kids := :ChildViewFrames();
        if kids = nil then return nil;
        local rootBox := self:GlobalBox();
        foreach child in kids do
        begin
            local box := child:GlobalBox();
            local top := box.top - rootBox.top;
            local left := box.left - rootBox.left;
            if (top = 304) and (left = 8) then self.statusView := child;
            if (top = 30) and (left = 8) then self.inkView := child;
        end;
        return nil;
    end,

    SetStatus: func(message)
    begin
        if self.statusView = nil then :Wire();
        if self.statusView then SetValue(self.statusView, 'text, message);
        return nil;
    end,

    StrokeText: func()
        if self.strokeCount = 1 then "1 stroke" else self.strokeCount & " strokes",

    CountStroke: func(points, originLeft, originTop)
    begin
        // ponytail: the ink view reports its own screen origin, so the encoder
        // never carries a hardcoded offset that silently rots when I move a view.
        self.inkLeft := originLeft;
        self.inkTop := originTop;
        AddArraySlot(self.strokes, points);
        self.strokeCount := self.strokeCount + 1;
        :SetStatus(:StrokeText());
        return nil;
    end,

    Clear: func()
    begin
        if self.busy then return :SetStatus("Wait for the reply");
        self.strokes := [];
        self.strokeCount := 0;
        if self.inkView then
        begin
            self.inkView:Dirty();
            RefreshViews();
        end;
        return :SetStatus("Ready");
    end,

    Encode: func()
    begin
        local body := "NSI1 320 480 " & self.strokeCount & "\r\n";
        foreach points in self.strokes do
        begin
            local count := Length(points) div 2;
            local line := "S " & count;
            if count > 0 then
            begin
                // ponytail: GetPointsArray is a flat Y/X list in view coordinates.
                local x := points[1] + self.inkLeft;
                local y := points[0] + self.inkTop;
                line := line & " " & x & " " & y;
                local index := 2;
                while index < Length(points) do
                begin
                    local nextX := points[index + 1] + self.inkLeft;
                    local nextY := points[index] + self.inkTop;
                    line := line & " " & (nextX - x) & " " & (nextY - y);
                    x := nextX;
                    y := nextY;
                    index := index + 2;
                end;
            end;
            body := body & line & "\r\n";
            // ponytail: one HTTP request only; multipart belongs to a later stage.
            if StrLen(body) > 16384 then return nil;
        end;
        return body;
    end,

    Stop: func()
    begin
        if self.endpoint then
        begin
            try self.endpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.endpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.endpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.endpoint := nil;
        end;
        if self.linkID then
        begin
            call GetGlobalFn('InetReleaseLink) with (self.linkID, self, 'Released);
            self.linkID := nil;
        end;
        return nil;
    end,

    Released: func(id, state, error) nil,

    Send: func()
    begin
        // ponytail: one slot is the whole double-Send guard; no request queue.
        if self.busy then return nil;
        if self.strokeCount = 0 then return :SetStatus("Draw something first");
        local body := :Encode();
        if body = nil then return :SetStatus("Too much ink to send");
        self.pending := body;
        self.busy := true;
        self.gotReply := nil;
        :SetStatus("Sending...");
        AddDelayedCall(func(view) view:Expired(), [self], 150000);
        call GetGlobalFn('InetGrabLink) with (nil, self, 'Grabbed);
        return nil;
    end,

    Expired: func()
    begin
        if not self.busy then return nil;
        self.busy := nil;
        :SetStatus("The host did not answer. Your ink is still here.");
        return :Stop();
    end,

    Grabbed: func(id, state, error)
    begin
        if self.endpoint then return nil;
        if error then return :Failed("No network link");
        self.linkID := id;
        if state.linkStatus <> 'connected then return nil;
        local address := [10, 42, 0, 1];
        try
        begin
            self.endpoint := {_proto: self.endpointClass, _parent: self};
            self.endpoint:Instantiate(self.endpoint, [
                {label: "inet", type: 'service, opCode: opSetRequired, result: nil},
                {
                    label: "ilid", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {arglist: [self.linkID], typeList: ['struct, 'ulong]},
                },
                {
                    label: "itsv", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {arglist: [1], typeList: ['struct, 'ulong]},
                },
            ]);
            self.endpoint:Bind(nil, {async: nil, reqTimeout: 10000});
            self.endpoint:connect([
                {
                    label: "itrs", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {
                        arglist: [address[0], address[1], address[2], address[3], 18081],
                        typeList: ['struct, 'byte, 'byte, 'byte, 'byte, 'short],
                    },
                },
            ], {async: nil, reqTimeout: 45000});
            :Post(self.pending);
        end
        onexception |evt.ex| do
            :Failed("Could not reach the host");
        return nil;
    end,

    Post: func(body)
    begin
        self.endpoint:SetInputSpec({
            _parent: self,
            form: 'string,
            termination: {endSequence: "\r\n"},
            discardAfter: 256,
            // ponytail: the model call measures ~9 s, so one long synchronous
            // read is enough; no job id, no polling.
            reqTimeout: 150000,
            InputScript: func(endpoint, data, terminator, options)
                self._parent:HandleLine(data),
            CompletionScript: func(endpoint, options, result)
                self._parent:Dropped(),
        });
        local request := "POST /ink HTTP/1.0\r\nHost: 10.42.0.1\r\n"
            & "Content-Type: application/x-newton-strokes\r\nContent-Length: "
            & StrLen(body) & "\r\nConnection: close\r\n\r\n" & body;
        self.endpoint:output(request, nil, {async: nil, reqTimeout: 10000});
        self.pending := nil;
        :SetStatus("Thinking...");
        try self.endpoint:Input() onexception |evt.ex.comm| do nil;
        return nil;
    end,

    HandleLine: func(line)
    begin
        if BeginsWith(line, "INK ") then
        begin
            self.gotReply := true;
            // ponytail: endpoint callbacks retain the CRLF terminator, and the
            // "INK " prefix separates the body from the HTTP header lines.
            :SetStatus(SubStr(line, 4, StrLen(line) - 6));
        end;
        return nil;
    end,

    Dropped: func()
    begin
        self.busy := nil;
        if not self.gotReply then :SetStatus("The host sent no reading");
        // ponytail: disposing the endpoint inside this callback is what raised
        // -48200 after the Stage 3 reply; let the close settle first.
        AddDelayedCall(func(view) view:Stop(), [self], 1000);
        return nil;
    end,

    Failed: func(message)
    begin
        self.busy := nil;
        :SetStatus(message);
        AddDelayedCall(func(view) view:Stop(), [self], 1000);
        return nil;
    end,

    stepChildren: [
        {
            _proto: protoStaticText,
            viewBounds: {left: 8, top: 4, right: 288, bottom: 22},
            text: "Draw here, then tap Send",
            viewFont: ROM_fontSystem10,
        },
        // ponytail: two plain rules mark out the writing area. vfFrame is
        // undefined in this platform file, and stock rules beat a custom border.
        // protoDivider inherits the app's `title` slot unless it is cleared,
        // which is why each one names its own empty title.
        {
            _proto: protoDivider,
            viewBounds: {left: 0, top: 24, right: 304, bottom: 26},
            title: "",
        },
        {
            viewClass: clView,
            viewBounds: {left: 8, top: 30, right: 288, bottom: 292},
            viewFlags: vVisible + vClickable + vStrokesAllowed,

            ViewStrokeScript: func(unit)
            begin
                local box := self:GlobalBox();
                self:Parent():CountStroke(GetPointsArray(unit), box.left, box.top);
                return nil;
            end,
        },
        {
            _proto: protoDivider,
            viewBounds: {left: 0, top: 296, right: 304, bottom: 298},
            title: "",
        },
        {
            _proto: protoStaticText,
            viewBounds: {left: 8, top: 304, right: 288, bottom: 352},
            text: "Ready",
            viewFont: ROM_fontSystem10,
        },
        {
            _proto: protoTextButton,
            viewBounds: {left: 8, top: 358, right: 80, bottom: 390},
            text: "Clear",
            buttonClickScript: func() self:Parent():Clear(),
        },
        {
            _proto: protoTextButton,
            viewBounds: {left: 215, top: 358, right: 288, bottom: 390},
            text: "Send",
            buttonClickScript: func() self:Parent():Send(),
        },
    ],
};

{
    app: kAppSymbol,
    text: kAppTitle,
    theForm: mainView,
}
