// "Egg Freckles" is the product, not a round number: one package the human
// installs once, carrying the chat window, the Ask/Save Note bridge to stock
// Notes, AND the fixed-op /tools channel that used to be a second package
// (`HarnessToolsR10P`, deleted in this round). Two packages was the first
// complaint of the second hardware test; a second tools app also meant two NIE
// clients fighting for one broker slot and raising `Communications` alerts.
// The round tag lives only in the identity and the version string — EF1, EF2,
// … — because the identity may never be reused (docs/phase3-chat-round.md,
// "Package identity") while the name on the Extras icon should stay put.
kAppSymbol := '|EggFrecklesEF1:jbfly|;
kVersion := "1.0-ef1";
kAppTitle := "Egg Freckles " & kVersion;
kAppLabel := "Egg Freckles";

// The window is centred at setup time from the live root box instead of being
// hardcoded, so it lands in the middle of whatever screen the ROM reports.
kWinWidth := 304;
kWinHeight := 428;

// The transcript is one bounded string, trimmed from the front at line
// boundaries. 6 KiB is the whole conversation budget on a 1990s device.
kTranscriptCap := 6144;
// The pane clips by rendered *rows*, not by characters. A7 showed the last 640
// characters, which for a short-line reply (/help, /status) is three times what
// the pane can draw, so the end ran off the bottom unreachably — the defect the
// first hardware test found. A8 wraps the transcript onto this row grid itself
// and shows one window of it, so what is on screen is exactly what fits.
// 38 characters is ~266 px of ROM_fontSystem10 at its widest, inside the 276 px
// pane; 12 rows at viewLineSpacing 14 is 168 px, inside the 174 px pane.
kRowChars := 38;
kVisibleRows := 12;
// One tap moves a window less two rows, so the eye can join the pages.
kScrollOverlap := 2;

// A frame is ":" & body & "*HH" & CRLF, so 240 bytes leaves 234 for the body.
// A plain MSG body is "SS MSG " & text: 234 - 7 = 227 characters of prompt fit.
// A part body is "SS MSGP KK NN " & chunk: 234 - 14 = 220. Longer prompts go
// out as MSGP parts; 8 KiB total is the host's cap (server.py MAX_PROMPT).
kFrameBytes := 227;
kPartBytes := 220;
kMaxPrompt := 8192;
// ponytail: a note goes through the same MSGP path as a typed prompt, but
// Clean() rebuilds it one character at a time, and that is O(n^2) on this CPU.
// 2048 characters is ten MSGP parts and still a second of work; the host would
// accept 8192.
kNoteBytes := 2048;

// ---- "Ask" budgets ----
// How many entries back from the end of the _uniqueID cursor "Ask" looks. The
// scan is bounded so it can never starve the 3 s host heartbeat (twelfth
// finding), and EntryUniqueID reads the identifier "without reading the entry
// into the cache" (refs/NewtonProgrammerRef20.txt:34872), so each step is cheap.
kScanLimit := 16;
// The probe note held 9 drawn items and 279 points, ~1.1 KB of NSI1 against the
// host's 16 KiB single-body cap, so these caps only ever fire on something far
// larger than a page of drawing. Truncating loudly beats building an unbounded
// string on a 162 MHz ARM.
kMaxPoints := 400;
kMaxItems := 64;
// The note's own text rides one optional NSI1 "H" line into the vision prompt.
kHintBytes := 200;
// Ink Text leaves this placeholder character (0xF701) in a paragraph's `text`,
// once per ink word, and the word itself is in `styles` as an 'inkWord binary.
kInkPlaceholder := 63233;

mainView := {
    _proto: protoFloatNGo,
    // Replaced at setup time by :CenterBounds(); these are the fallback if the
    // root view will not report a box.
    viewBounds: {left: 8, top: 26, right: 312, bottom: 454},
    // No viewFlags override. The eighteenth finding's open experiment — "would
    // adding vApplication make the ROM's scroll arrows work?" — was run in this
    // round and the answer is NO, measured rather than assumed:
    //
    //   viewFlags 580 (vFloating + vClickable + vApplication) went in, the live
    //   window read 581 with vVisible added, the root view's own flags are 5 so
    //   the parent chain qualifies, ViewScrollUpScript/ViewScrollDownScript were
    //   supplied and both worked when called directly (scrollRow 0 -> 10) —
    //   and tapping the ROM's up arrow at (309,461) changed **nothing at all**:
    //   zero pixels, scrollRow still 0. The same tap scrolls the Notepad when
    //   this window is closed, so the hit point is right.
    //
    // The mechanism is documented: scroll routing resolves like
    // 'viewFrontMostApp, "not including floating views (those with vFloating set
    // in their viewFlags slot)" (refs/NewtonProgrammerRef20.txt:4510-4512). A
    // floating window is excluded by definition, flag or no flag — which the
    // tools channel confirms from the other side, because front_app still
    // answers "Notepad (paperroll)" while this window is open. The transcript
    // therefore keeps its own Up/Dn buttons, and the scroll scripts are gone
    // rather than shipped dead.
    title: kAppTitle,
    appSymbol: kAppSymbol,
    endpointClass: {_proto: protoBasicEndpoint},
    endpoint: nil,
    linkID: nil,
    // ponytail: tntk segfaults on a top-level constant inside a function body,
    // so the caps live in slots. Slot names must not collide with a method
    // name: NewtonScript symbols are case-insensitive.
    capBytes: kTranscriptCap,
    rowChars: kRowChars,
    visibleRows: kVisibleRows,
    scrollOverlap: kScrollOverlap,
    // How many rows above the newest the visible window starts. 0 is the live
    // bottom, and every new line puts it back there.
    scrollRow: 0,
    frameBytes: kFrameBytes,
    partBytes: kPartBytes,
    maxPrompt: kMaxPrompt,
    noteBytes: kNoteBytes,
    // ponytail: a Newton paragraph breaks lines on CR (0x0D); NewtonScript's
    // "\n" is 0x0A, which draws as an empty box and breaks nothing. tntk
    // silently emits "" for a CR escape literal, so set it at setup time.
    newline: nil,
    version: kVersion,
    transcript: "",
    transcriptView: nil,
    promptView: nil,
    statusView: nil,
    responseText: "",
    // The last completed agent answer, so "Save Note" can write it to Notes.
    lastReply: "",
    txSeq: 1,
    ready: nil,
    inFlight: nil,
    draftSeq: nil,
    stopping: nil,
    // MSGP parts still waiting for their ACK, and how many have gone out.
    pendingParts: nil,
    partIndex: 0,
    // ---- "Ask" state ----
    // There is deliberately no `inkOpen` slot: NewtonScript symbols are
    // case-insensitive, so it shadowed the InkOpen method and every ink Send
    // threw -48200 (the same trap as capBytes/TranscriptTail in A2).
    scanLimit: kScanLimit,
    maxPoints: kMaxPoints,
    maxItems: kMaxItems,
    hintBytes: kHintBytes,
    placeholder: kInkPlaceholder,
    // What the last Ask read out of the newest note: its paragraph text, its
    // strokes as flat x,y arrays in the note's own space, and the top-left of
    // the drawn items' bounding box, which is the origin the encoder removes.
    askText: "",
    askStrokes: nil,
    askPoints: 0,
    askLeft: nil,
    askTop: nil,
    askTruncated: nil,
    inkBody: nil,
    inkBusy: nil,
    inkGotReply: nil,
    inkEndpoint: nil,
    inkPort: 18081,
    // ---- tools channel state (folded in from the deleted harness-tools) ----
    // A third connection on the same NIE link: the host's long poll on 18081.
    // Every slot here is prefixed so it cannot collide case-insensitively with
    // a method name — the -48200 trap that cost two rounds.
    toolEndpoint: nil,
    toolReady: nil,
    toolMisses: 0,
    toolStopping: nil,
    toolID: nil,
    toolOutcome: nil,
    toolValue: nil,
    toolPort: 18081,
    winWidth: kWinWidth,
    winHeight: kWinHeight,
    // The physical build always uses Mars. An emulator round may override this
    // slot through ns_eval without rebuilding or changing the package identity.
    serverAddress: [10, 42, 0, 1],
    serverPort: 6801,

    // viewBounds has to be final before the view is laid out, which is what
    // ViewSetupFormScript is for. A9 shipped a hardcoded box; the human's
    // second hardware test said the window loads off-centre, and a constant can
    // only ever be centred on the one screen it was measured against.
    ViewSetupFormScript: func()
    begin
        :CenterBounds();
        inherited:?ViewSetupFormScript();
    end,

    CenterBounds: func()
    begin
        local box := nil;
        try box := GetRoot():LocalBox() onexception |evt.ex| do box := nil;
        if box = nil then return nil;
        local wide := box.right - box.left;
        local high := box.bottom - box.top;
        if (wide < self.winWidth) or (high < self.winHeight) then return nil;
        local left := box.left + ((wide - self.winWidth) div 2);
        local top := box.top + ((high - self.winHeight) div 2);
        self.viewBounds := {left: left, top: top,
            right: left + self.winWidth, bottom: top + self.winHeight};
        return nil;
    end,

    ViewSetupDoneScript: func()
    begin
        inherited:?ViewSetupDoneScript();
        self.newline := Chr(13);
        // ponytail: template literals live in the read-only package, so the
        // retained stroke array has to be re-made in the heap before anything
        // grows it.
        self.askStrokes := [];
        // ponytail: the child list is not reachable until the view is fully open.
        //
        // Every AddDelayedCall in this file carries the same try guard, and it
        // is not decoration. A delayed call already in the queue still fires
        // after the window closes, and `view:AnyMethod()` on a closed view
        // raises -48809 "undefined method"
        // (docs/newton-networking-lessons.md §1.4) — which the ROM shows the
        // human as a modal "Sorry, a problem has occurred (-48809)" slip.
        // Measured this round: closing the window raised exactly that, from the
        // 4-second tools watchdog landing on the corpse. The guard is what makes
        // closing the app silent.
        AddDelayedCall(func(view) try view:Boot() onexception |evt.ex| do nil, [self], 800);
    end,

    ViewQuitScript: func()
    begin
        self.stopping := true;
        self.toolStopping := true;
        :ToolStop();
        :Stop();
        inherited:?ViewQuitScript();
    end,

    Boot: func()
    begin
        :Wire();
        :ShowTranscript();
        :Connect();
        // The tools long poll opens after the chat link, so it finds a held
        // NIE link and never grabs a second one. If chat is still connecting,
        // ToolStart grabs its own and the two share whichever arrives first.
        AddDelayedCall(func(view) try view:ToolStart() onexception |evt.ex| do nil, [self], 2500);
    end,

    // ponytail: custom template slots do not survive instantiation and a child's
    // index is not stable, but its unique top edge is. Wire lazily: the child
    // list is not available yet while the view is still being set up.
    Wire: func()
    begin
        local kids := :ChildViewFrames();
        if kids = nil then return nil;
        local rootTop := self:GlobalBox().top;
        foreach child in kids do
        begin
            local top := child:GlobalBox().top - rootTop;
            if top = 32 then self.transcriptView := child
            else if top = 236 then self.promptView := child
            else if top = 364 then self.statusView := child;
        end;
        return nil;
    end,

    SetStatus: func(message)
    begin
        if self.statusView = nil then :Wire();
        if self.statusView then SetValue(self.statusView, 'text, message);
        return nil;
    end,

    PromptField: func()
    begin
        if self.promptView = nil then :Wire();
        return self.promptView;
    end,

    // StrPos with a Chr(13) needle raises interpreter error -48802 on this ROM,
    // although the same call with a printable needle works. Scan by hand.
    // Evidence: docs/newton-dev-notes.md, the Track F1 round.
    FindBreak: func(text, from)
    begin
        local size := StrLen(text);
        for index := from to size - 1 do
            if Ord(text[index]) = 13 then return index;
        return nil;
    end,

    AppendLine: func(line)
    begin
        self.transcript := self.transcript & line & self.newline;
        local cut := 0;
        while (StrLen(self.transcript) > self.capBytes) and (cut <> nil) do
        begin
            cut := :FindBreak(self.transcript, 0);
            if cut <> nil then
                self.transcript := SubStr(self.transcript, cut + 1,
                    StrLen(self.transcript) - cut - 1);
        end;
        // New text always returns the window to the live bottom.
        self.scrollRow := 0;
        return nil;
    end,

    // The whole transcript as an array of rows that each fit the pane's width,
    // so the paragraph never wraps a row itself and a row count is a pixel
    // count. Words stay whole unless a word is longer than most of a row.
    WrapRows: func()
    begin
        local rows := [];
        local size := StrLen(self.transcript);
        local index := 0;
        while index < size do
        begin
            local stop := :FindBreak(self.transcript, index);
            if stop = nil then stop := size;
            if stop = index then AddArraySlot(rows, "");
            local at := index;
            while at < stop do
            begin
                local take := stop - at;
                if take > self.rowChars then
                begin
                    take := self.rowChars;
                    local scan := take;
                    while (scan > 12) and (Ord(self.transcript[at + scan - 1]) <> 32) do
                        scan := scan - 1;
                    if scan > 12 then take := scan;
                end;
                AddArraySlot(rows, SubStr(self.transcript, at, take));
                at := at + take;
            end;
            index := stop + 1;
        end;
        return rows;
    end,

    // One window of those rows, ending scrollRow rows above the newest.
    VisibleText: func()
    begin
        local rows := :WrapRows();
        local total := Length(rows);
        local first := total - self.visibleRows - self.scrollRow;
        if first < 0 then first := 0;
        local last := first + self.visibleRows;
        if last > total then last := total;
        local text := "";
        for index := first to last - 1 do
        begin
            if index > first then text := text & self.newline;
            text := text & rows[index];
        end;
        return text;
    end,

    // Move the window and redraw. Clamped at both ends, so a tap at the top or
    // the bottom of the conversation is a no-op rather than a lost position.
    ScrollBy: func(count)
    begin
        local limit := Length(:WrapRows()) - self.visibleRows;
        if limit < 0 then limit := 0;
        local target := self.scrollRow + count;
        if target > limit then target := limit;
        if target < 0 then target := 0;
        self.scrollRow := target;
        return :ShowTranscript();
    end,

    ScrollUp: func() :ScrollBy(self.visibleRows - self.scrollOverlap),

    ScrollDown: func() :ScrollBy(self.scrollOverlap - self.visibleRows),

    ShowTranscript: func()
    begin
        if self.transcriptView = nil then :Wire();
        if self.transcriptView then
        begin
            local text := :VisibleText();
            // ponytail: a live paragraph rejects an empty string, so an empty
            // conversation shows the hint instead.
            if StrLen(text) = 0 then text := "Type a prompt below, then tap Send.";
            SetValue(self.transcriptView, 'text, text);
        end;
        return nil;
    end,

    // ponytail: on-device proof of the 6 KiB cap and of the row window; the
    // status line is the assert. Scrolling is proven the only way that means
    // anything — the visible text after a page up is not the visible text at
    // the bottom.
    SelfTest: func()
    begin
        local saved := self.transcript;
        local filler := "0123456789012345678901234567890123456789";
        self.transcript := "";
        for index := 1 to 400 do :AppendLine("" & index & " " & filler);
        local size := StrLen(self.transcript);
        local firstBreak := :FindBreak(self.transcript, 0);
        local first := SubStr(self.transcript, 0, firstBreak);
        local rows := Length(:WrapRows());
        local bottom := :VisibleText();
        :ScrollUp();
        local paged := :VisibleText();
        local ok := (size <= self.capBytes) and (size > 5000)
            and (StrPos(self.transcript, "400 " & filler, 0) <> nil)
            and (StrPos(first, filler, 0) <> nil)
            and (rows > self.visibleRows) and (self.scrollRow > 0)
            and (paged <> bottom);
        self.scrollRow := 0;
        self.transcript := saved;
        :ShowTranscript();
        :SetStatus("Cap test " & (if ok then "PASS" else "FAIL")
            & ": size=" & size & " rows=" & rows & " first=" & first);
        return nil;
    end,

    SeqText: func(seq)
        if seq < 10 then "0" & seq else "" & seq,

    EncodeBody: func(body)
    begin
        local digits := "0123456789ABCDEF";
        local sum := 0;
        for index := 0 to StrLen(body) - 1 do
            sum := BAND(sum + Ord(body[index]), 255);
        return ":" & body & "*" & SubStr(digits, Floor(sum / 16), 1)
            & SubStr(digits, BAND(sum, 15), 1) & "\r\n";
    end,

    Stop: func()
    begin
        self.stopping := true;
        if self.endpoint then
        begin
            try self.endpoint:SetInputSpec(nil) onexception |evt.ex.comm| do nil;
            try self.endpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.endpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.endpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.endpoint := nil;
        end;
        if self.inkEndpoint then
        begin
            try self.inkEndpoint:SetInputSpec(nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.inkEndpoint := nil;
        end;
        :ReleaseLink();
        self.ready := nil;
        self.inFlight := nil;
        self.draftSeq := nil;
        self.pendingParts := nil;
        self.partIndex := 0;
    end,

    // One NIE link, three connections: chat, ink POST, tools long poll. Whoever
    // shuts down last releases it. Releasing it under a live endpoint is what
    // raised the -48803 overlays in the loader rounds
    // (docs/newton-networking-lessons.md §1.5), and dropping it to open a
    // second connection cost the Track F2 round a -16009.
    ReleaseLink: func()
    begin
        if self.endpoint or self.inkEndpoint or self.toolEndpoint then return nil;
        if self.linkID then
        begin
            call GetGlobalFn('InetReleaseLink) with (self.linkID, self, 'Released);
            self.linkID := nil;
        end;
        return nil;
    end,

    Released: func(id, state, error) nil,

    Connect: func()
    begin
        :Stop();
        self.stopping := nil;
        :SetStatus("Connecting");
        // If the tools poll (or a live ink POST) still holds the link, reuse it
        // rather than grabbing a second one: a grab that is never matched by a
        // release leaks, and this is the same rule SendInk follows.
        if self.linkID then return :OpenSession();
        call GetGlobalFn('InetGrabLink) with (nil, self, 'Grabbed);
        return nil;
    end,

    Grabbed: func(id, state, error)
    begin
        if self.stopping then return nil;
        if self.endpoint then return nil;
        if error then return :Failed("Network error " & error);
        self.linkID := id;
        if state.linkStatus <> 'connected then return nil;
        :OpenSession();
    end,

    OpenSession: func()
    begin
        local address := self.serverAddress;
        local callName := "Instantiate";
        self.endpoint := {_proto: self.endpointClass, _parent: self,
            ExceptionHandler: func(error) self._parent:Dropped()};
        try
        begin
            self.endpoint:Instantiate(self.endpoint, [
                {label: "inet", type: 'service, opCode: opSetRequired, result: nil},
                {
                    label: "ilid", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {arglist: [self.linkID], typeList: ['struct, 'ulong]},
                },
                {
                    label: "itsv", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {arglist: [1], typeList: ['struct, 'ulong]},
                },
            ]);
            callName := "Bind";
            self.endpoint:Bind(nil, {
                async: true, reqTimeout: 10000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    if result then self._parent:Failed("Bind error " & result)
                    else self._parent:Bound(),
            });
        end
        onexception |evt.ex| do
        begin
            local exception := CurrentException();
            local exceptionError := call GetGlobalFn('InetGetExceptionError) with (exception);
            :Failed(callName & " error " & exceptionError);
        end;
    end,

    Bound: func()
    begin
        if self.stopping then return nil;
        local address := self.serverAddress;
        try
            self.endpoint:connect([
                {
                    label: "itrs", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {
                        arglist: [address[0], address[1], address[2], address[3], self.serverPort],
                        typeList: ['struct, 'byte, 'byte, 'byte, 'byte, 'short],
                    },
                },
            ], {
                async: true, reqTimeout: 45000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    if result then self._parent:Failed("Connect error " & result)
                    else self._parent:Connected(),
            })
        onexception |evt.ex.comm| do :Failed("Connect exception");
        return nil;
    end,

    Connected: func()
    begin
        if self.stopping then return nil;
        :Hello();
        return nil;
    end,

    Hello: func()
    begin
        self.responseText := "";
        self.txSeq := 1;
        self.ready := nil;
        :ArmInput();
        try self.endpoint:output("~NEWTONCLI 1\r\n", nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                if result then self._parent:Failed("Handshake error " & result)
                else self._parent:HelloMarkerSent(),
        })
        onexception |evt.ex.comm| do :Failed("Handshake exception");
        return nil;
    end,

    ArmInput: func()
    begin
        if self.stopping or (self.endpoint = nil) then return nil;
        try
        self.endpoint:SetInputSpec({
            _parent: self,
            form: 'string,
            // ponytail: protocol lines are capped at 240 bytes.
            termination: {endSequence: "\r\n"},
            discardAfter: 240,
            InputScript: func(endpoint, data, terminator, options)
                self._parent:HandleLine(data),
            CompletionScript: func(endpoint, options, result)
                self._parent:Dropped(),
        })
        onexception |evt.ex.comm| do :Failed("Input exception");
        return nil;
    end,

    HelloMarkerSent: func()
    begin
        if self.stopping then return nil;
        try self.endpoint:output(:EncodeBody("00 HELLO NEWTON1 " & self.version), nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                if result then self._parent:Failed("Hello error " & result),
        })
        onexception |evt.ex.comm| do :Failed("Hello exception");
        return nil;
    end,

    HandleLine: func(line)
    begin
        if BeginsWith(line, "ACK ") then
        begin
            if (self.draftSeq <> nil) and BeginsWith(line, "ACK " & :SeqText(self.draftSeq)) then
            begin
                self.draftSeq := nil;
                // Stop-and-wait: the ACK for part k is what releases part k+1.
                if (self.pendingParts <> nil) and (self.partIndex < Length(self.pendingParts)) then
                    return :SendPart();
                self.pendingParts := nil;
                local field := :PromptField();
                if field then
                    try SetValue(field, 'text, "") onexception |evt.ex| do nil;
            end;
            return nil;
        end;
        // A NAK aborts the turn visibly instead of leaving it hung in flight.
        if BeginsWith(line, "NAK ") then
        begin
            self.draftSeq := nil;
            self.pendingParts := nil;
            self.partIndex := 0;
            self.inFlight := nil;
            self.ready := true;
            return :SetStatus(line);
        end;
        if (StrLen(line) < 9) or not BeginsWith(line, ":") then return nil;
        local star := StrPos(line, "*", 0);
        if star = nil then return nil;
        local seqText := SubStr(line, 1, 2);
        try self.endpoint:output("ACK " & seqText & "\r\n", nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                if result then self._parent:Failed("ACK error " & result),
        })
        onexception |evt.ex.comm| do return :Failed("ACK exception");
        if BeginsWith(line, ":" & seqText & " STAT READY*") then
        begin
            self.ready := true;
            :SetStatus("Ready");
        end else if BeginsWith(line, ":" & seqText & " STAT THINKING*") then
            :SetStatus("Thinking")
        else if BeginsWith(line, ":" & seqText & " STAT ERROR ") then
        begin
            self.ready := true;
            self.inFlight := nil;
            self.responseText := "ERROR: " & SubStr(line, 15, star - 15);
            :SetStatus(self.responseText);
        end else if BeginsWith(line, ":" & seqText & " TEXT ") then
        begin
            if StrLen(self.responseText) > 0 then
                self.responseText := self.responseText & self.newline;
            self.responseText := self.responseText & SubStr(line, 9, star - 9);
        end else if BeginsWith(line, ":" & seqText & " PROMPT*") then
        begin
            :AppendLine("Agent: " & self.responseText);
            :AppendLine("");
            :ShowTranscript();
            // Held for "Save Note"; the reply is written to Notes only on tap.
            self.lastReply := self.responseText;
            self.responseText := "";
            self.ready := true;
            self.inFlight := nil;
            :SetStatus("Ready");
        end;
        return nil;
    end,

    // One frame out, sequence number claimed, draft held until its ACK.
    SendBody: func(tail)
    begin
        local encoded := :EncodeBody(:SeqText(self.txSeq) & tail);
        self.draftSeq := self.txSeq;
        try self.endpoint:output(encoded, nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                if result then self._parent:Failed("Send error " & result),
        })
        onexception |evt.ex.comm| do return :Failed("Send exception");
        self.txSeq := (self.txSeq + 1) mod 100;
        return nil;
    end,

    SendPart: func()
    begin
        local total := Length(self.pendingParts);
        local chunk := self.pendingParts[self.partIndex];
        self.partIndex := self.partIndex + 1;
        :SetStatus("Sending " & self.partIndex & "/" & total);
        return :SendBody(" MSGP " & :SeqText(self.partIndex) & " "
            & :SeqText(total) & " " & chunk);
    end,

    Send: func(text)
    begin
        if StrLen(text) > self.maxPrompt then return :SetStatus("Prompt too long");
        self.ready := nil;
        self.inFlight := true;
        self.responseText := "";
        self.pendingParts := nil;
        self.partIndex := 0;
        if StrLen(text) <= self.frameBytes then
        begin
            :SetStatus("Thinking");
            return :SendBody(" MSG " & text);
        end;
        // Too long for one frame: MSGP parts, one in flight at a time.
        local parts := [];
        local index := 0;
        while index < StrLen(text) do
        begin
            // ponytail: do not rely on SubStr clamping a short tail.
            local take := StrLen(text) - index;
            if take > self.partBytes then take := self.partBytes;
            AddArraySlot(parts, SubStr(text, index, take));
            index := index + take;
        end;
        self.pendingParts := parts;
        return :SendPart();
    end,

    SendPrompt: func()
    begin
        local field := :PromptField();
        if field = nil then return :SetStatus("Tap the prompt line first");
        // ponytail: decode the input line's rich string once at the boundary.
        local prompt := DecodeRichString(field.text, field.viewFont).text;
        if (prompt = nil) or (StrLen(prompt) = 0) then
            return :SetStatus("Type a prompt first");
        local ascii := " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
        for index := 0 to StrLen(prompt) - 1 do
            if StrPos(ascii, SubStr(prompt, index, 1), 0) = nil then
                return :SetStatus("ASCII only");
        if self.inFlight then return :SetStatus("Turn in flight");
        // ponytail: an idle link can drop; Send reconnects instead of dead-ending.
        if not self.ready then return :Connect();
        if (StrLen(prompt) = 4) and BeginsWith(prompt, "/new") then self.transcript := ""
        else :AppendLine("You: " & prompt);
        :ShowTranscript();
        return :Send(prompt);
    end,

    NewChat: func()
    begin
        self.transcript := "";
        self.scrollRow := 0;
        :ShowTranscript();
        local field := :PromptField();
        if field then
            try SetValue(field, 'text, "") onexception |evt.ex| do nil;
        if not self.ready then return :SetStatus("Offline");
        return :Send("/new");
    end,

    // ---- Notes bridge (folded in from the retired note-export package) ----

    // One wire line, ASCII only: every control character and every high
    // character becomes a space, so a note can never break the frame grammar.
    Clean: func(text)
    begin
        local size := StrLen(text);
        if size > self.noteBytes then size := self.noteBytes;
        local out := "";
        for index := 0 to size - 1 do
        begin
            local code := Ord(text[index]);
            // The Ink Text placeholder is dropped rather than spaced: the word
            // it stands for is not missing, it goes out as strokes from the
            // paragraph's `styles`. A7 put the raw 63233 into the prompt.
            if code = self.placeholder then nil
            else if (code < 32) or (code > 126) then out := out & " "
            else out := out & SubStr(text, index, 1);
        end;
        return out;
    end,

    // The newest note is the one the store allocated last — NOT the one with
    // the newest date, because on this device the dates lie.
    //
    // The human's MessagePad had its clock set to 2008 and then corrected. Every
    // note written while it was wrong carries a 2008 `timeStamp` and a 2008
    // `EntryModTime`, so it sorts to the *front* of the timeStamp index and the
    // A9 scan — sixteen entries back from the *end* of that index — never even
    // looked at it. That is the reported bug: a fresh cat drawing losing to
    // months-old D&D notes. Reproduced by construction on instance `efround`
    // with 25 notes, and both rules run over the same soup
    // (runtime/evidence/efround-ordering.txt):
    //
    //   A9  (timeStamp cursor, max EntryModTime) -> id=23 "EF dnd session 18"
    //   EF1 (_uniqueID cursor, max EntryUniqueID) -> id=24 "EF cat drawing page"
    //
    // `_uniqueID` is a real, queryable index on this ROM (the one index the ROM
    // refuses to let you remove, refs/NewtonProgrammerRef20.txt:74421) and IDs
    // come off a per-soup counter — `soup:GetNextUid()` is documented as "the
    // unique identifier to be assigned to the next entry added to the soup"
    // (:33348). Measured here: consecutive NewNote calls returned 3, 4, 5, …, 24.
    // Nothing in that counter consults the clock, which is the whole point.
    //
    // The scan still walks back scanLimit entries because a union soup can
    // interleave two stores whose ID spaces are independent; there, and only
    // there, EntryModTime breaks the tie.
    //
    // Honest cost, stated plainly: A9 could answer with an *older* page you had
    // just drawn on, and this cannot. Between "the note you just made" and "the
    // page you just touched", only the first survives a broken clock, and a
    // broken clock is what the hardware actually has. Reading the *open* note
    // (Track F3) is the fix that needs neither.
    FindNewest: func()
    begin
        local soup := GetUnionSoupAlways(ROM_paperRollSoupName);
        local cursor := nil;
        try cursor := soup:Query({indexPath: '_uniqueID})
        onexception |evt.ex| do cursor := nil;
        // Belt and braces: if some store will not index by ID, fall back to the
        // creation-time cursor rather than losing the button.
        if cursor = nil then
            try cursor := soup:Query({indexPath: 'timeStamp})
            onexception |evt.ex| do cursor := nil;
        if cursor = nil then return nil;
        // ResetToEnd lands *on* the last entry and returns it, so the
        // note-export idiom `ResetToEnd(); Prev()` read the second-newest note.
        local entry := cursor:ResetToEnd();
        if entry = nil then return nil;
        local best := entry;
        local bestUid := EntryUniqueID(entry);
        // ponytail: not `mod` — that is the modulo operator, and tntk reports it
        // as a syntax error a dozen lines later.
        local bestMod := EntryModTime(entry);
        local scanned := 1;
        while (entry <> nil) and (scanned < self.scanLimit) do
        begin
            entry := cursor:Prev();
            if entry <> nil then
            begin
                local uid := EntryUniqueID(entry);
                local stamp := EntryModTime(entry);
                if (uid <> nil) and ((bestUid = nil) or (uid > bestUid)
                    or ((uid = bestUid) and (stamp <> nil)
                        and ((bestMod = nil) or (stamp > bestMod)))) then
                begin
                    best := entry;
                    bestUid := uid;
                    bestMod := stamp;
                end;
            end;
            scanned := scanned + 1;
        end;
        return best;
    end,

    // The classification order is load-bearing. Every sketch item's _proto is a
    // clPolygonView template carrying its own empty `points` binary, so a test on
    // `points` before `viewStationery` reports every freehand stroke as an empty
    // shape (docs/newtonscript-eval.md, "Seventeenth finding", the _proto trap).
    // Test 'para, then 'poly, then 'pict, then ClassOf(item.ink) = 'ink2.
    CollectNote: func(data)
    begin
        self.askText := "";
        self.askStrokes := [];
        self.askPoints := 0;
        self.askLeft := nil;
        self.askTop := nil;
        self.askTruncated := nil;
        local items := 0;
        foreach item in data do
        begin
            items := items + 1;
            if items > self.maxItems then self.askTruncated := true
            else if item.viewStationery = 'para then :CollectPara(item)
            else if item.viewStationery = 'poly then :CollectPoly(item)
            else if item.viewStationery = 'pict then nil
            else if ClassOf(item.ink) = 'ink2 then :CollectInk(item);
        end;
        return nil;
    end,

    // A paragraph is text plus, invisibly, any ink words written over it.
    CollectPara: func(item)
    begin
        local text := "";
        if IsString(item.text) then text := item.text
        else if item.text then text := DecodeRichString(item.text, ROM_fontSystem10).text;
        if (text <> nil) and (StrLen(text) > 0) then
        begin
            if StrLen(self.askText) > 0 then self.askText := self.askText & " ";
            self.askText := self.askText & text;
        end;
        return :CollectInkWords(item);
    end,

    // 'poly (Shapes mode): PointsToArray gives [shapeType, nPoints, x1, y1, ...]
    // whose pairs are RELATIVE to the item's viewBounds and ordered x,y.
    CollectPoly: func(item)
    begin
        local box := item.viewBounds;
        if box = nil then return nil;
        local array := PointsToArray(item.points);
        if not IsArray(array) then return nil;
        local points := [];
        local index := 2;
        while (index + 1) < Length(array) do
        begin
            AddArraySlot(points, array[index] + box.left);
            AddArraySlot(points, array[index + 1] + box.top);
            index := index + 2;
        end;
        return :AddStroke(points, box);
    end,

    // 'ink2 (Sketches mode): ExpandInk takes the raw soup frame — no live view
    // and no frontmost Notes — and GetStrokePointsArray hands back a flat array
    // ABSOLUTE in the note's space and ordered y,x. The two kinds disagree on
    // both origin and pair order, and getting either backwards yields geometry
    // that looks plausible and is wrong.
    CollectInk: func(item)
    begin
        local bundle := ExpandInk(item, 0);
        if bundle = nil then return nil;
        local strokes := CountStrokes(bundle);
        if (strokes = nil) or (strokes < 1) then return nil;
        for index := 0 to strokes - 1 do
        begin
            local flat := GetStrokePointsArray(GetStroke(bundle, index), 0);
            if IsArray(flat) then :AddStroke(:SwapPairs(flat), item.viewBounds);
        end;
        return nil;
    end,

    // 'inkWord (Ink Text mode) adds no data item: the words live in the
    // paragraph's `styles` array with placeholder 63233 standing in for each one
    // in `text`. InkConvert bridges a word to 'ink2 and GetInkWordInfo supplies
    // the bounds ExpandInk needs. Those points are local to the word's own box —
    // the ROM does not record where on the line it sat — so the words are laid
    // out along the paragraph's top edge at a running advance.
    CollectInkWords: func(item)
    begin
        local styles := item.styles;
        if not IsArray(styles) then return nil;
        local box := item.viewBounds;
        if box = nil then return nil;
        local advance := 0;
        foreach style in styles do
            if ClassOf(style) = 'inkWord then
            begin
                local info := GetInkWordInfo(style);
                local width := 32;
                local height := 16;
                if info then
                begin
                    if info.origWidth then width := info.origWidth;
                    if (info.origAscent <> nil) and (info.origDescent <> nil) then
                        height := info.origAscent + info.origDescent + 1;
                end;
                local converted := InkConvert(style, 'ink2);
                if converted then
                begin
                    local bundle := ExpandInk({ink: converted, viewBounds:
                        {left: 0, top: 0, right: width, bottom: height}}, 0);
                    local strokes := 0;
                    if bundle then strokes := CountStrokes(bundle);
                    if strokes then for index := 0 to strokes - 1 do
                    begin
                        local flat := GetStrokePointsArray(GetStroke(bundle, index), 0);
                        if IsArray(flat) then
                            :AddStroke(:OffsetPairs(:SwapPairs(flat),
                                box.left + advance, box.top), box);
                    end;
                end;
                advance := advance + width + 8;
            end;
        return nil;
    end,

    // y,x -> x,y. Both point-array producers on this ROM (GetPointsArray and
    // GetStrokePointsArray) are y-then-x; everything downstream of here is x,y.
    SwapPairs: func(flat)
    begin
        local count := Length(flat);
        local points := Array(count, 0);
        local index := 0;
        while (index + 1) < count do
        begin
            points[index] := flat[index + 1];
            points[index + 1] := flat[index];
            index := index + 2;
        end;
        return points;
    end,

    OffsetPairs: func(points, dx, dy)
    begin
        local index := 0;
        while (index + 1) < Length(points) do
        begin
            points[index] := points[index] + dx;
            points[index + 1] := points[index + 1] + dy;
            index := index + 2;
        end;
        return points;
    end,

    // One stroke, x,y pairs in the note's own space. The drawn items' bounding
    // box top-left is accumulated here because it is the origin EncodeInk
    // removes: sketch points are absolute in the paper roll's space, which for
    // the probe note meant a uniform 0,-36 against where the pen actually went.
    AddStroke: func(points, box)
    begin
        local count := Length(points) div 2;
        if count < 1 then return nil;
        if (self.askPoints + count) > self.maxPoints then
        begin
            self.askTruncated := true;
            return nil;
        end;
        if box then
        begin
            if (self.askLeft = nil) or (box.left < self.askLeft) then
                self.askLeft := box.left;
            if (self.askTop = nil) or (box.top < self.askTop) then
                self.askTop := box.top;
        end;
        AddArraySlot(self.askStrokes, points);
        self.askPoints := self.askPoints + count;
        return nil;
    end,

    // NSI1 exactly as the host has always parsed it, plus one optional line:
    //
    //   NSI1 <width> <height> <strokeCount>
    //   H <text>                                  (optional, at most one)
    //   S <count> <x> <y> <dx> <dy> ...           (one per stroke)
    //
    // The H line carries the note's own paragraph text into the vision prompt,
    // so a mixed page is ONE request with one reply instead of two model calls
    // racing for a transcript that has one column. The header's four fields do
    // not change and H is optional, so a host that grew this still parses the
    // bodies the older client on the physical MP2000 sends.
    EncodeInk: func(hint)
    begin
        local originLeft := self.askLeft;
        local originTop := self.askTop;
        if originLeft = nil then originLeft := 0;
        if originTop = nil then originTop := 0;
        local body := "NSI1 320 480 " & Length(self.askStrokes) & "\r\n";
        if (hint <> nil) and (StrLen(hint) > 0) then body := body & "H " & hint & "\r\n";
        foreach points in self.askStrokes do
        begin
            local line := "S " & (Length(points) div 2);
            local x := 0;
            local y := 0;
            local index := 0;
            while (index + 1) < Length(points) do
            begin
                local nextX := :ClampAt(points[index] - originLeft, 319);
                local nextY := :ClampAt(points[index + 1] - originTop, 479);
                if index = 0 then line := line & " " & nextX & " " & nextY
                else line := line & " " & (nextX - x) & " " & (nextY - y);
                x := nextX;
                y := nextY;
                index := index + 2;
            end;
            body := body & line & "\r\n";
            // ponytail: one HTTP request only; multipart belongs to a later
            // stage, and 279 points is ~1.1 KB against this 16 KiB cap.
            if StrLen(body) > 16384 then return nil;
        end;
        return body;
    end,

    ClampAt: func(value, limit)
    begin
        local at := Floor(value);
        if at < 0 then at := 0;
        if at > limit then at := limit;
        return at;
    end,

    // "Ask": one button whose meaning is "send the newest note, whatever kind it
    // is". Text only goes down the chat path exactly as before, so a long note
    // still splits into MSGP parts; anything drawn goes out as one /ink POST,
    // carrying the page's text on the H line when it has both. There is
    // deliberately no second "Ask Sketch" to choose between and no silent skip:
    // on hardware 2026-08-03 the human drew a cat, tapped "Ask Note", and got an
    // answer about an older text note.
    Ask: func()
    begin
        if self.inFlight then return :SetStatus("Turn in flight");
        if self.inkBusy then return :SetStatus("Ask in flight");
        local entry := :FindNewest();
        if entry = nil then return :SetStatus("No note found");
        local data := GetSysEntryData(entry, 'data);
        if not IsArray(data) then return :SetStatus("Newest note is empty");
        :CollectNote(data);
        local text := :Clean(self.askText);
        local strokes := Length(self.askStrokes);
        if strokes = 0 then
        begin
            if StrLen(text) = 0 then return :SetStatus("Newest note is empty");
            if not self.ready then return :Connect();
            :AppendLine("Note: " & text);
            :ShowTranscript();
            return :Send(text);
        end;
        local hint := text;
        if StrLen(hint) > self.hintBytes then hint := SubStr(hint, 0, self.hintBytes);
        local body := :EncodeInk(hint);
        if body = nil then return :SetStatus("Too much ink to send");
        if StrLen(text) > 0 then :AppendLine("Note: " & text)
        else :AppendLine("Note: " & strokes & " strokes");
        // The status line is overwritten by "Thinking..." a moment later, so a
        // truncation notice only survives in the transcript.
        if self.askTruncated then :AppendLine("Note: too big, sent the first part");
        :ShowTranscript();
        return :SendInk(body, strokes);
    end,

    // "Save Note": the two-step create proven in note-export N12/N13. The
    // readback is now :FindNewest() itself — the entry the store just allocated
    // is by definition the highest ID — which both names the note that was
    // written and proves the ordering rule on every tap. A9 needed a
    // same-minute tie-break here; ID ordering has no ties to break.
    SaveNote: func()
    begin
        if StrLen(self.lastReply) = 0 then return :SetStatus("No reply to save");
        local paperroll := GetRoot().paperroll;
        local note := paperroll:MakeTextNote(self.lastReply, nil);
        paperroll:NewNote(note, nil, nil);
        local entry := :FindNewest();
        if entry = nil then return :SetStatus("Saved, but no entry read back");
        return :SetStatus("Saved note id=" & EntryUniqueID(entry));
    end,

    // ---- The /ink transport (kept from the retired capture overlay) ----

    // ponytail: the ink POST is a second endpoint on the NIE link the chat
    // already holds — one link, two connections. Dropping the chat link first
    // and re-grabbing it cost a round: `connect` then failed with -16009,
    // "invalid call when not connected".
    SendInk: func(body, strokes)
    begin
        self.inkBody := body;
        self.inkBusy := true;
        self.inkGotReply := nil;
        :SetStatus("Sending " & strokes & " strokes");
        AddDelayedCall(func(view) try view:InkExpired() onexception |evt.ex| do nil, [self], 150000);
        if self.linkID then return :InkOpen();
        call GetGlobalFn('InetGrabLink) with (nil, self, 'InkGrabbed);
        return nil;
    end,

    InkExpired: func()
    begin
        if not self.inkBusy then return nil;
        self.inkBusy := nil;
        :SetStatus("The host did not answer");
        return :InkDone();
    end,

    InkGrabbed: func(id, state, error)
    begin
        if self.inkEndpoint then return nil;
        if error then return :InkFailed("No network link");
        self.linkID := id;
        if state.linkStatus <> 'connected then return nil;
        return :InkOpen();
    end,

    InkOpen: func()
    begin
        if self.inkEndpoint then return nil;
        self.inkEndpoint := {_proto: self.endpointClass, _parent: self,
            ExceptionHandler: func(error) self._parent:InkDropped()};
        try
        begin
            self.inkEndpoint:Instantiate(self.inkEndpoint, [
                {label: "inet", type: 'service, opCode: opSetRequired, result: nil},
                {
                    label: "ilid", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {arglist: [self.linkID], typeList: ['struct, 'ulong]},
                },
                {
                    label: "itsv", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {arglist: [1], typeList: ['struct, 'ulong]},
                },
            ]);
            self.inkEndpoint:Bind(nil, {
                async: true, reqTimeout: 10000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    if result then self._parent:InkFailed("Ink bind error " & result)
                    else self._parent:InkBound(),
            });
        end
        onexception |evt.ex| do :InkFailed("Could not reach the host");
        return nil;
    end,

    InkBound: func()
    begin
        local address := self.serverAddress;
        try
            self.inkEndpoint:connect([
                {
                    label: "itrs", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {
                        arglist: [address[0], address[1], address[2], address[3], self.inkPort],
                        typeList: ['struct, 'byte, 'byte, 'byte, 'byte, 'short],
                    },
                },
            ], {
                async: true, reqTimeout: 45000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    if result then self._parent:InkFailed("Ink connect error " & result)
                    else self._parent:InkPost(),
            })
        onexception |evt.ex.comm| do :InkFailed("Ink connect exception");
        return nil;
    end,

    InkPost: func()
    begin
        local body := self.inkBody;
        self.inkBody := nil;
        if body = nil then return nil;
        try
        self.inkEndpoint:SetInputSpec({
            _parent: self,
            form: 'string,
            termination: {endSequence: "\r\n"},
            discardAfter: 256,
            // ponytail: the vision call measures ~9 s; the input spec waits for
            // it asynchronously, so the app stays live the whole time.
            reqTimeout: 150000,
            InputScript: func(endpoint, data, terminator, options)
                self._parent:HandleInkLine(data),
            CompletionScript: func(endpoint, options, result)
                self._parent:InkDropped(),
        })
        onexception |evt.ex.comm| do return :InkFailed("Ink input exception");
        local request := "POST /ink HTTP/1.0\r\nHost: 10.42.0.1\r\n"
            & "Content-Type: application/x-newton-strokes\r\nContent-Length: "
            & StrLen(body) & "\r\nConnection: close\r\n\r\n" & body;
        try self.inkEndpoint:output(request, nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                if result then self._parent:InkFailed("Ink send error " & result),
        })
        onexception |evt.ex.comm| do return :InkFailed("Ink send exception");
        :SetStatus("Thinking...");
        return nil;
    end,

    // The reading joins the conversation instead of living on its own status
    // line, so the transcript is the one place answers appear.
    HandleInkLine: func(line)
    begin
        if not BeginsWith(line, "INK ") then return nil;
        self.inkGotReply := true;
        local reading := SubStr(line, 4, StrLen(line) - 6);
        :AppendLine("Ink: " & reading);
        :AppendLine("");
        :ShowTranscript();
        self.lastReply := reading;
        :SetStatus("Ready");
        return nil;
    end,

    InkDropped: func()
    begin
        self.inkBusy := nil;
        if not self.inkGotReply then :SetStatus("The host sent no reading");
        return :InkDone();
    end,

    InkFailed: func(message)
    begin
        self.inkBusy := nil;
        self.inkBody := nil;
        :SetStatus(message);
        return :InkDone();
    end,

    // ponytail: disposing the endpoint inside its own callback raised -48200 in
    // the ink Stage 3 round; let the close settle first. Only the ink endpoint
    // goes away — the NIE link belongs to the chat session.
    InkDone: func()
    begin
        AddDelayedCall(func(view) try view:InkStop() onexception |evt.ex| do nil, [self], 1000);
        return nil;
    end,

    InkStop: func()
    begin
        if self.inkEndpoint then
        begin
            try self.inkEndpoint:SetInputSpec(nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.inkEndpoint := nil;
        end;
        :ReleaseLink();
        return nil;
    end,

    Dropped: func()
    begin
        if self.stopping then return nil;
        :SetStatus("Offline");
        :Stop();
    end,

    Failed: func(message)
    begin
        if self.stopping then return nil;
        :SetStatus(message);
        // ponytail: let the peer-close FSM settle before InetReleaseLink.
        AddDelayedCall(func(view) try view:Stop() onexception |evt.ex| do nil, [self], 1000);
    end,

    // ================= the /tools channel (was HarnessToolsR10P) =============
    //
    // The host holds a long poll on 18081 and pushes "TOOLS <id> <op> [arg]";
    // this answers with three escaped lines and polls again. It is the R10P
    // transport unchanged — same 3 s heartbeat, same 4 s watchdog, same
    // async output specs with form: 'string — with three differences forced by
    // living inside the chat app rather than beside it:
    //
    //   1. every name is prefixed Tool*, because NewtonScript symbols are
    //      case-insensitive and Stop/Bound/Connected/ArmInput/Grabbed all
    //      already exist here;
    //   2. it never grabs its own NIE link when the chat already holds one, and
    //      never releases a link another connection is still using;
    //   3. its retry loop watches toolStopping, not the chat's stopping slot,
    //      so a chat reconnect does not silently kill the tools channel and a
    //      closed window does kill it.
    //
    // Why one package at all: two apps meant two NIE clients fighting over the
    // single broker slot, which is what raised the cosmetic Communications
    // alerts in the 2026-08-03 hardware test (docs/parallel-emulators.md warns
    // about exactly this), and it meant the human installing two packages.

    ToolStart: func()
    begin
        if self.toolStopping then return nil;
        if self.toolEndpoint then return nil;
        if self.linkID then return :ToolOpen();
        call GetGlobalFn('InetGrabLink) with (nil, self, 'ToolGrabbed);
        return nil;
    end,

    ToolGrabbed: func(id, state, error)
    begin
        if self.toolStopping then return nil;
        if self.toolEndpoint then return nil;
        if error then return :ToolRetry();
        self.linkID := id;
        // NIE progress is not failure: everything before 'connected is ignored.
        if state.linkStatus <> 'connected then return nil;
        return :ToolOpen();
    end,

    ToolOpen: func()
    begin
        if self.toolEndpoint then return nil;
        try
        begin
            // Every endpoint here carries an ExceptionHandler, and that is what
            // buys silence. An unsolicited disconnect has no CompletionScript to
            // land in, and "If no ExceptionHandler method is specified, the
            // exception is passed up the handler chain. Exceptions that are not
            // caught are displayed as warning messages to the user"
            // (refs/NewtonProgrammerRef20.txt:57321-57323) — that warning is the
            // modal "Communications — Sorry, a problem has occurred" slip the
            // hardware test complained about. Catching it turns a modal alert
            // into a one-second reconnect the human never sees.
            self.toolEndpoint := {_proto: self.endpointClass, _parent: self,
                ExceptionHandler: func(error) self._parent:ToolRetry()};
            self.toolEndpoint:Instantiate(self.toolEndpoint, [
                {label: "inet", type: 'service, opCode: opSetRequired, result: nil},
                {label: "ilid", type: 'option, opCode: opSetRequired, result: nil,
                 form: 'template, data: {arglist: [self.linkID], typeList: ['struct, 'ulong]}},
                {label: "itsv", type: 'option, opCode: opSetRequired, result: nil,
                 form: 'template, data: {arglist: [1], typeList: ['struct, 'ulong]}},
            ]);
            self.toolEndpoint:Bind(nil, {
                async: true, reqTimeout: 10000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    if result then self._parent:ToolRetry() else self._parent:ToolBound(),
            });
        end
        onexception |evt.ex| do :ToolRetry();
        return nil;
    end,

    ToolBound: func()
    begin
        if self.toolStopping then return nil;
        local address := self.serverAddress;
        try
            self.toolEndpoint:connect([{
                label: "itrs", type: 'option, opCode: opSetRequired, result: nil,
                form: 'template,
                data: {arglist: [address[0], address[1], address[2], address[3], self.toolPort],
                       typeList: ['struct, 'byte, 'byte, 'byte, 'byte, 'short]},
            }], {
                async: true, reqTimeout: 45000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    if result then self._parent:ToolRetry() else self._parent:ToolConnected(),
            })
        onexception |evt.ex.comm| do :ToolRetry();
        return nil;
    end,

    ToolConnected: func()
    begin
        if self.toolStopping then return nil;
        self.toolReady := true;
        self.toolMisses := 0;
        :ToolPoll();
        // The watchdog only starts once there is something to watch, and it
        // reschedules itself from here on.
        AddDelayedCall(func(view) try view:ToolWatch() onexception |evt.ex| do nil, [self], 4000);
        return nil;
    end,

    ToolPoll: func()
    begin
        if not self.toolReady then return nil;
        try self.toolEndpoint:Output("POLL\r\n", nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                if result then self._parent:ToolRetry() else self._parent:ToolArmInput(),
        })
        onexception |evt.ex.comm| do :ToolRetry();
        return nil;
    end,

    ToolArmInput: func()
    begin
        if not self.toolReady then return nil;
        try self.toolEndpoint:SetInputSpec({
            _parent: self,
            form: 'string,
            termination: {endSequence: "\r\n"},
            discardAfter: 512,
            InputScript: func(endpoint, data, terminator, options)
            begin
                // Any line at all — heartbeat included — proves the link.
                self._parent.toolMisses := 0;
                if BeginsWith(data, "TOOLS ") then self._parent:ToolDispatch(data);
                if self._parent.toolReady then self._parent:ToolArmInput();
            end,
        })
        onexception |evt.ex.comm| do :ToolRetry();
        return nil;
    end,

    // 4 s, deliberately above the host's 3 s heartbeat cadence
    // (pkg_publisher.py:77). A faster watchdog forces false reconnects — one of
    // the measured footguns in docs/newton-networking-lessons.md §2.
    ToolWatch: func()
    begin
        if self.toolStopping then return nil;
        if self.toolReady then
        begin
            self.toolMisses := self.toolMisses + 1;
            if self.toolMisses > 2 then :ToolRetry();
        end;
        AddDelayedCall(func(view) try view:ToolWatch() onexception |evt.ex| do nil, [self], 4000);
        return nil;
    end,

    ToolReply: func()
    begin
        if self.toolID = nil then return :ToolRetry();
        local response := self.toolID & "\r\n" & self.toolOutcome
            & "\r\n" & :Escape(self.toolValue) & "\r\n";
        try self.toolEndpoint:Output(response, nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                if result then self._parent:ToolRetry() else self._parent:ToolReplySent(),
        })
        onexception |evt.ex.comm| do :ToolRetry();
        return nil;
    end,

    ToolReplySent: func()
    begin
        if self.toolStopping then return nil;
        self.toolID := nil;
        self.toolOutcome := nil;
        self.toolValue := nil;
        // InputScript has already re-armed input, so this only sends the poll.
        try self.toolEndpoint:Output("POLL\r\n", nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                if result then self._parent:ToolRetry(),
        })
        onexception |evt.ex.comm| do :ToolRetry();
        return nil;
    end,

    ToolDispatch: func(line)
    begin
        local tokens := StrTokenize(line, " \r\n");
        local marker := call tokens with ();
        local requestID := call tokens with ();
        local op := call tokens with ();
        local argument := call tokens with ();
        if marker = nil or requestID = nil or op = nil then return nil;
        self.toolID := requestID;
        try
        begin
            if StrEqual(op, "ping") then
            begin
                self.toolOutcome := "result";
                self.toolValue := "pong";
            end
            else if StrEqual(op, "front_app") then
            begin
                self.toolOutcome := "result";
                self.toolValue := :FrontApp();
            end
            else if StrEqual(op, "get_note") then
            begin
                // Same nil guard + Floor as pkg_list: a missing argument must
                // not throw, and StringToNumber yields a Real on this ROM.
                local ordinal := 0;
                if argument <> nil then ordinal := StringToNumber(argument);
                if ordinal = nil then ordinal := 0 else ordinal := Floor(ordinal);
                if ordinal < 1 or ordinal > 64 then
                begin
                    self.toolOutcome := "error";
                    self.toolValue := "note ordinal must be 1..64";
                end
                else
                begin
                    self.toolOutcome := "result";
                    self.toolValue := :GetNote(ordinal);
                end;
            end
            else if StrEqual(op, "note_list") then
            begin
                local ordinal := 0;
                if argument <> nil then ordinal := StringToNumber(argument);
                if ordinal = nil then ordinal := 0 else ordinal := Floor(ordinal);
                local total := :NoteCount();
                // Paged for the same reason pkg_list is, and capped at the
                // same 64 as get_note: one reply must never walk an
                // arbitrarily long soup and starve the heartbeat.
                local limit := total;
                if limit > 64 then limit := 64;
                if ordinal = 0 then
                begin
                    self.toolOutcome := "result";
                    self.toolValue := "count=" & total;
                end
                else if ordinal < 1 or ordinal > limit then
                begin
                    self.toolOutcome := "error";
                    self.toolValue := "note ordinal must be 1.." & limit;
                end
                else
                begin
                    self.toolOutcome := "result";
                    self.toolValue := :NoteEntry(ordinal, total);
                end;
            end
            else if StrEqual(op, "note_probe") then
            begin
                self.toolOutcome := "result";
                self.toolValue := :NoteProbe();
            end
            else if StrEqual(op, "battery") then
            begin
                self.toolOutcome := "result";
                self.toolValue := :BatteryInfo();
            end
            else if StrEqual(op, "store_info") then
            begin
                self.toolOutcome := "result";
                self.toolValue := :StoreInfo();
            end
            else if StrEqual(op, "pkg_list") then
            begin
                local ordinal := 0;
                if argument <> nil then ordinal := StringToNumber(argument);
                // StringToNumber returns a Real on this ROM, and an array
                // cannot be indexed by a Real: packages[1.0 - 1] throws
                // evt.ex.fr.type;type.ref.frame. Floor it back to an integer.
                if ordinal = nil then ordinal := 0 else ordinal := Floor(ordinal);
                local total := :PkgCount();
                if ordinal = 0 then
                begin
                    self.toolOutcome := "result";
                    self.toolValue := "count=" & total;
                end
                else if ordinal < 1 or ordinal > total then
                begin
                    self.toolOutcome := "error";
                    self.toolValue := "package ordinal must be 1.." & total;
                end
                else
                begin
                    self.toolOutcome := "result";
                    self.toolValue := :PkgEntry(ordinal, total);
                end;
            end
            else
            begin
                self.toolOutcome := "unknown_op";
                self.toolValue := "unknown op: " & op;
            end;
        end
        onexception |evt.ex| do
        begin
            local exception := CurrentException();
            self.toolOutcome := "error";
            if HasSlot(exception, 'error) then self.toolValue := "" & exception.error;
            else if HasSlot(exception, 'name) then self.toolValue := "" & exception.name;
            else self.toolValue := "Newton error";
        end;
        :ToolReply();
        return nil;
    end,

    ToolRetry: func()
    begin
        if self.toolStopping then return nil;
        self.toolStopping := true;
        :ToolStop();
        AddDelayedCall(func(view) try view:ToolResume() onexception |evt.ex| do nil, [self], 1000);
        return nil;
    end,

    ToolResume: func()
    begin
        // The view may have been closed inside that second; ViewQuitScript's
        // stopping flag is the one thing that outlives a delayed call.
        if self.stopping then return nil;
        self.toolStopping := nil;
        return :ToolStart();
    end,

    ToolStop: func()
    begin
        self.toolReady := nil;
        if self.toolEndpoint then
        begin
            try self.toolEndpoint:SetInputSpec(nil) onexception |evt.ex.comm| do nil;
            try self.toolEndpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.toolEndpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.toolEndpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.toolEndpoint := nil;
        end;
        :ReleaseLink();
        return nil;
    end,

    // ---- the fixed operations themselves, lifted from R10P unchanged ----

    FrontApp: func()
    begin
        local app := GetView('viewFrontMostApp);
        if app = nil then return "";
        local symbol := app.appSymbol;
        return GetAppName(symbol) & " (" & symbol & ")";
    end,

    NumStr: func(value)
    begin
        if value = nil then return "?";
        try
        begin
            if IsInteger(value) then return "" & value;
            return "" & Floor(value);
        end
        onexception |evt.ex| do return "?";
        return "?";
    end,

    SlotOr: func(frame, tag)
    begin
        if not IsFrame(frame) then return nil;
        if not HasSlot(frame, tag) then return nil;
        return frame.(tag);
    end,

    BatteryInfo: func()
    begin
        local count := nil;
        try count := BatteryCount()
        onexception |evt.ex| do count := nil;

        local out := "count=" & :NumStr(count);

        local status := nil;
        try status := BatteryStatus(0)
        onexception |evt.ex| do status := nil;
        if not IsFrame(status) then return out & " status=none";

        local capacity := :SlotOr(status, 'batteryCapacity);
        if capacity = nil then out := out & " cap=?"
        else out := out & " cap=" & :NumStr(capacity) & "%";

        local charge := :SlotOr(status, 'chargeState);
        if charge = nil then out := out & " charge=?"
        else out := out & " charge=" & charge;

        local ac := :SlotOr(status, 'acPower);
        if ac = nil then out := out & " ac=?"
        else out := out & " ac=" & ac;

        local kind := :SlotOr(status, 'batteryType);
        if kind = nil then out := out & " type=?"
        else out := out & " type=" & kind;

        return out;
    end,

    StoreInfo: func()
    begin
        local stores := GetStores();
        if stores = nil then return "stores=0";
        local out := "";
        for index := 0 to Length(stores) - 1 do
        begin
            if StrLen(out) > 0 then out := out & "\n";
            out := out & :StoreLine(stores[index]);
        end;
        if StrLen(out) = 0 then return "stores=0";
        return out;
    end,

    StoreLine: func(store)
    begin
        local name := nil;
        try name := store:GetName()
        onexception |evt.ex| do name := nil;
        if name = nil then name := "?";

        local total := nil;
        try total := store:TotalSize()
        onexception |evt.ex| do total := nil;

        local used := nil;
        try used := store:UsedSize()
        onexception |evt.ex| do used := nil;

        local free := nil;
        if IsInteger(total) and IsInteger(used) then free := total - used;

        local readOnly := "?";
        try
        begin
            if store:IsReadOnly() then readOnly := "y" else readOnly := "n";
        end
        onexception |evt.ex| do readOnly := "?";

        return name & " total=" & :NumStr(total) & " used=" & :NumStr(used)
            & " free=" & :NumStr(free) & " ro=" & readOnly;
    end,

    PkgCount: func()
    begin
        local packages := GetPackages();
        if packages = nil then return 0;
        return Length(packages);
    end,

    PkgEntry: func(ordinal, total)
    begin
        local packages := GetPackages();
        if packages = nil then return "" & ordinal & "/" & total & " ?";
        local package := packages[ordinal - 1];
        if not IsFrame(package) then return "" & ordinal & "/" & total & " ?";

        local title := :SlotOr(package, 'title);
        if title = nil then title := "?" else title := "" & title;

        local size := :SlotOr(package, 'size);

        local storeName := "?";
        local store := :SlotOr(package, 'store);
        if store <> nil then
        begin
            local resolved := nil;
            try resolved := store:GetName()
            onexception |evt.ex| do resolved := nil;
            if resolved <> nil then storeName := resolved;
        end;

        return "" & ordinal & "/" & total & " " & title & "|" & :NumStr(size)
            & "|" & storeName;
    end,

    ExceptionName: func()
    begin
        local exception := CurrentException();
        try
        begin
            if IsFrame(exception) then
            begin
                if HasSlot(exception, 'name) then return "" & exception.name;
                if HasSlot(exception, 'error) then return "" & exception.error;
            end;
        end
        onexception |evt.ex| do return "evt.ex";
        return "evt.ex";
    end,

    SlotNames: func(frame)
    begin
        local out := "";
        try
            foreach tag, value in frame do
            begin
                if StrLen(out) > 0 then out := out & ",";
                out := out & tag;
            end
        onexception |evt.ex| do out := out & "!" & :ExceptionName();
        return "[" & out & "]";
    end,

    NoteProbe: func()
    begin
        try return :NoteProbeSteps()
        onexception |evt.ex| do return "probe!" & :ExceptionName();
    end,

    NoteProbeSteps: func()
    begin
        local out := "";
        local stores := nil;
        local targetStore := nil;
        try
        begin
            stores := GetStores();
            out := "stores=" & Length(stores);
        end
        onexception |evt.ex| do out := "stores!" & :ExceptionName();

        if stores <> nil then
            for index := 0 to Length(stores) - 1 do
            begin
                local store := stores[index];
                out := out & ";s" & index & "=";
                try out := out & store:GetName()
                onexception |evt.ex| do out := out & "name!" & :ExceptionName();

                local hasSoup := nil;
                try
                begin
                    hasSoup := store:HasSoup(ROM_paperRollSoupName);
                    if hasSoup then out := out & ":paper=1" else out := out & ":paper=0";
                end
                onexception |evt.ex| do out := out & ":paper!" & :ExceptionName();
                if targetStore = nil and hasSoup then targetStore := store;
            end;

        local soup := nil;
        if targetStore = nil then out := out & ";first=none"
        else
        begin
            try
            begin
                soup := targetStore:GetSoup(ROM_paperRollSoupName);
                out := out & ";soup=get";
            end
            onexception |evt.ex| do out := out & ";soup!" & :ExceptionName();
        end;
        if soup <> nil then
            try out := out & ",class=" & ClassOf(soup)
            onexception |evt.ex| do out := out & ",class!" & :ExceptionName();

        local cursor := nil;
        if soup <> nil then
            try
            begin
                cursor := soup:Query(nil);
                out := out & ";cursor=get";
            end
            onexception |evt.ex| do out := out & ";cursor!" & :ExceptionName();
        if cursor <> nil then
            try out := out & ",class=" & ClassOf(cursor)
            onexception |evt.ex| do out := out & ",class!" & :ExceptionName();

        local entry := nil;
        local gotEntry := nil;
        if cursor <> nil then
            try
            begin
                entry := cursor:Entry();
                gotEntry := true;
                out := out & ";entry=get";
            end
            onexception |evt.ex| do out := out & ";entry!" & :ExceptionName();
        if gotEntry then
        begin
            try out := out & ",class=" & ClassOf(entry)
            onexception |evt.ex| do out := out & ",class!" & :ExceptionName();
            try
            begin
                if entry = nil then out := out & ",kind=nil"
                else if entry = 'deleted then out := out & ",kind=deleted"
                else if IsFrame(entry) then out := out & ",kind=frame"
                else out := out & ",kind=other";
            end
            onexception |evt.ex| do out := out & ",kind!" & :ExceptionName();
            if IsFrame(entry) then out := out & ",slots=" & :SlotNames(entry);
        end;

        local sysData := nil;
        local sysOK := nil;
        if gotEntry then
            try
            begin
                sysData := GetSysEntryData(entry, 'data);
                sysOK := true;
                out := out & ";sysdata=ok";
            end
            onexception |evt.ex| do out := out & ";sysdata!" & :ExceptionName();
        if sysOK then
            try out := out & ",class=" & ClassOf(sysData)
            onexception |evt.ex| do out := out & ",class!" & :ExceptionName();

        local directData := nil;
        local directOK := nil;
        if gotEntry then
            try
            begin
                directData := entry.data;
                directOK := true;
                out := out & ";direct=ok";
            end
            onexception |evt.ex| do out := out & ";direct!" & :ExceptionName();
        if directOK then
            try out := out & ",class=" & ClassOf(directData)
            onexception |evt.ex| do out := out & ",class!" & :ExceptionName();

        local data := nil;
        local dataOK := nil;
        if directOK then
        begin
            data := directData;
            dataOK := true;
            out := out & ";textvia=direct";
        end
        else if sysOK then
        begin
            data := sysData;
            dataOK := true;
            out := out & ";textvia=sys";
        end
        else out := out & ";textvia=none";

        if dataOK then
        begin
            try out := out & ",class=" & ClassOf(data)
            onexception |evt.ex| do out := out & ",class!" & :ExceptionName();
            local dataIsArray := nil;
            try
            begin
                dataIsArray := IsArray(data);
                if dataIsArray then out := out & ",array=1" else out := out & ",array=0";
            end
            onexception |evt.ex| do out := out & ",array!" & :ExceptionName();
            if dataIsArray then
            begin
                local dataLength := nil;
                try
                begin
                    dataLength := Length(data);
                    out := out & ",len=" & dataLength;
                end
                onexception |evt.ex| do out := out & ",len!" & :ExceptionName();
                if dataLength <> nil and dataLength > 0 then
                begin
                    local first := nil;
                    local firstOK := nil;
                    try
                    begin
                        first := data[0];
                        firstOK := true;
                        out := out & ";item0=get";
                    end
                    onexception |evt.ex| do out := out & ";item0!" & :ExceptionName();
                    if firstOK then
                    begin
                        try out := out & ",class=" & ClassOf(first)
                        onexception |evt.ex| do out := out & ",class!" & :ExceptionName();
                        if IsFrame(first) then out := out & ",slots=" & :SlotNames(first)
                        else out := out & ",slots=n/a";
                    end;
                end;
            end;
        end;
        return out;
    end,

    // The R10J cursor walk, unchanged, lifted out so note_list and get_note
    // share one implementation. Returns the ordinal-th entry in ascending
    // timeStamp order across every store that has the paperroll soup, or nil.
    // Walk cost is O(ordinal), never O(soup) -- twelfth finding.
    // This is deliberately still timeStamp order: an ordinal is a paging cursor
    // for one conversation, and the agent asks for "note 7 of 25", not for the
    // newest. "Newest" is Ask's problem, and Ask uses :FindNewest().
    NoteAt: func(ordinal)
    begin
        local cursors := [];
        local entries := [];
        foreach store in GetStores() do
            if store:HasSoup(ROM_paperRollSoupName) then
            begin
                local cursor := store:GetSoup(ROM_paperRollSoupName):Query({indexPath: 'timeStamp});
                AddArraySlot(cursors, cursor);
                AddArraySlot(entries, cursor:Entry());
            end;
        if Length(entries) = 0 then return nil;

        local entry := nil;
        for position := 1 to ordinal do
        begin
            local selected := nil;
            entry := nil;
            for index := 0 to Length(entries) - 1 do
            begin
                local candidate := entries[index];
                if candidate <> nil and candidate <> 'deleted then
                    if entry = nil or GetSysEntryData(candidate, 'timeStamp) < GetSysEntryData(entry, 'timeStamp) then
                    begin
                        entry := candidate;
                        selected := index;
                    end;
            end;
            if entry = nil then return nil;
            if position < ordinal then entries[selected] := cursors[selected]:Next();
        end;
        return entry;
    end,

    NoteText: func(entry)
    begin
        local data := GetSysEntryData(entry, 'data);
        local text := "";
        if IsArray(data) then foreach item in data do
            if item.viewStationery = 'para then
            begin
                if StrLen(text) > 0 then text := text & "\n";
                if IsString(item.text) then text := text & item.text;
                else text := text & DecodeRichString(item.text, ROM_fontSystem10).text;
            end;
        return text;
    end,

    GetNote: func(ordinal)
    begin
        local entry := :NoteAt(ordinal);
        if entry = nil then return "";
        return :NoteText(entry);
    end,

    NoteCount: func()
    begin
        local total := 0;
        foreach store in GetStores() do
            if store:HasSoup(ROM_paperRollSoupName) then
            begin
                local counted := nil;
                try counted := store:GetSoup(ROM_paperRollSoupName)
                    :Query({indexPath: 'timeStamp}):CountEntries()
                onexception |evt.ex| do counted := nil;
                if IsInteger(counted) then total := total + counted;
            end;
        return total;
    end,

    // One short ASCII line: no newlines, no "|" (the field separator), capped.
    OneLine: func(text, limit)
    begin
        local out := "";
        local length := StrLen(text);
        local kept := length;
        if kept > limit then kept := limit;
        local i := 0;
        while i < kept do
        begin
            local ch := SubStr(text, i, 1);
            if ch = "\n" or ch = "\r" or ch = "\t" or ch = "|" then out := out & " "
            else out := out & ch;
            i := i + 1;
        end;
        if length > limit then out := out & "...";
        return out;
    end,

    // Notepad entries usually have no title at all -- every entry on the
    // seeded flash had title = nil -- so fall back to the note's first
    // characters, which is what makes the listing readable.
    NoteLabel: func(entry)
    begin
        local title := nil;
        try title := GetSysEntryData(entry, 'title)
        onexception |evt.ex| do title := nil;
        if title <> nil and not IsString(title) then
            try title := DecodeRichString(title, ROM_fontSystem10).text
            onexception |evt.ex| do title := nil;
        if IsString(title) and StrLen(title) > 0 then return :OneLine(title, 32);

        local text := "";
        try text := :NoteText(entry)
        onexception |evt.ex| do text := "";
        if not IsString(text) or StrLen(text) = 0 then return "(untitled)";
        return :OneLine(text, 32);
    end,

    NoteEntry: func(ordinal, total)
    begin
        local entry := :NoteAt(ordinal);
        if entry = nil then return "" & ordinal & "/" & total & " ?|?";
        local stamp := nil;
        try stamp := GetSysEntryData(entry, 'timeStamp)
        onexception |evt.ex| do stamp := nil;
        return "" & ordinal & "/" & total & " " & :NoteLabel(entry)
            & "|" & :NumStr(stamp);
    end,

    Escape: func(text)
    begin
        local out := "";
        local i := 0;
        while i < StrLen(text) do
        begin
            local ch := SubStr(text, i, 1);
            if ch = "\\" then out := out & "\\\\";
            else if ch = "\"" then out := out & "\\\"";
            else if ch = "\r" then out := out & "\\r";
            else if ch = "\n" then out := out & "\\n";
            else if ch = "\t" then out := out & "\\t";
            else out := out & ch;
            i := i + 1;
        end;
        return out;
    end,

    stepChildren: [
        {
            _proto: protoTitle,
            viewBounds: {left: 0, top: 2, right: 304, bottom: 24},
            title: kAppTitle,
            titleHeight: 18,
        },
        {
            _proto: protoStaticText,
            viewBounds: {left: 14, top: 32, right: 290, bottom: 206},
            viewFont: ROM_fontSystem10,
            // ponytail: protoStaticText defaults to vjLeftH + oneLineOnly, which
            // draws the whole transcript on one clipped line. Drop oneLineOnly.
            viewJustify: vjLeftH,
            // Fixing the line height is what makes the row window exact: 174 px
            // of pane divided by 14 is the twelve rows kVisibleRows promises.
            viewLineSpacing: 14,
            // ponytail: a live paragraph rejects an empty string, so it never
            // starts empty; this doubles as the empty-conversation hint.
            text: "Type a prompt below, then tap Send.",
        },
        {
            _proto: protoDivider,
            viewBounds: {left: 0, top: 214, right: 198, bottom: 232},
            viewFont: ROM_fontSystem10Bold,
            title: "Prompt",
        },
        // The scroll control. Two stock buttons on the divider row cost no
        // transcript height and no new view machinery; see the header comment
        // on kRowChars for why the native scroller protos buy nothing here.
        {
            _proto: protoTextButton,
            viewBounds: {left: 206, top: 210, right: 246, bottom: 232},
            text: "Up",
            buttonClickScript: func() self:Parent():ScrollUp(),
        },
        {
            _proto: protoTextButton,
            viewBounds: {left: 250, top: 210, right: 290, bottom: 232},
            text: "Dn",
            buttonClickScript: func() self:Parent():ScrollDown(),
        },
        {
            _proto: protoInputLine,
            viewBounds: {left: 14, top: 236, right: 290, bottom: 354},
            viewFont: ROM_fontSystem10,
            // protoInputLine defaults to oneLineOnly. Removing that flag makes
            // the taller field usable as a multi-line handwriting area.
            viewJustify: vjLeftH,
            viewLineSpacing: 24,
            text: "",
            ViewKeyDownScript: func(key, flags)
            begin
                if (key = kReturnKey) or (key = kEnterKey) then
                begin
                    self:Parent():SendPrompt();
                    return true;
                end;
                return nil;
            end,
        },
        {
            _proto: protoStaticText,
            viewBounds: {left: 14, top: 364, right: 168, bottom: 380},
            viewFont: ROM_fontSystem9,
            text: "Offline",
        },
        {
            _proto: protoTextButton,
            viewBounds: {left: 178, top: 360, right: 230, bottom: 382},
            text: "New",
            buttonClickScript: func() self:Parent():NewChat(),
        },
        {
            _proto: protoTextButton,
            viewBounds: {left: 238, top: 360, right: 290, bottom: 382},
            text: "Send",
            buttonClickScript: func() self:Parent():SendPrompt(),
        },
        // One button, one meaning: send the newest note, whatever kind it is.
        // It is labelled "Ask Note" rather than "Ask" because the human's
        // second hardware test said the bare verbs did not say what they act
        // on — "Send" sends what you typed, "Ask Note" asks about your newest
        // note, "Save Note" saves the answer.
        {
            _proto: protoTextButton,
            viewBounds: {left: 14, top: 388, right: 110, bottom: 410},
            text: "Ask Note",
            buttonClickScript: func() self:Parent():Ask(),
        },
        {
            _proto: protoTextButton,
            viewBounds: {left: 118, top: 388, right: 214, bottom: 410},
            text: "Save Note",
            buttonClickScript: func() self:Parent():SaveNote(),
        },
    ],
};

{
    app: kAppSymbol,
    text: kAppLabel,
    theForm: mainView,
}
