// "Egg Freckles" is the product, not a round number: one package the human
// installs once, carrying the chat window, the stock Notes actions, AND the
// fixed-op /tools channel that used to be a second package
// (`HarnessToolsR10P`, deleted in this round). Two packages was the first
// complaint of the second hardware test; a second tools app also meant two NIE
// clients fighting for one broker slot and raising `Communications` alerts.
// The round tag lives only in the identity and the version string — EF1, EF2,
// … — because the identity may never be reused (docs/phase3-chat-round.md,
// "Package identity") while the name on the Extras icon should stay put.
kAppSymbol := '|EggFrecklesEF21:jbfly|;
kVersion := "1.0-ef21";
kAppTitle := "Egg Freckles " & kVersion;
kAppLabel := "Egg Freckles";

// The transcript is one bounded string, trimmed from the front at line
// boundaries. 6 KiB is the whole conversation budget on a 1990s device.
kTranscriptCap := 6144;
// The pane clips by rendered *rows*, not by characters. A7 showed the last 640
// characters, which for a short-line reply (/help, /status) is three times what
// the pane can draw, so the end ran off the bottom unreachably — the defect the
// first hardware test found. A8 wraps the transcript onto this row grid itself
// and shows one window of it, so what is on screen is exactly what fits.
// 38 characters is ~266 px of ROM_fontSystem10 at its widest, inside the 276 px
// pane; 12 rows at viewLineSpacing 14 is 168 px, inside the 174 px pane.
kRowChars := 38;
kVisibleRows := 12;
// One tap moves a window less two rows, so the eye can join the pages.
kScrollOverlap := 2;

// A frame is ":" & body & "*HH" & CRLF, so 240 bytes leaves 234 for the body.
// A plain MSG body is "SS MSG " & text: 234 - 7 = 227 characters of prompt fit.
// A part body is "SS MSGP KK NN " & chunk: 234 - 14 = 220. Longer prompts go
// out as MSGP parts; 8 KiB total is the host's cap (server.py MAX_PROMPT).
kFrameBytes := 227;
kPartBytes := 220;
kMaxPrompt := 8192;
// ponytail: a note goes through the same MSGP path as a typed prompt, but
// Clean() rebuilds it one character at a time, and that is O(n^2) on this CPU.
// 2048 characters is ten MSGP parts and still a second of work; the host would
// accept 8192.
kNoteBytes := 2048;

// ---- "Ask" budgets ----
// How many entries back from the end of the _uniqueID cursor "Ask" looks. The
// scan is bounded so it can never starve the 3 s host heartbeat (twelfth
// finding), and EntryUniqueID reads the identifier "without reading the entry
// into the cache" (refs/NewtonProgrammerRef20.txt:34872), so each step is cheap.
kScanLimit := 16;

// ---- ink budgets: DECIMATE, DON'T TRUNCATE (the fifth hardware test) ----
//
// A9 set kMaxPoints := 400 against straight `/drag` probe strokes (17-89 points
// each) and made :AddStroke *refuse* a stroke that would cross it. Real
// handwriting is far denser, so on the physical MP2000 a handwritten "Send a
// list of ice hotels in Iceland" arrived at the host as its first three words —
// whole strokes had been dropped, and the client reported the surviving count
// (17) as if that were what the human drew. An earlier, denser note returned
// nothing at all. Dropping strokes is the worst possible failure for a vision
// call: the picture stays plausible and becomes wrong.
//
// EF6 keeps every stroke and thins points inside it. 1600 is the measured
// per-image legibility budget; the independent host body cap is 16384 bytes
// (`pkg_publisher.py:330`). Delta text can be wider after thinning, so EF11
// measures the encoded body and retries that part at half budget if necessary
// (`EncodeInk`), spending resolution rather than dropping a stroke.
kMaxPoints := 1600;
// The densest measured real screen-height page had 37 strokes
// (runtime/evidence/ef6round-ink-decimation.txt). 64 leaves honest headroom
// for normal handwriting without pretending a 320x480 image stays legible with
// hundreds of tiny strokes; it also bounds the per-stroke NSI1 line overhead.
// ponytail: fixed because the renderer and canvas are fixed; revisit only with
// measured image-interpretation evidence from a different rendering path.
kMaxStrokes := 64;
// One 'ink2 data item can expand into hundreds of strokes through CountStrokes;
// kMaxItems bounds the soup walk, not the stroke count. The multipart encoder
// therefore has its own two-digit wire backstop and reports any loss visibly.
kMaxItems := 256;
kMaxInkParts := 99;
kMaxInkBody := 16384;
// The ceiling on points read out of the soup *before* thinning, so a pathological
// note cannot fill the NewtonScript heap while we are still collecting. Past it a
// stroke is kept as its two endpoints rather than dropped — the shape degrades,
// the stroke count stays true. 12000 points is ~48 KB of array refs and about
// four times the densest page measured.
kMaxRaw := 12000;
// The note's own text rides one optional NSI1 "H" line into the vision prompt.
kHintBytes := 200;

// ---- the two Egg Freckles entries in the stock Notes envelope menu ----
kTextMenuTitle := "Convert to Text";
kAskMenuTitle := "Ask AI";
kAIFolder := "AI";
kInkCapNotice := "Note too long";
// How many 5-second retries the hook gets if GetRoot().paperroll is not
// instantiated yet when InstallScript runs at boot (design §5, [verify]).
kHookTries := 4;
// Ink Text leaves this placeholder character (0xF701) in a paragraph's `text`,
// once per ink word, and the word itself is in `styles` as an 'inkWord binary.
kInkPlaceholder := 63233;

// ---- the egg ----
//
// One 20x14 one-bit drawing serves as the Extras icon and both Notes actions:
// each menu item is Egg Freckles reaching into somebody else's app.
//
// The stock picker entries do carry icons, and the human asked whether one
// could be borrowed. Only two are reachable from where the hook runs —
// `GetRoot().paperroll.routeScripts` holds Duplicate and Delete — and neither
// a second page nor a wastebasket means "send this to an AI"
// (runtime/evidence/effix-icons.txt §1). So this is drawn, but the *format* is
// borrowed, which is what made drawing safe: the 16-byte header below is
// copied byte for byte off the ROM's own Duplicate icon, read out of
// `routeScripts[0].icon.bits` on this ROM (§2). Same header, same rowBytes: 4,
// same 20x14 bounds; only the 56 bytes of pixels are ours. Nothing had to be
// guessed about a structure the books describe loosely.
//
// The pixels are 1 = black, most significant bit leftmost, each row padded out
// to rowBytes. Read the low nibbles as a picture and the egg is visible:
//
//         ####            an outline egg, narrow at the top,
//       ##    ##          with three freckles on its face
//      #        #
//     #          #
//    #    ##      #
//    #            #
//   #       ##     #
//   #              #
//   #   ##         #
//   #              #
//    #      ##     #
//    #            #
//     ##        ##
//       ########
//
// tntk runs this file to build the package, so MakeBinaryFromHex is evaluated
// on the host at build time and the binary is what ships (NEWT/0
// `MakeBinaryFromHex(hexString, class)`, NewtVM.c:3774). It is a top-level
// constant, and every use of it below therefore goes through a slot, never a
// direct read from inside a function body — the twenty-second finding.
kIconBits := MakeBinaryFromHex(
    "00000000000400fd00fd008d010b00a1"
    & "00f00000030c00000402000008010000"
    & "10c08000100080002030400020004000"
    & "23004000200040001030400010008000"
    & "0c03000003fc0000", 'bits);
kAppIcon := {bits: kIconBits, bounds: {top: 0, left: 0, bottom: 14, right: 20}};

// A root-level floating view is the smallest status surface Notes can show
// without becoming modal or opening the full Egg Freckles application.
// BuildContext attaches it to the root; protoFloatNGo keeps Notes clickable.
noteProgressView := {
    _proto: protoFloatNGo,
    viewBounds: {left: 20, top: 56, right: 300, bottom: 128},
    title: "Egg Freckles",
    agent: nil,
    statusView: nil,

    ViewQuitScript: func()
    begin
        if IsFrame(self.agent) then self.agent.progressView := nil;
        inherited:?ViewQuitScript();
    end,

    stepChildren: [
        {
            _proto: protoStaticText,
            viewBounds: {left: 12, top: 24, right: 268, bottom: 52},
            viewFont: ROM_fontSystem10,
            text: "Sending page...",
            ViewSetupDoneScript: func()
            begin
                inherited:?ViewSetupDoneScript();
                self:Parent().statusView := self;
            end,
        },
    ],
};

// ===================== the stock Notes route scripts ========================
//
// These slots are copied onto a small heap frame whose `_proto` is this
// package's own base template (`:NotesHook`), so the route script inherits the
// whole client verbatim: `CollectNote` and its converters, `Clean`,
// `EncodeInk`, and the entire `SendInk` lifecycle down to `InkStop` — the same
// code the Ask button runs, not a copy of it. Only four things differ, and they
// are the four below: there is no window to put a status line in, the reply
// becomes a note instead of a transcript row, and a failure has to say so
// somewhere.
//
// Why a frame and not a closure over the view: the menu item fires from inside
// Notes, with the Egg Freckles window closed, months after it was opened. There
// may be no view. The agent is created once per boot by the hook and lives in
// the NewtonScript heap until the package is removed.
noteAgent := {
    // The latest status is retained for failure notes and mirrored into the
    // transient Notes progress view while that view is open.
    aiStatus: nil,
    progressTemplate: noteProgressView,
    progressView: nil,
    // A short label for the note we were asked about, so the reply can say
    // what it is a reply to.
    aiLabel: "",
    // ponytail: tntk segfaults on a top-level constant inside a function body
    // (the same trap the transcript caps hit), so the folder name is a slot.
    aiFolder: kAIFolder,
    inkCapNotice: kInkCapNotice,

    SetStatus: func(message)
    begin
        self.aiStatus := message;
        if IsFrame(self.progressView) and IsFrame(self.progressView.statusView) then
            try SetValue(self.progressView.statusView, 'text, message)
            onexception |evt.ex| do nil;
        return nil;
    end,

    OpenProgress: func()
    begin
        :CloseProgress();
        try
        begin
            self.progressView := BuildContext(self.progressTemplate);
            self.progressView.agent := self;
            self.progressView:Open();
        end
        onexception |evt.ex| do self.progressView := nil;
        return nil;
    end,

    CloseProgress: func()
    begin
        local view := self.progressView;
        self.progressView := nil;
        if IsFrame(view) then
        begin
            view.agent := nil;
            try view:Close() onexception |evt.ex| do nil;
        end;
        return nil;
    end,

    ProgressDone: func(message)
    begin
        :SetStatus(message);
        AddDelayedCall(func(agent) try agent:CloseProgress() onexception |evt.ex| do nil,
            [self], 1500);
        return nil;
    end,

    // There is no application window, so there are no children to wire. The inherited
    // SetStatus/PromptField call this; overriding it to nil is what keeps
    // :ChildViewFrames() from being sent to a frame that is not a view.
    Wire: func() nil,

    // The Action picker hands us the live soup entry of the note whose envelope
    // was tapped (design §2, evidence §4) — there is no newest-note heuristic
    // on this path and no way to send the wrong page.
    Route: func(target, targetView, mode)
    begin
        if self.inkBusy then return nil;
        if target = nil then return nil;
        local entry := target;
        // "GetTargetCursor works with any kind of target data, whether or not
        // it's a cursor" (Guide:46379-46381), so the overview's multi-select
        // needs no special case: take the first checked note and ignore the
        // rest, which is what v1 promises.
        try
        begin
            local cursor := GetTargetCursor(target, nil);
            if cursor then
            begin
                local first := cursor:Entry();
                if first then entry := first;
            end;
        end
        onexception |evt.ex| do entry := target;
        local data := nil;
        // A blank page's `data` is nil and Length(nil) raises -48410/-48418
        // (design §2). IsArray is the guard.
        try data := GetSysEntryData(entry, 'data)
        onexception |evt.ex| do data := nil;
        if not IsArray(data) then return nil;
        :CollectNote(data);
        local text := :Clean(self.askText);
        local strokes := Length(self.askStrokes);
        local hint := text;
        if StrLen(hint) > self.hintBytes then hint := SubStr(hint, 0, self.hintBytes);
        // An empty page has nothing to ask about. Say nothing rather than
        // filing a note that says nothing.
        if (strokes = 0) and (StrLen(hint) = 0)
            and not self.askPartCapped then return nil;
        // The first body is built before sending. Later parts may also need the
        // half-budget retry, so the final reply path adds the thinning notice.
        local body := :PrepareInkPages(hint, mode);
        if body = nil then
        begin
            self.inkGotReply := nil;
            if self.askPartCapped then :SetStatus(:CapNotice())
            else :SetStatus("Ink could not fit");
            return :InkDone();
        end;
        if StrLen(text) > 0 then self.aiLabel := :OneLine(text, 40)
        else self.aiLabel := "" & strokes & " strokes";
        if self.askPartCapped then
            self.aiLabel := self.aiLabel & " (" & :CapNotice() & ")";
        // Everything from here is the Ask button's asynchronous POST, unchanged:
        // the route script returns nil now and the answer lands in InputScript
        // ~9 s later. A synchronous wait would freeze Notes for that whole time
        // (design §4). The root-level float is non-modal, so Notes remains live.
        :OpenProgress();
        :SendInk(body, strokes);
        return nil;
    end,

    // The reply arrives on the same connection as one "INK <text>" line.
    HandleInkLine: func(line)
    begin
        if BeginsWith(line, "STATUS ") then
        begin
            local at := StrPos(line, " ", 7);
            if at <> nil then at := StrPos(line, " ", at + 1);
            if at <> nil then :SetStatus(SubStr(line, at + 1, StrLen(line) - at - 3));
            :ArmInkWatch();
            return nil;
        end;
        if BeginsWith(line, "INKP ") then
        begin
            self.inkPartAck := true;
            :ArmInkWatch();
            return nil;
        end;
        if BeginsWith(line, "INKERR ") then
        begin
            :SetStatus(SubStr(line, 7, StrLen(line) - 9));
            return nil;
        end;
        if not BeginsWith(line, "INK ") then return nil;
        self.inkGotReply := true;
        if self.askThinned then
            self.aiLabel := self.aiLabel & " (ink thinned to fit)";
        :FileReply(SubStr(line, 4, StrLen(line) - 6));
        :ProgressDone("Answer filed in AI");
        // The terminal reply completes the note path. Do not depend on NIE
        // delivering a later peer-drop callback: InkDone delays endpoint
        // disposal out of this callback and arms the five-second radio idle.
        self.inkBusy := nil;
        return :InkDone();
    end,

    // Exactly one note per tap, whether the host answered or not: this is the
    // only feedback a menu user gets, so silence on failure would look like the
    // feature is broken.
    InkDone: func()
    begin
        if not self.inkGotReply then
        begin
            self.inkGotReply := true;
            local why := self.aiStatus;
            if why = nil then why := "no answer from the host";
            if self.askThinned then
                self.aiLabel := self.aiLabel & " (ink thinned to fit)";
            try :FileReply("(not sent) " & why) onexception |evt.ex| do nil;
            :ProgressDone(why);
        end;
        AddDelayedCall(func(agent) try agent:InkStop() onexception |evt.ex| do nil,
            [self], 1000);
        return nil;
    end,

    // The two-step create proven in note-export N12/N13, then the one slot that
    // is all filing is on this system: "Setting the value of the labels slot is
    // really the only 'filing' that is done" (Guide:35418-35427). AddFolder is
    // idempotent and returns the existing tag (Ref:38952-38966).
    //
    // THE THIRD HARDWARE TEST'S BUG, and why this no longer searches. EF4 wrote
    // the note and then went looking for it again with `:FindNewest()` — the
    // highest `_uniqueID` in the Notes *union* soup — and filed whatever came
    // back. That is a guess, not an identity, and on the MP2000 the guess was
    // wrong: the reply arrived Unfiled and the user's *source* note was filed
    // into AI instead. `_uniqueID` is allocated per member soup, measured on
    // this ROM as two soups on one store both starting at 0
    // (runtime/evidence/effix-filing-bug.txt §2), so across a union soup that
    // spans more than one store the highest ID is not the newest entry. The
    // emulator has exactly one store and could never reproduce it.
    //
    // The fix is to stop searching. `MakeTextNote` returns a frame, and
    // `NewNote` turns *that frame* into the soup entry — measured
    // `before=n after=y uid=3` (§1) — so the entry is already in hand. The
    // label is also set before the add, which files the note as part of
    // creating it and leaves nothing to repair afterwards.
    FileReply: func(reading)
    begin
        try
        begin
            local paperroll := GetRoot().paperroll;
            if not IsFrame(paperroll) then return nil;
            local newline := Chr(13);
            local body := "re: " & self.aiLabel & newline & newline & reading;
            local tag := nil;
            try tag := AddFolder(self.aiFolder, 'paperroll)
            onexception |evt.ex| do tag := nil;
            local note := paperroll:MakeTextNote(body, nil);
            if note = nil then return nil;
            // Filed at creation: the slot rides into the store with the entry.
            if tag <> nil then note.labels := tag;
            paperroll:NewNote(note, nil, nil);
            // `note` is the entry now. EntryChangeXmit with nil persists the
            // cached frame but deliberately suppresses notification. NewNote
            // added an entry, so announce that exact change to Notes' registered
            // soup observers; its overview then re-queries without a UI hack.
            if (tag <> nil) and IsSoupEntry(note) then
            begin
                try EntryChangeXmit(note, nil) onexception |evt.ex| do nil;
                try XmitSoupChange(ROM_paperRollSoupName, self.appSymbol,
                    'entryAdded, note) onexception |evt.ex| do nil;
            end;
        end
        onexception |evt.ex| do nil;
        return nil;
    end,
};

mainView := {
    // Full-screen application by explicit user choice. protoApp supplies
    // vApplication without vFloating; ViewSetupFormScript fills the ROM's app
    // area instead of centring a floating panel over Notes.
    _proto: protoApp,
    viewBounds: {left: 0, top: 0, right: 320, bottom: 480},
    // Full-screen protoApp is eligible for the ROM scroll arrows; the old
    // floating root was excluded from scroll routing by definition.
    title: kAppTitle,
    appSymbol: kAppSymbol,
    endpointClass: {_proto: protoBasicEndpoint},
    endpoint: nil,
    linkID: nil,
    // ponytail: tntk segfaults on a top-level constant inside a function body,
    // so the caps live in slots. Slot names must not collide with a method
    // name: NewtonScript symbols are case-insensitive.
    capBytes: kTranscriptCap,
    rowChars: kRowChars,
    visibleRows: kVisibleRows,
    scrollOverlap: kScrollOverlap,
    // How many rows above the newest the visible window starts. 0 is the live
    // bottom, and every new line puts it back there.
    scrollRow: 0,
    frameBytes: kFrameBytes,
    partBytes: kPartBytes,
    maxPrompt: kMaxPrompt,
    noteBytes: kNoteBytes,
    // ponytail: a Newton paragraph breaks lines on CR (0x0D); NewtonScript's
    // "\n" is 0x0A, which draws as an empty box and breaks nothing. tntk
    // silently emits "" for a CR escape literal, so set it at setup time.
    newline: nil,
    version: kVersion,
    transcript: "",
    transcriptView: nil,
    promptView: nil,
    statusView: nil,
    responseText: "",
    // The last completed agent answer, so "Save Note" can write it to Notes.
    lastReply: "",
    txSeq: 1,
    ready: nil,
    inFlight: nil,
    pendingPrompt: nil,
    pendingPromptLabel: nil,
    draftSeq: nil,
    stopping: nil,
    // EF6: one retry per connection attempt before a bind failure is shown to
    // the human. The fourth hardware test's `Bind error -60047` came straight
    // after the NIE link had been torn down badly, and a link that is still
    // settling binds on the second try. Cleared on every success.
    bindRetried: nil,
    inkBindRetried: nil,
    toolBindRetried: nil,
    // MSGP parts still waiting for their ACK, and how many have gone out.
    pendingParts: nil,
    partIndex: 0,
    // ---- "Ask" state ----
    // There is deliberately no `inkOpen` slot: NewtonScript symbols are
    // case-insensitive, so it shadowed the InkOpen method and every ink Send
    // threw -48200 (the same trap as capBytes/TranscriptTail in A2).
    scanLimit: kScanLimit,
    maxPoints: kMaxPoints,
    maxStrokes: kMaxStrokes,
    maxInkParts: kMaxInkParts,
    maxInkBody: kMaxInkBody,
    maxItems: kMaxItems,
    maxRaw: kMaxRaw,
    hintBytes: kHintBytes,
    placeholder: kInkPlaceholder,
    // What the last Ask read out of the newest note: its paragraph text, its
    // strokes as flat x,y arrays in the note's own space, and the top-left of
    // the drawn items' bounding box, which is the origin the encoder removes.
    askText: "",
    askStrokes: nil,
    // askRaw is what the pen actually drew; askPoints is what is left after
    // :ThinInk. They differ exactly when askThinned is true, and the difference
    // is what the transcript and the reply note report.
    askPoints: 0,
    askRaw: 0,
    askLeft: nil,
    askTop: nil,
    askThinned: nil,
    askPartCapped: nil,
    inkBody: nil,
    inkHint: nil,
    inkMode: nil,
    inkTotalParts: 1,
    inkStrokeIndex: 0,
    inkPartIndex: 0,
    inkPartAck: nil,
    inkBuildMS: nil,
    inkSendTicks: nil,
    inkSendMS: nil,
    inkOpenTicks: nil,
    inkMetrics: nil,
    inkMetricIndex: 0,
    inkBusy: nil,
    // Which send the 150 s watchdog belongs to; see SendInk.
    inkSeq: 0,
    inkGotReply: nil,
    inkEndpoint: nil,
    inkPort: 18081,
    // ---- tools channel state (folded in from the deleted harness-tools) ----
    // A third connection on the same NIE link: the host's long poll on 18081.
    // Every slot here is prefixed so it cannot collide case-insensitively with
    // a method name — the -48200 trap that cost two rounds.
    toolEndpoint: nil,
    toolReady: nil,
    toolMisses: 0,
    toolStopping: nil,
    // EF6: exactly one watchdog chain may be alive. See :ToolWatch — measured
    // this round, a second chain is what turned the tools channel into a
    // reconnect storm.
    toolWatching: nil,
    toolID: nil,
    toolOutcome: nil,
    toolValue: nil,
    toolPort: 18081,
    // Short-lived fourth endpoint used only by pkg_install while this active
    // send keeps the tools channel and NIE link alive.
    pkgEndpoint: nil,
    pkgName: nil,
    pkgInput: nil,
    pkgBinary: nil,
    pkgHeader: "",
    pkgLength: nil,
    pkgOffset: 0,
    pkgChunk: 0,
    pkgInstalledIdentity: nil,
    // A send holds the radio through its reply; this ticket makes old idle
    // callbacks harmless when a new send starts before they fire.
    radioHeld: nil,
    radioSeq: 0,
    // ---- "Send to AI" state ----
    // The slots the hook needs. They are slots, not constants read inside the
    // function bodies, for the tntk reason noted on capBytes above.
    noteAgent: noteAgent,
    textMenuTitle: kTextMenuTitle,
    askMenuTitle: kAskMenuTitle,
    menuIcon: kAppIcon,
    hookTries: kHookTries,
    // The physical build always uses Mars. An emulator round may override this
    // slot through ns_eval without rebuilding or changing the package identity.
    serverAddress: [10, 42, 0, 1],
    serverPort: 6801,

    ViewSetupFormScript: func()
    begin
        local box := GetAppParams();
        self.viewBounds := {left: box.appAreaLeft, top: box.appAreaTop,
            right: box.appAreaWidth, bottom: box.appAreaHeight};
        inherited:?ViewSetupFormScript();
    end,

    ViewSetupDoneScript: func()
    begin
        inherited:?ViewSetupDoneScript();
        self.newline := Chr(13);
        // ponytail: template literals live in the read-only package, so the
        // retained stroke array has to be re-made in the heap before anything
        // grows it.
        self.askStrokes := [];
        self.inkMetrics := [];
        self.inkMetricIndex := 0;
        // ponytail: the child list is not reachable until the view is fully open.
        //
        // Every AddDelayedCall in this file carries the same try guard, and it
        // is not decoration. A delayed call already in the queue still fires
        // after the window closes, and `view:AnyMethod()` on a closed view
        // raises -48809 "undefined method"
        // (docs/newton-networking-lessons.md §1.4) — which the ROM shows the
        // human as a modal "Sorry, a problem has occurred (-48809)" slip.
        // Measured this round: closing the window raised exactly that, from the
        // 4-second tools watchdog landing on the corpse. The guard is what makes
        // closing the app silent.
        AddDelayedCall(func(view) try view:Boot() onexception |evt.ex| do nil, [self], 800);
        // The fallback hook. If InstallScript never ran, or a future ROM drops
        // it, the "Send to AI" item still appears — from the first time the
        // human opens Egg Freckles after a boot. It is a no-op when
        // InstallScript already hooked. self._proto is the package template:
        // the agent must proto to the template, never to a window that can be
        // closed out from under it.
        local form := self._proto;
        if not IsFrame(form) then form := self;
        try form:NotesHook(0, 'window) onexception |evt.ex| do nil;
    end,

    // The window may own a send-triggered tools poll. Closing it always drops
    // every endpoint and the shared NIE link.
    ViewQuitScript: func()
    begin
        self.radioHeld := nil;
        self.toolStopping := true;
        :ToolStop();
        self.stopping := true;
        :Stop();
        inherited:?ViewQuitScript();
    end,

    // Battery rule: opening the app is not data to send. The first Send/Ask
    // acquires NIE and starts the tools poll; idle teardown returns to this state.
    Boot: func()
    begin
        :Wire();
        :ShowTranscript();
        :SetStatus("Radio off");
    end,

    // ponytail: custom template slots do not survive instantiation and a child's
    // index is not stable, but its unique top edge is. Wire lazily: the child
    // list is not available yet while the view is still being set up.
    Wire: func()
    begin
        local kids := :ChildViewFrames();
        if kids = nil then return nil;
        local rootTop := self:GlobalBox().top;
        foreach child in kids do
        begin
            local top := child:GlobalBox().top - rootTop;
            if top = 32 then self.transcriptView := child
            else if top = 236 then self.promptView := child
            else if top = 364 then self.statusView := child;
        end;
        return nil;
    end,

    SetStatus: func(message)
    begin
        if self.statusView = nil then :Wire();
        if self.statusView then SetValue(self.statusView, 'text, message);
        return nil;
    end,

    PromptField: func()
    begin
        if self.promptView = nil then :Wire();
        return self.promptView;
    end,

    // StrPos with a Chr(13) needle raises interpreter error -48802 on this ROM,
    // although the same call with a printable needle works. Scan by hand.
    // Evidence: docs/newton-dev-notes.md, the Track F1 round.
    FindBreak: func(text, from)
    begin
        local size := StrLen(text);
        for index := from to size - 1 do
            if Ord(text[index]) = 13 then return index;
        return nil;
    end,

    AppendLine: func(line)
    begin
        self.transcript := self.transcript & line & self.newline;
        local cut := 0;
        while (StrLen(self.transcript) > self.capBytes) and (cut <> nil) do
        begin
            cut := :FindBreak(self.transcript, 0);
            if cut <> nil then
                self.transcript := SubStr(self.transcript, cut + 1,
                    StrLen(self.transcript) - cut - 1);
        end;
        // New text always returns the window to the live bottom.
        self.scrollRow := 0;
        return nil;
    end,

    // The whole transcript as an array of rows that each fit the pane's width,
    // so the paragraph never wraps a row itself and a row count is a pixel
    // count. Words stay whole unless a word is longer than most of a row.
    WrapRows: func()
    begin
        local rows := [];
        local size := StrLen(self.transcript);
        local index := 0;
        while index < size do
        begin
            local stop := :FindBreak(self.transcript, index);
            if stop = nil then stop := size;
            if stop = index then AddArraySlot(rows, "");
            local at := index;
            while at < stop do
            begin
                local take := stop - at;
                if take > self.rowChars then
                begin
                    take := self.rowChars;
                    local scan := take;
                    while (scan > 12) and (Ord(self.transcript[at + scan - 1]) <> 32) do
                        scan := scan - 1;
                    if scan > 12 then take := scan;
                end;
                AddArraySlot(rows, SubStr(self.transcript, at, take));
                at := at + take;
            end;
            index := stop + 1;
        end;
        return rows;
    end,

    // One window of those rows, ending scrollRow rows above the newest.
    VisibleText: func()
    begin
        local rows := :WrapRows();
        local total := Length(rows);
        local first := total - self.visibleRows - self.scrollRow;
        if first < 0 then first := 0;
        local last := first + self.visibleRows;
        if last > total then last := total;
        local text := "";
        for index := first to last - 1 do
        begin
            if index > first then text := text & self.newline;
            text := text & rows[index];
        end;
        return text;
    end,

    // Move the window and redraw. Clamped at both ends, so a tap at the top or
    // the bottom of the conversation is a no-op rather than a lost position.
    ScrollBy: func(count)
    begin
        local limit := Length(:WrapRows()) - self.visibleRows;
        if limit < 0 then limit := 0;
        local target := self.scrollRow + count;
        if target > limit then target := limit;
        if target < 0 then target := 0;
        self.scrollRow := target;
        return :ShowTranscript();
    end,

    ScrollUp: func() :ScrollBy(self.visibleRows - self.scrollOverlap),

    ScrollDown: func() :ScrollBy(self.scrollOverlap - self.visibleRows),

    // The status-bar arrows send these messages to the frontmost non-floating
    // application view. Reuse the proven row window rather than adding a second
    // scrolling mechanism.
    ViewScrollUpScript: func() :ScrollUp(),

    ViewScrollDownScript: func() :ScrollDown(),

    ShowTranscript: func()
    begin
        if self.transcriptView = nil then :Wire();
        if self.transcriptView then
        begin
            local text := :VisibleText();
            // ponytail: a live paragraph rejects an empty string, so an empty
            // conversation shows the hint instead.
            if StrLen(text) = 0 then text := "Type a prompt below, then tap Send.";
            SetValue(self.transcriptView, 'text, text);
        end;
        return nil;
    end,

    // ponytail: on-device proof of the 6 KiB cap and of the row window; the
    // status line is the assert. Scrolling is proven the only way that means
    // anything — the visible text after a page up is not the visible text at
    // the bottom.
    SelfTest: func()
    begin
        local saved := self.transcript;
        local filler := "0123456789012345678901234567890123456789";
        self.transcript := "";
        for index := 1 to 400 do :AppendLine("" & index & " " & filler);
        local size := StrLen(self.transcript);
        local firstBreak := :FindBreak(self.transcript, 0);
        local first := SubStr(self.transcript, 0, firstBreak);
        local rows := Length(:WrapRows());
        local bottom := :VisibleText();
        :ScrollUp();
        local paged := :VisibleText();
        local ok := (size <= self.capBytes) and (size > 5000)
            and (StrPos(self.transcript, "400 " & filler, 0) <> nil)
            and (StrPos(first, filler, 0) <> nil)
            and (rows > self.visibleRows) and (self.scrollRow > 0)
            and (paged <> bottom);
        self.scrollRow := 0;
        self.transcript := saved;
        :ShowTranscript();
        :SetStatus("Cap test " & (if ok then "PASS" else "FAIL")
            & ": size=" & size & " rows=" & rows & " first=" & first);
        return nil;
    end,

    SeqText: func(seq)
        if seq < 10 then "0" & seq else "" & seq,

    EncodeBody: func(body)
    begin
        local digits := "0123456789ABCDEF";
        local sum := 0;
        for index := 0 to StrLen(body) - 1 do
            sum := BAND(sum + Ord(body[index]), 255);
        return ":" & body & "*" & SubStr(digits, Floor(sum / 16), 1)
            & SubStr(digits, BAND(sum, 15), 1) & "\r\n";
    end,

    RadioHold: func()
    begin
        self.radioHeld := true;
        self.radioSeq := self.radioSeq + 1;
        self.stopping := nil;
        return nil;
    end,

    ArmRadioIdle: func()
    begin
        if not self.radioHeld then return nil;
        self.radioSeq := self.radioSeq + 1;
        AddDelayedCall(func(who, seq) try who:RadioExpired(seq) onexception |evt.ex| do nil,
            [self, self.radioSeq], 5000);
        return nil;
    end,

    RadioExpired: func(seq)
    begin
        if (seq <> self.radioSeq) or not self.radioHeld then return nil;
        if self.inFlight or self.inkBusy then return nil;
        if self.toolID <> nil then
        begin
            // Host heartbeats are not activity. If one happens to be in its
            // callback at expiry, retry this same ticket after it settles.
            if StrEqual(self.toolID, "0") then
                AddDelayedCall(func(who, ticket)
                        try who:RadioExpired(ticket) onexception |evt.ex| do nil,
                    [self, seq], 1000);
            return nil;
        end;
        self.radioHeld := nil;
        self.toolStopping := true;
        :ToolStop();
        :Stop();
        return nil;
    end,

    Stop: func()
    begin
        self.stopping := true;
        if self.endpoint then
        begin
            try self.endpoint:SetInputSpec(nil) onexception |evt.ex.comm| do nil;
            try self.endpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.endpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.endpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.endpoint := nil;
        end;
        if self.inkEndpoint then
        begin
            try self.inkEndpoint:SetInputSpec(nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.inkEndpoint := nil;
        end;
        if self.pkgEndpoint then
        begin
            try self.pkgEndpoint:SetInputSpec(nil) onexception |evt.ex.comm| do nil;
            try self.pkgEndpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.pkgEndpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.pkgEndpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.pkgEndpoint := nil;
        end;
        :ReleaseLink();
        self.ready := nil;
        self.inFlight := nil;
        self.draftSeq := nil;
        self.pendingParts := nil;
        self.partIndex := 0;
        self.pendingPrompt := nil;
        self.pendingPromptLabel := nil;
    end,

    // One NIE link, four connections: chat, ink POST, tools poll, package GET. Whoever
    // shuts down last releases it. Releasing it under a live endpoint is what
    // raised the -48803 overlays in the loader rounds
    // (docs/newton-networking-lessons.md §1.5), and dropping it to open a
    // second connection cost the Track F2 round a -16009.
    // EF6 armor. The fourth hardware test photographed the MP2000 showing
    // "the following exception occurred in event (RemoveLinkClient) of state
    // (connected) of finite state machine (InetManagerFSM): {name:
    // 'evt.ex.fr.intrp, error: -48803}" followed by "Bind error -60047" — an
    // interpreter exception raised inside NIE's own state machine, i.e. from a
    // callback of ours, followed by the next connection failing to bind against
    // the half-torn-down link. -48803 is "wrong number of arguments … when a
    // callback can't be called" (Ref:74810, :57308), and RemoveLinkClient is
    // exactly what InetReleaseLink drives. The call is therefore guarded: an
    // exception thrown out of here would otherwise leave via ViewQuitScript and
    // reach the human as a modal alert, and linkID would stay set forever.
    // The link is forgotten either way, because a failed release is not a
    // reason to keep believing we hold one.
    ReleaseLink: func()
    begin
        if self.endpoint or self.inkEndpoint or self.toolEndpoint or self.pkgEndpoint then return nil;
        if self.linkID then
        begin
            try call GetGlobalFn('InetReleaseLink) with (self.linkID, self, 'Released)
            onexception |evt.ex| do nil;
            self.linkID := nil;
        end;
        return nil;
    end,

    Released: func(id, state, error) nil,

    Connect: func()
    begin
        // ponytail: Stop clears abandoned prompts; a reconnect keeps this one.
        local pending := self.pendingPrompt;
        local label := self.pendingPromptLabel;
        :Stop();
        self.pendingPrompt := pending;
        self.pendingPromptLabel := label;
        :RadioHold();
        self.stopping := nil;
        if pending <> nil then :SetStatus("Connecting, will send...")
        else :SetStatus("Connecting");
        // If the tools poll (or a live ink POST) still holds the link, reuse it
        // rather than grabbing a second one: a grab that is never matched by a
        // release leaks, and this is the same rule SendInk follows.
        if self.linkID then return :OpenSession();
        call GetGlobalFn('InetGrabLink) with (nil, self, 'Grabbed);
        return nil;
    end,

    // NIE invokes this by symbol from inside InetManagerFSM. Nothing of ours may
    // throw out of it (see :ReleaseLink for what that looked like on hardware),
    // so the whole body is guarded and the failure goes to the status line.
    Grabbed: func(id, state, error)
    begin
        try
        begin
            if self.stopping then return nil;
            if self.endpoint then return nil;
            if error then return :Failed("Network error " & error);
            self.linkID := id;
            if state.linkStatus <> 'connected then return nil;
            :OpenSession();
        end
        onexception |evt.ex| do
            try :SetStatus("Link callback failed") onexception |evt.ex| do nil;
        return nil;
    end,

    OpenSession: func()
    begin
        :ToolStart();
        local address := self.serverAddress;
        local callName := "Instantiate";
        // EF6 armor: every one of the callback bodies below is invoked *by the
        // NIE/endpoint machinery*, so an exception escaping one of them lands
        // inside InetManagerFSM and surfaces to the human as the modal
        // `evt.ex.fr.intrp` alert the fourth hardware test photographed. They
        // therefore catch everything and never rethrow.
        self.endpoint := {_proto: self.endpointClass, _parent: self,
            ExceptionHandler: func(error)
                try self._parent:Dropped() onexception |evt.ex| do nil};
        try
        begin
            self.endpoint:Instantiate(self.endpoint, [
                {label: "inet", type: 'service, opCode: opSetRequired, result: nil},
                {
                    label: "ilid", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {arglist: [self.linkID], typeList: ['struct, 'ulong]},
                },
                {
                    label: "itsv", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {arglist: [1], typeList: ['struct, 'ulong]},
                },
            ]);
            callName := "Bind";
            self.endpoint:Bind(nil, {
                async: true, reqTimeout: 10000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    try
                    begin
                        if result then self._parent:BindFailed("Bind error " & result)
                        else self._parent:Bound();
                    end
                    onexception |evt.ex| do nil,
            });
        end
        onexception |evt.ex| do
        begin
            local exception := CurrentException();
            local exceptionError := call GetGlobalFn('InetGetExceptionError) with (exception);
            :Failed(callName & " error " & exceptionError);
        end;
    end,

    // EF6: a bind failure buys exactly one silent retry, five seconds later,
    // before it reaches the status line. The fourth hardware test showed
    // `Bind error -60047` immediately after the NIE link-lifecycle fault — the
    // next connection failing against a link that was still half torn down —
    // and that is precisely the failure a short wait fixes. Two in a row is a
    // real problem and is reported as one.
    BindFailed: func(message)
    begin
        if self.stopping then return nil;
        if self.bindRetried then return :Failed(message);
        self.bindRetried := true;
        :SetStatus("Bind retry");
        AddDelayedCall(func(view) try view:Connect() onexception |evt.ex| do nil,
            [self], 5000);
        return nil;
    end,

    Bound: func()
    begin
        if self.stopping then return nil;
        self.bindRetried := nil;
        local address := self.serverAddress;
        try
            self.endpoint:connect([
                {
                    label: "itrs", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {
                        arglist: [address[0], address[1], address[2], address[3], self.serverPort],
                        typeList: ['struct, 'byte, 'byte, 'byte, 'byte, 'short],
                    },
                },
            ], {
                async: true, reqTimeout: 45000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    try
                    begin
                        if result then self._parent:Failed("Connect error " & result)
                        else self._parent:Connected();
                    end
                    onexception |evt.ex| do nil,
            })
        onexception |evt.ex.comm| do :Failed("Connect exception");
        return nil;
    end,

    Connected: func()
    begin
        if self.stopping then return nil;
        :Hello();
        return nil;
    end,

    Hello: func()
    begin
        self.responseText := "";
        self.txSeq := 1;
        self.ready := nil;
        :ArmInput();
        try self.endpoint:output("~NEWTONCLI 1\r\n", nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                try
                begin
                    if result then self._parent:Failed("Handshake error " & result)
                    else self._parent:HelloMarkerSent();
                end
                onexception |evt.ex| do nil,
        })
        onexception |evt.ex.comm| do :Failed("Handshake exception");
        return nil;
    end,

    ArmInput: func()
    begin
        if self.stopping or (self.endpoint = nil) then return nil;
        try
        self.endpoint:SetInputSpec({
            _parent: self,
            form: 'string,
            // ponytail: protocol lines are capped at 240 bytes.
            termination: {endSequence: "\r\n"},
            discardAfter: 240,
            InputScript: func(endpoint, data, terminator, options)
                try self._parent:HandleLine(data) onexception |evt.ex| do nil,
            CompletionScript: func(endpoint, options, result)
                try self._parent:Dropped() onexception |evt.ex| do nil,
        })
        onexception |evt.ex.comm| do :Failed("Input exception");
        return nil;
    end,

    HelloMarkerSent: func()
    begin
        if self.stopping then return nil;
        try self.endpoint:output(:EncodeBody("00 HELLO NEWTON1 " & self.version), nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                try
                begin
                    if result then self._parent:Failed("Hello error " & result);
                end
                onexception |evt.ex| do nil,
        })
        onexception |evt.ex.comm| do :Failed("Hello exception");
        return nil;
    end,

    HandleLine: func(line)
    begin
        if BeginsWith(line, "ACK ") then
        begin
            if (self.draftSeq <> nil) and BeginsWith(line, "ACK " & :SeqText(self.draftSeq)) then
            begin
                self.draftSeq := nil;
                // Stop-and-wait: the ACK for part k is what releases part k+1.
                if (self.pendingParts <> nil) and (self.partIndex < Length(self.pendingParts)) then
                    return :SendPart();
                self.pendingParts := nil;
                local field := :PromptField();
                if field then
                    try SetValue(field, 'text, "") onexception |evt.ex| do nil;
            end;
            return nil;
        end;
        // A NAK aborts the turn visibly instead of leaving it hung in flight.
        if BeginsWith(line, "NAK ") then
        begin
            self.draftSeq := nil;
            self.pendingParts := nil;
            self.partIndex := 0;
            self.inFlight := nil;
            self.ready := true;
            :ArmRadioIdle();
            return :SetStatus(line);
        end;
        if (StrLen(line) < 9) or not BeginsWith(line, ":") then return nil;
        local star := StrPos(line, "*", 0);
        if star = nil then return nil;
        local seqText := SubStr(line, 1, 2);
        try self.endpoint:output("ACK " & seqText & "\r\n", nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                try
                begin
                    if result then self._parent:Failed("ACK error " & result);
                end
                onexception |evt.ex| do nil,
        })
        onexception |evt.ex.comm| do return :Failed("ACK exception");
        if BeginsWith(line, ":" & seqText & " STAT READY*") then
        begin
            self.ready := true;
            if self.pendingPrompt <> nil then
            begin
                local prompt := self.pendingPrompt;
                local label := self.pendingPromptLabel;
                // Clear first: duplicate READY frames cannot send it twice.
                self.pendingPrompt := nil;
                self.pendingPromptLabel := nil;
                if self.inFlight then :SetStatus("Turn in flight")
                else
                begin
                    if (StrLen(prompt) = 4) and BeginsWith(prompt, "/new") then self.transcript := ""
                    else if label <> nil then :AppendLine(label & prompt)
                    else :AppendLine("You: " & prompt);
                    :ShowTranscript();
                    :Send(prompt);
                end;
            end
            else
            begin
                :SetStatus("Ready");
                :ArmRadioIdle();
            end;
        end else if BeginsWith(line, ":" & seqText & " STAT THINKING*") then
            :SetStatus("Thinking")
        else if BeginsWith(line, ":" & seqText & " STAT ERROR ") then
        begin
            self.ready := true;
            self.inFlight := nil;
            self.responseText := "ERROR: " & SubStr(line, 15, star - 15);
            :SetStatus(self.responseText);
            :ArmRadioIdle();
        end else if BeginsWith(line, ":" & seqText & " TEXT ") then
        begin
            if StrLen(self.responseText) > 0 then
                self.responseText := self.responseText & self.newline;
            self.responseText := self.responseText & SubStr(line, 9, star - 9);
        end else if BeginsWith(line, ":" & seqText & " PROMPT*") then
        begin
            :AppendLine("Agent: " & self.responseText);
            :AppendLine("");
            :ShowTranscript();
            // Held for "Save Note"; the reply is written to Notes only on tap.
            self.lastReply := self.responseText;
            self.responseText := "";
            self.ready := true;
            self.inFlight := nil;
            :SetStatus("Ready");
            :ArmRadioIdle();
        end;
        return nil;
    end,

    // One frame out, sequence number claimed, draft held until its ACK.
    SendBody: func(tail)
    begin
        local encoded := :EncodeBody(:SeqText(self.txSeq) & tail);
        self.draftSeq := self.txSeq;
        try self.endpoint:output(encoded, nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                try
                begin
                    if result then self._parent:Failed("Send error " & result);
                end
                onexception |evt.ex| do nil,
        })
        onexception |evt.ex.comm| do return :Failed("Send exception");
        self.txSeq := (self.txSeq + 1) mod 100;
        return nil;
    end,

    SendPart: func()
    begin
        local total := Length(self.pendingParts);
        local chunk := self.pendingParts[self.partIndex];
        self.partIndex := self.partIndex + 1;
        :SetStatus("Sending " & self.partIndex & "/" & total);
        return :SendBody(" MSGP " & :SeqText(self.partIndex) & " "
            & :SeqText(total) & " " & chunk);
    end,

    Send: func(text)
    begin
        if StrLen(text) > self.maxPrompt then
        begin
            :SetStatus("Prompt too long");
            :ArmRadioIdle();
            return nil;
        end;
        :RadioHold();
        :ToolStart();
        self.ready := nil;
        self.inFlight := true;
        self.responseText := "";
        self.pendingParts := nil;
        self.partIndex := 0;
        if StrLen(text) <= self.frameBytes then
        begin
            :SetStatus("Thinking");
            return :SendBody(" MSG " & text);
        end;
        // Too long for one frame: MSGP parts, one in flight at a time.
        local parts := [];
        local index := 0;
        while index < StrLen(text) do
        begin
            // ponytail: do not rely on SubStr clamping a short tail.
            local take := StrLen(text) - index;
            if take > self.partBytes then take := self.partBytes;
            AddArraySlot(parts, SubStr(text, index, take));
            index := index + take;
        end;
        self.pendingParts := parts;
        return :SendPart();
    end,

    SendPrompt: func()
    begin
        local field := :PromptField();
        if field = nil then return :SetStatus("Tap the prompt line first");
        // ponytail: decode the input line's rich string once at the boundary.
        local prompt := DecodeRichString(field.text, field.viewFont).text;
        if (prompt = nil) or (StrLen(prompt) = 0) then
            return :SetStatus("Type a prompt first");
        local ascii := " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
        for index := 0 to StrLen(prompt) - 1 do
            if StrPos(ascii, SubStr(prompt, index, 1), 0) = nil then
                return :SetStatus("ASCII only");
        if self.inFlight then return :SetStatus("Turn in flight");
        // ponytail: hold one tap across reconnect; another tap cannot queue it twice.
        if not self.ready then
        begin
            if self.pendingPrompt <> nil then
                return :SetStatus("Connecting, will send...");
            self.pendingPrompt := prompt;
            self.pendingPromptLabel := nil;
            :SetStatus("Connecting, will send...");
            return :Connect();
        end;
        if (StrLen(prompt) = 4) and BeginsWith(prompt, "/new") then self.transcript := ""
        else :AppendLine("You: " & prompt);
        :ShowTranscript();
        return :Send(prompt);
    end,

    NewChat: func()
    begin
        self.transcript := "";
        self.scrollRow := 0;
        :ShowTranscript();
        local field := :PromptField();
        if field then
            try SetValue(field, 'text, "") onexception |evt.ex| do nil;
        if not self.ready then
        begin
            self.pendingPrompt := "/new";
            self.pendingPromptLabel := nil;
            return :Connect();
        end;
        return :Send("/new");
    end,

    // ---- Notes bridge (folded in from the retired note-export package) ----

    // One wire line, ASCII only: every control character and every high
    // character becomes a space, so a note can never break the frame grammar.
    Clean: func(text)
    begin
        local size := StrLen(text);
        if size > self.noteBytes then size := self.noteBytes;
        local out := "";
        for index := 0 to size - 1 do
        begin
            local code := Ord(text[index]);
            // The Ink Text placeholder is dropped rather than spaced: the word
            // it stands for is not missing, it goes out as strokes from the
            // paragraph's `styles`. A7 put the raw 63233 into the prompt.
            if code = self.placeholder then nil
            else if (code < 32) or (code > 126) then out := out & " "
            else out := out & SubStr(text, index, 1);
        end;
        return out;
    end,

    // The newest note is the one the store allocated last — NOT the one with
    // the newest date, because on this device the dates lie.
    //
    // The human's MessagePad had its clock set to 2008 and then corrected. Every
    // note written while it was wrong carries a 2008 `timeStamp` and a 2008
    // `EntryModTime`, so it sorts to the *front* of the timeStamp index and the
    // A9 scan — sixteen entries back from the *end* of that index — never even
    // looked at it. That is the reported bug: a fresh cat drawing losing to
    // months-old D&D notes. Reproduced by construction on instance `efround`
    // with 25 notes, and both rules run over the same soup
    // (runtime/evidence/efround-ordering.txt):
    //
    //   A9  (timeStamp cursor, max EntryModTime) -> id=23 "EF dnd session 18"
    //   EF1 (_uniqueID cursor, max EntryUniqueID) -> id=24 "EF cat drawing page"
    //
    // `_uniqueID` is a real, queryable index on this ROM (the one index the ROM
    // refuses to let you remove, refs/NewtonProgrammerRef20.txt:74421) and IDs
    // come off a per-soup counter — `soup:GetNextUid()` is documented as "the
    // unique identifier to be assigned to the next entry added to the soup"
    // (:33348). Measured here: consecutive NewNote calls returned 3, 4, 5, …, 24.
    // Nothing in that counter consults the clock, which is the whole point.
    //
    // The scan still walks back scanLimit entries because a union soup can
    // interleave two stores whose ID spaces are independent; there, and only
    // there, EntryModTime breaks the tie.
    //
    // Be honest about what that tie-break does NOT buy: it fires only when two
    // IDs are *equal*, so on a union soup spanning two stores this rule can
    // still name an entry that is not the newest note. That is survivable for
    // "Ask", which is a heuristic by construction — the worst case is asking
    // about the wrong page. It was NOT survivable for the two paths that used
    // it to find a note they had just *written*: on the physical MP2000 it
    // filed the user's source note into the AI folder and left the reply
    // unfiled (the third hardware test). :FileReply and :SaveNote therefore no
    // longer call this at all; they hold on to the entry they created.
    //
    // Honest cost, stated plainly: A9 could answer with an *older* page you had
    // just drawn on, and this cannot. Between "the note you just made" and "the
    // page you just touched", only the first survives a broken clock, and a
    // broken clock is what the hardware actually has. Reading the *open* note
    // (Track F3) is the fix that needs neither.
    FindNewest: func()
    begin
        local soup := GetUnionSoupAlways(ROM_paperRollSoupName);
        local cursor := nil;
        try cursor := soup:Query({indexPath: '_uniqueID})
        onexception |evt.ex| do cursor := nil;
        // Belt and braces: if some store will not index by ID, fall back to the
        // creation-time cursor rather than losing the button.
        if cursor = nil then
            try cursor := soup:Query({indexPath: 'timeStamp})
            onexception |evt.ex| do cursor := nil;
        if cursor = nil then return nil;
        // ResetToEnd lands *on* the last entry and returns it, so the
        // note-export idiom `ResetToEnd(); Prev()` read the second-newest note.
        local entry := cursor:ResetToEnd();
        if entry = nil then return nil;
        local best := entry;
        local bestUid := EntryUniqueID(entry);
        // ponytail: not `mod` — that is the modulo operator, and tntk reports it
        // as a syntax error a dozen lines later.
        local bestMod := EntryModTime(entry);
        local scanned := 1;
        while (entry <> nil) and (scanned < self.scanLimit) do
        begin
            entry := cursor:Prev();
            if entry <> nil then
            begin
                local uid := EntryUniqueID(entry);
                local stamp := EntryModTime(entry);
                if (uid <> nil) and ((bestUid = nil) or (uid > bestUid)
                    or ((uid = bestUid) and (stamp <> nil)
                        and ((bestMod = nil) or (stamp > bestMod)))) then
                begin
                    best := entry;
                    bestUid := uid;
                    bestMod := stamp;
                end;
            end;
            scanned := scanned + 1;
        end;
        return best;
    end,

    // The classification order is load-bearing. Every sketch item's _proto is a
    // clPolygonView template carrying its own empty `points` binary, so a test on
    // `points` before `viewStationery` reports every freehand stroke as an empty
    // shape (docs/newtonscript-eval.md, "Seventeenth finding", the _proto trap).
    // Test 'para, then 'poly, then 'pict, then ClassOf(item.ink) = 'ink2.
    CollectNote: func(data)
    begin
        self.askText := "";
        self.askStrokes := [];
        self.askPoints := 0;
        self.askRaw := 0;
        self.askLeft := nil;
        self.askTop := nil;
        self.askThinned := nil;
        self.askPartCapped := nil;
        local items := 0;
        foreach item in data do
        begin
            items := items + 1;
            if items > self.maxItems then self.askPartCapped := true
            else if self.askPartCapped then nil
            else if item.viewStationery = 'para then :CollectPara(item)
            else if item.viewStationery = 'poly then :CollectPoly(item)
            else if item.viewStationery = 'pict then nil
            else if ClassOf(item.ink) = 'ink2 then :CollectInk(item)
            // Last resort: an item the harness itself wrote. A note made by
            // MakeTextNote holds an item with no class slot at all — ClassOf is
            // 'frame, slots (text, viewBounds, viewFont, _proto, viewStationery)
            // — so anything with a `text` slot is read as a paragraph rather
            // than skipped (design §2, evidence §4). Without this, "Send to AI"
            // could not be used on a reply note.
            else if item.text then :CollectPara(item);
        end;
        return nil;
    end,

    // A paragraph is text plus, invisibly, any ink words written over it.
    CollectPara: func(item)
    begin
        local text := "";
        if IsString(item.text) then text := item.text
        else if item.text then text := DecodeRichString(item.text, ROM_fontSystem10).text;
        if (text <> nil) and (StrLen(text) > 0) then
        begin
            if StrLen(self.askText) > 0 then self.askText := self.askText & " ";
            self.askText := self.askText & text;
        end;
        return :CollectInkWords(item);
    end,

    // 'poly (Shapes mode): PointsToArray gives [shapeType, nPoints, x1, y1, ...]
    // whose pairs are RELATIVE to the item's viewBounds and ordered x,y.
    CollectPoly: func(item)
    begin
        local box := item.viewBounds;
        if box = nil then return nil;
        local array := PointsToArray(item.points);
        if not IsArray(array) then return nil;
        local points := [];
        local index := 2;
        while (index + 1) < Length(array) do
        begin
            AddArraySlot(points, array[index] + box.left);
            AddArraySlot(points, array[index + 1] + box.top);
            index := index + 2;
        end;
        return :AddStroke(points, box);
    end,

    // 'ink2 (Sketches mode): ExpandInk takes the raw soup frame — no live view
    // and no frontmost Notes — and GetStrokePointsArray hands back a flat array
    // ABSOLUTE in the note's space and ordered y,x. The two kinds disagree on
    // both origin and pair order, and getting either backwards yields geometry
    // that looks plausible and is wrong.
    CollectInk: func(item)
    begin
        local bundle := ExpandInk(item, 0);
        if bundle = nil then return nil;
        local strokes := CountStrokes(bundle);
        if (strokes = nil) or (strokes < 1) then return nil;
        for index := 0 to strokes - 1 do
        begin
            local flat := GetStrokePointsArray(GetStroke(bundle, index), 0);
            if IsArray(flat) then :AddStroke(:SwapPairs(flat), item.viewBounds);
        end;
        return nil;
    end,

    // 'inkWord (Ink Text mode) adds no data item: the words live in the
    // paragraph's `styles` array with placeholder 63233 standing in for each one
    // in `text`. InkConvert bridges a word to 'ink2 and GetInkWordInfo supplies
    // the bounds ExpandInk needs. Those points are local to the word's own box —
    // the ROM does not record where on the line it sat — so the words are laid
    // out along the paragraph's top edge at a running advance.
    CollectInkWords: func(item)
    begin
        local styles := item.styles;
        if not IsArray(styles) then return nil;
        local box := item.viewBounds;
        if box = nil then return nil;
        local advance := 0;
        foreach style in styles do
            if ClassOf(style) = 'inkWord then
            begin
                local info := GetInkWordInfo(style);
                local width := 32;
                local height := 16;
                if info then
                begin
                    if info.origWidth then width := info.origWidth;
                    if (info.origAscent <> nil) and (info.origDescent <> nil) then
                        height := info.origAscent + info.origDescent + 1;
                end;
                local converted := InkConvert(style, 'ink2);
                if converted then
                begin
                    local bundle := ExpandInk({ink: converted, viewBounds:
                        {left: 0, top: 0, right: width, bottom: height}}, 0);
                    local strokes := 0;
                    if bundle then strokes := CountStrokes(bundle);
                    if strokes then for index := 0 to strokes - 1 do
                    begin
                        local flat := GetStrokePointsArray(GetStroke(bundle, index), 0);
                        if IsArray(flat) then
                            :AddStroke(:OffsetPairs(:SwapPairs(flat),
                                box.left + advance, box.top), box);
                    end;
                end;
                advance := advance + width + 8;
            end;
        return nil;
    end,

    // y,x -> x,y. Both point-array producers on this ROM (GetPointsArray and
    // GetStrokePointsArray) are y-then-x; everything downstream of here is x,y.
    SwapPairs: func(flat)
    begin
        local count := Length(flat);
        local points := Array(count, 0);
        local index := 0;
        while (index + 1) < count do
        begin
            points[index] := flat[index + 1];
            points[index + 1] := flat[index];
            index := index + 2;
        end;
        return points;
    end,

    OffsetPairs: func(points, dx, dy)
    begin
        local index := 0;
        while (index + 1) < Length(points) do
        begin
            points[index] := points[index] + dx;
            points[index + 1] := points[index + 1] + dy;
            index := index + 2;
        end;
        return points;
    end,

    // One stroke, x,y pairs in the note's own space. The drawn items' bounding
    // box top-left is accumulated here because it is the origin EncodeInk
    // removes: sketch points are absolute in the paper roll's space, which for
    // the probe note meant a uniform 0,-36 against where the pen actually went.
    // EF6: this no longer refuses a stroke. A9's `if askPoints + count >
    // maxPoints then return nil` is what turned a handwritten sentence into its
    // first three words on the physical MP2000 — the budget was spent by the
    // strokes that happened to be read first and every later one vanished
    // silently. Fitting the budget is :ThinInk's job now, and it thins points
    // rather than losing strokes.
    //
    // The one place a point is still lost before thinning is the raw ceiling,
    // and even there the stroke is kept as its endpoints so the count the human
    // is told stays true.
    AddStroke: func(points, box)
    begin
        local count := Length(points) div 2;
        if count < 1 then return nil;
        if box then
        begin
            if (self.askLeft = nil) or (box.left < self.askLeft) then
                self.askLeft := box.left;
            if (self.askTop = nil) or (box.top < self.askTop) then
                self.askTop := box.top;
        end;
        self.askRaw := self.askRaw + count;
        if self.askRaw > self.maxRaw then
        begin
            local ends := [points[0], points[1]];
            if count > 1 then
            begin
                AddArraySlot(ends, points[(count - 1) * 2]);
                AddArraySlot(ends, points[(count - 1) * 2 + 1]);
            end;
            AddArraySlot(self.askStrokes, ends);
            self.askPoints := self.askPoints + (Length(ends) div 2);
            self.askThinned := true;
            return nil;
        end;
        AddArraySlot(self.askStrokes, points);
        self.askPoints := self.askPoints + count;
        return nil;
    end,

    // Fit one image part's point budget by thinning every stroke, never by
    // dropping one. Parts are formed by the legibility budgets below; this pass
    // still handles a single pathological stroke that exceeds kMaxPoints.
    ThinPartAt: func(strokes, budget)
    begin
        local total := 0;
        foreach points in strokes do total := total + (Length(points) div 2);
        if total <= budget then
            return {strokes: strokes, points: total, thinned: nil};
        local count := Length(strokes);
        local target := budget - (2 * count);
        if target < count then target := count;
        local stride := (total div target) + 1;
        local thinned := [];
        local kept := 0;
        foreach points in strokes do
        begin
            local size := Length(points) div 2;
            local out := [];
            local at := 0;
            local since := stride;
            while at < size do
            begin
                if (since >= stride) or (at = size - 1) then
                begin
                    AddArraySlot(out, points[at * 2]);
                    AddArraySlot(out, points[at * 2 + 1]);
                    since := 1;
                end
                else since := since + 1;
                at := at + 1;
            end;
            AddArraySlot(thinned, out);
            kept := kept + (Length(out) div 2);
        end;
        return {strokes: thinned, points: kept, thinned: true};
    end,

    ThinPart: func(strokes)
        :ThinPartAt(strokes, self.maxPoints),

    // Count the same whole-stroke partitions the sender will encode, without
    // allocating a second tree of part arrays. The total is needed for P before
    // part 1 goes out; the bodies themselves stay lazy.
    InkPartCount: func()
    begin
        local parts := 0;
        local strokes := 0;
        local points := 0;
        foreach stroke in self.askStrokes do
        begin
            local size := Length(stroke) div 2;
            if (strokes > 0) and (((strokes + 1) > self.maxStrokes)
                or ((points + size) > self.maxPoints)) then
            begin
                parts := parts + 1;
                strokes := 0;
                points := 0;
            end;
            strokes := strokes + 1;
            points := points + size;
        end;
        if strokes > 0 then parts := parts + 1;
        if parts > self.maxInkParts then
        begin
            parts := self.maxInkParts;
            self.askPartCapped := true;
        end;
        return parts;
    end,

    // One NSI1 image part. P mirrors MSGP's two-digit index/total fields; it is
    // absent on the single-part fast path. Encoding is separated from the body
    // cap retry so the retry thins this part only, never the whole note.
    EncodeInkAt: func(strokes, originTop, hint, mode, part, total, budget)
    begin
        local fitted := :ThinPartAt(strokes, budget);
        local originLeft := self.askLeft;
        if originLeft = nil then originLeft := 0;
        // Apple explicitly warns that & allocates and recopies large strings.
        // Clone makes the literal writable; StrMunger grows it in place.
        local body := Clone("NSI1 320 480 ");
        StrMunger(body, 536870911, nil, "" & Length(fitted.strokes) & "\r\n", 0, nil);
        if mode = 'text then StrMunger(body, 536870911, nil, "M text\r\n", 0, nil)
        else if mode = 'ask then StrMunger(body, 536870911, nil, "M ask\r\n", 0, nil);
        if total > 1 then StrMunger(body, 536870911, nil,
            "P " & :SeqText(part) & " " & :SeqText(total) & "\r\n", 0, nil);
        if (hint <> nil) and (StrLen(hint) > 0) then
            StrMunger(body, 536870911, nil, "H " & hint & "\r\n", 0, nil);
        // The fixed placeholder is stamped after encoding, when buildMS exists.
        // This request cannot know its own send duration yet, so -1 is explicit.
        StrMunger(body, 536870911, nil, "T 000000 -1\r\n", 0, nil);
        foreach points in fitted.strokes do
        begin
            local line := Clone("S ");
            StrMunger(line, 536870911, nil, "" & (Length(points) div 2), 0, nil);
            local x := 0;
            local y := 0;
            local index := 0;
            while (index + 1) < Length(points) do
            begin
                local nextX := :ClampAt(points[index] - originLeft, 319);
                local nextY := :ClampAt(points[index + 1] - originTop, 479);
                local pair := nil;
                if index = 0 then pair := " " & nextX & " " & nextY
                else pair := " " & (nextX - x) & " " & (nextY - y);
                StrMunger(line, 536870911, nil, pair, 0, nil);
                x := nextX;
                y := nextY;
                index := index + 2;
            end;
            StrMunger(line, 536870911, nil, "\r\n", 0, nil);
            StrMunger(body, 536870911, nil, line, 0, nil);
        end;
        return {body: body, points: fitted.points, thinned: fitted.thinned};
    end,

    EncodeInk: func(strokes, originTop, hint, mode, part, total)
    begin
        local encoded := :EncodeInkAt(strokes, originTop, hint, mode, part,
            total, self.maxPoints);
        if (encoded.body = nil) or (StrLen(encoded.body) > self.maxInkBody) then
        begin
            encoded := :EncodeInkAt(strokes, originTop, hint, mode, part,
                total, self.maxPoints div 2);
            encoded.thinned := true;
        end;
        if (encoded.body = nil) or (StrLen(encoded.body) > self.maxInkBody) then return nil;
        return encoded;
    end,

    StampInkTime: func(body, buildMS)
    begin
        local marker := "T 000000 -1\r\n";
        // StrPos requires its start offset on NewtonOS 2.1. EF18 omitted it,
        // raising -48803 while building the body, before InetGrabLink or /ink.
        local at := StrPos(body, marker, 0);
        if at <> nil then StrMunger(body, at, StrLen(marker),
            "T " & buildMS & " -1\r\n", 0, nil);
        return body;
    end,

    // Build exactly one body, then clear the source stroke references it used.
    // The next body is not allocated until INKP has acknowledged this one.
    EncodeInkPage: func(hint, mode, part, total)
    begin
        local start := self.inkStrokeIndex;
        local index := start;
        local strokes := [];
        local count := 0;
        local top := nil;
        while index < Length(self.askStrokes) do
        begin
            local points := self.askStrokes[index];
            local size := Length(points) div 2;
            if (Length(strokes) > 0) and
                (((Length(strokes) + 1) > self.maxStrokes) or
                 ((count + size) > self.maxPoints)) then break;
            AddArraySlot(strokes, points);
            count := count + size;
            local at := 1;
            while at < Length(points) do
            begin
                if (top = nil) or (points[at] < top) then top := points[at];
                at := at + 2;
            end;
            index := index + 1;
        end;
        if Length(strokes) < 1 then return nil;
        local partHint := nil;
        if part = 1 then partHint := hint;
        // The stream owns exactly one body now, so this is a safe collection
        // point: reclaim the previous HTTP/body scratch before allocating next.
        GC();
        local buildStart := Ticks();
        local encoded := :EncodeInk(strokes, top, partHint, mode, part, total);
        local buildMS := ((Ticks() - buildStart) * 1000) div 60;
        Print("INKTIME page " & part & "/" & total & " build " & buildMS & " ms");
        if encoded = nil then return nil;
        :StampInkTime(encoded.body, buildMS);
        self.inkBuildMS := buildMS;
        local release := start;
        while release < index do
        begin
            self.askStrokes[release] := nil;
            release := release + 1;
        end;
        self.inkStrokeIndex := index;
        self.askPoints := self.askPoints + encoded.points;
        if encoded.thinned then self.askThinned := true;
        return encoded.body;
    end,

    PrepareInkPages: func(hint, mode)
    begin
        local total := :InkPartCount();
        self.inkHint := hint;
        self.inkMode := mode;
        self.inkTotalParts := total;
        self.inkStrokeIndex := 0;
        self.askPoints := 0;
        // Text-only Notes routes still use /ink so the answer is filed by the
        // route agent. The host accepts this zero-stroke NSI1 + H shape.
        if total < 1 then
        begin
            if (hint = nil) or (StrLen(hint) < 1) then return nil;
            local buildStart := Ticks();
            local empty := :EncodeInk([], 0, hint, mode, 1, 1);
            local buildMS := ((Ticks() - buildStart) * 1000) div 60;
            Print("INKTIME page 1/1 build " & buildMS & " ms");
            if empty = nil then return nil;
            :StampInkTime(empty.body, buildMS);
            self.inkBuildMS := buildMS;
            self.inkTotalParts := 1;
            return empty.body;
        end;
        return :EncodeInkPage(hint, mode, 1, total);
    end,

    EncodeNextInkPage: func()
        :EncodeInkPage(self.inkHint, self.inkMode, self.inkPartIndex + 1,
            self.inkTotalParts),

    CapNotice: func()
        if self.inkTotalParts < 1 then self.inkCapNotice & " - no pages fit"
        else self.inkCapNotice & " - first " & self.inkTotalParts & " pages sent",

    ClampAt: func(value, limit)
    begin
        local at := Floor(value);
        if at < 0 then at := 0;
        if at > limit then at := limit;
        return at;
    end,

    // "Ask": one button whose meaning is "send the newest note, whatever kind it
    // is". Text only goes down the chat path exactly as before, so a long note
    // still splits into MSGP parts; anything drawn goes out as a streamed /ink
    // sequence, carrying the page's text on part 1's H line when it has both. There is
    // deliberately no second "Ask Sketch" to choose between and no silent skip:
    // on hardware 2026-08-03 the human drew a cat, tapped "Ask Note", and got an
    // answer about an older text note.
    Ask: func()
    begin
        if self.inFlight then return :SetStatus("Turn in flight");
        if self.inkBusy then return :SetStatus("Ask in flight");
        local entry := :FindNewest();
        if entry = nil then return :SetStatus("No note found");
        local data := GetSysEntryData(entry, 'data);
        if not IsArray(data) then return :SetStatus("Newest note is empty");
        :CollectNote(data);
        local text := :Clean(self.askText);
        local strokes := Length(self.askStrokes);
        if strokes = 0 then
        begin
            if self.askPartCapped then
            begin
                self.inkTotalParts := 0;
                return :SetStatus(:CapNotice());
            end;
            if StrLen(text) = 0 then return :SetStatus("Newest note is empty");
            if not self.ready then
            begin
                self.pendingPrompt := text;
                self.pendingPromptLabel := "Note: ";
                return :Connect();
            end;
            :AppendLine("Note: " & text);
            :ShowTranscript();
            return :Send(text);
        end;
        local hint := text;
        if StrLen(hint) > self.hintBytes then hint := SubStr(hint, 0, self.hintBytes);
        local body := :PrepareInkPages(hint, 'ask);
        if body = nil then
        begin
            if self.askPartCapped then return :SetStatus(:CapNotice());
            return :SetStatus("Too much ink to send");
        end;
        // `strokes` is the count the pen actually drew: EF6 never drops a
        // stroke, so Length(askStrokes) is the truth and not a survivor count.
        if StrLen(text) > 0 then :AppendLine("Note: " & text)
        else :AppendLine("Note: " & strokes & " strokes");
        // A part-cap is known before sending. Point thinning may happen on a
        // later part, so its exact count is appended when the final reply lands.
        if self.askPartCapped then :AppendLine(:CapNotice());
        :ShowTranscript();
        return :SendInk(body, strokes);
    end,

    // "Save Note": the two-step create proven in note-export N12/N13. The id in
    // the status line is read off the frame that was written, not off a search
    // for it — `NewNote` turns the frame `MakeTextNote` returned into the soup
    // entry (measured, and see :FileReply for the hardware bug that the search
    // caused). A9 read this back with :FindNewest(), which is right only while
    // the Notes union soup has a single member.
    SaveNote: func()
    begin
        if StrLen(self.lastReply) = 0 then return :SetStatus("No reply to save");
        local paperroll := GetRoot().paperroll;
        local note := paperroll:MakeTextNote(self.lastReply, nil);
        paperroll:NewNote(note, nil, nil);
        if not IsSoupEntry(note) then return :SetStatus("Saved, but no entry read back");
        return :SetStatus("Saved note id=" & EntryUniqueID(note));
    end,

    // ---- the two Egg Freckles hooks in the stock Notes Action menu ----
    //
    // The Action button "searches its own context for the first routeScripts
    // slot that it finds" (Guide:46271-46280), and for Notes that search ends
    // at GetRoot().paperroll — a RAM frame whose routeScripts comes from a ROM
    // proto. Assigning to it creates an own slot that shadows the proto, and
    // GetRouteScripts (the method the picker actually calls,
    // Ref:52547-52561) returns the shadowing value. Measured on the ROM:
    // len 2 -> 3 and the item is drawn (runtime/evidence/l2probe-routescripts.txt
    // §3). It is pure RAM and does not survive a reset (§6), which is why this
    // runs from InstallScript, "executed when an application or auto part is
    // activated on the Newton or whenever the Newton is reset"
    // (Guide:5209-5210).
    //
    // `via` records which mechanism installed the entry — 'install from the
    // part frame's InstallScript, 'window from the fallback below — so the
    // round can read it back instead of guessing. The window fallback never
    // overwrites an entry InstallScript already made.
    NotesHook: func(tries, via)
    begin
        local paperroll := nil;
        try paperroll := GetRoot().paperroll
        onexception |evt.ex| do paperroll := nil;
        // At boot InstallScript may run before the Notepad view frame exists.
        // Retry rather than give up: the alternative is a menu item that is
        // missing until the app is opened.
        if not IsFrame(paperroll) then
        begin
            if tries > 0 then
                AddDelayedCall(func(form, left, how)
                        try form:NotesHook(left, how) onexception |evt.ex| do nil,
                    [self, tries - 1, via], 5000);
            return nil;
        end;
        if :NotesHooked(paperroll) and (via <> 'install) then return nil;
        // Activation may replace an agent while its send is still active. Retire
        // that endpoint before publishing the fresh route entries; no new poll
        // starts here.
        local previous := :FindAgent(paperroll);
        if previous then
        begin
            previous.radioHeld := nil;
            previous.toolStopping := true;
            try previous:ToolStop() onexception |evt.ex| do nil;
            try previous:InkStop() onexception |evt.ex| do nil;
            try previous:Stop() onexception |evt.ex| do nil;
            try previous:CloseProgress() onexception |evt.ex| do nil;
        end;
        // The agent is a heap frame whose proto is this template, so it
        // inherits every method the Ask button uses. Its own copies of the
        // mutable network slots are what keep it from reading a live window's
        // link through the proto chain.
        local agent := {_proto: self};
        foreach tag, value in self.noteAgent do agent.(tag) := value;
        // NIE and the endpoint machinery look their callbacks up by symbol in
        // the context frame they were handed; give the agent its own copies
        // rather than betting on proto lookup inside the ROM.
        agent.InkGrabbed := self.InkGrabbed;
        agent.Released := self.Released;
        agent.ToolGrabbed := self.ToolGrabbed;
        agent.linkID := nil;
        agent.endpoint := nil;
        agent.inkEndpoint := nil;
        agent.inkHint := nil;
        agent.inkMode := nil;
        agent.inkTotalParts := 1;
        agent.inkStrokeIndex := 0;
        agent.inkPartIndex := 0;
        agent.inkPartAck := nil;
        agent.inkBuildMS := nil;
        agent.inkSendTicks := nil;
        agent.inkSendMS := nil;
        agent.inkOpenTicks := nil;
        agent.inkMetrics := [];
        agent.inkMetricIndex := 0;
        agent.inkBusy := nil;
        // The tools channel's mutable state, as own slots, for the same reason:
        // nothing here may be read or written through the read-only template.
        agent.toolEndpoint := nil;
        agent.toolReady := nil;
        agent.toolStopping := nil;
        agent.toolBindRetried := nil;
        agent.toolWatching := nil;
        agent.toolMisses := 0;
        agent.toolID := nil;
        agent.toolOutcome := nil;
        agent.toolValue := nil;
        agent.pkgEndpoint := nil;
        agent.pkgName := nil;
        agent.pkgInput := nil;
        agent.pkgBinary := nil;
        agent.pkgHeader := "";
        agent.pkgLength := nil;
        agent.pkgOffset := 0;
        agent.pkgChunk := 0;
        agent.pkgInstalledIdentity := nil;
        agent.radioHeld := nil;
        agent.radioSeq := 0;
        // ponytail: template literals live in the read-only package, so the
        // stroke array has to be re-made in the heap before anything grows it.
        agent.askStrokes := [];
        local textEntry := {
            title: self.textMenuTitle,
            // Both entries use the same 20x14 egg as the stock-sized icon.
            icon: self.menuIcon,
            aiHook: self.appSymbol,
            aiVia: via,
            aiMode: 'text,
            agent: agent,
            RouteScript: self.NotesTextRoute,
        };
        local askEntry := {
            title: self.askMenuTitle,
            icon: self.menuIcon,
            aiHook: self.appSymbol,
            aiVia: via,
            aiMode: 'ask,
            agent: agent,
            RouteScript: self.NotesAskRoute,
        };
        paperroll.routeScripts := :NotesRebuild(paperroll, textEntry, askEntry);
        // Battery rule: InstallScript only installs the Notes routes. The agent
        // starts networking from Route -> SendInk, never merely from boot/reset.
        return nil;
    end,

    // The shared agent hanging off either picker entry, or nil. One walk lets
    // :NotesHook retire the previous poll before replacing both entries.
    FindAgent: func(paperroll)
    begin
        local list := paperroll.routeScripts;
        if not IsArray(list) then return nil;
        foreach item in list do
            if IsFrame(item) and (item.aiHook <> nil)
                and IsFrame(item.agent) then return item.agent;
        return nil;
    end,

    // What the picker actually runs. It uses neither `self` nor a closure, and
    // both of those are forced:
    //
    //   - tntk **segfaults** on any nested function that reads a variable from
    //     the enclosing function, which is what `func(t, tv) agent:Route(t, tv)`
    //     would be (the twenty-second finding in docs/newtonscript-eval.md).
    //     This is the same defect the transcript caps hit as "a top-level
    //     constant inside a function body": a top-level constant *is* a local
    //     of the function tntk wraps the file in.
    //   - the ROM does not document whether a RouteScript given as a function
    //     is called as a plain call or as a message send, so `self` could be
    //     this frame, the Action button view, or nothing.
    //
    // So it finds the agent the one way that works from anywhere: back through
    // the array the item it was called for lives in.
    NotesTextRoute: func(target, targetView)
    begin
        local paperroll := nil;
        try paperroll := GetRoot().paperroll
        onexception |evt.ex| do paperroll := nil;
        if not IsFrame(paperroll) then return nil;
        local list := paperroll.routeScripts;
        if not IsArray(list) then return nil;
        foreach item in list do
            if IsFrame(item) and (item.aiHook <> nil) and (item.aiMode = 'text)
                and IsFrame(item.agent) then
                return item.agent:Route(target, targetView, 'text);
        return nil;
    end,

    // ponytail: two top-level functions avoid tntk's closure segfault; each
    // mode has exactly one fresh entry after the install-time stale-AI sweep.
    NotesAskRoute: func(target, targetView)
    begin
        local paperroll := nil;
        try paperroll := GetRoot().paperroll
        onexception |evt.ex| do paperroll := nil;
        if not IsFrame(paperroll) then return nil;
        local list := paperroll.routeScripts;
        if not IsArray(list) then return nil;
        foreach item in list do
            if IsFrame(item) and (item.aiHook <> nil) and (item.aiMode = 'ask)
                and IsFrame(item.agent) then
                return item.agent:Route(target, targetView, 'ask);
        return nil;
    end,

    NotesHooked: func(paperroll)
    begin
        local list := paperroll.routeScripts;
        if not IsArray(list) then return nil;
        local found := 0;
        foreach item in list do
            if IsFrame(item) and (item.aiHook = self.appSymbol)
                and ((item.aiMode = 'text) or (item.aiMode = 'ask)) then found := found + 1;
        return found = 2;
    end,

    // On install, the array without ANY stale AI entry, plus both fresh entries. Uninstall goes
    // through the same shape (in RemoveScript, which cannot call in here — see
    // the part frame). **Never RemoveSlot**: that restores the ROM array
    // exactly, throwing away anything a different package appended after us
    // (design §1; evidence §6 measured the restore).
    NotesRebuild: func(paperroll, textEntry, askEntry)
    begin
        local rebuilt := [];
        local list := paperroll.routeScripts;
        if IsArray(list) then
            foreach item in list do
                if not (IsFrame(item) and (item.aiHook <> nil)) then
                    AddArraySlot(rebuilt, item);
        if textEntry then AddArraySlot(rebuilt, textEntry);
        if askEntry then AddArraySlot(rebuilt, askEntry);
        return rebuilt;
    end,

    // ---- The /ink transport (kept from the retired capture overlay) ----

    // ponytail: the ink POST is a second endpoint on the NIE link the chat
    // already holds — one link, two connections. Dropping the chat link first
    // and re-grabbing it cost a round: `connect` then failed with -16009,
    // "invalid call when not connected".
    // Each send takes a ticket, and the watchdog only fires for the ticket it
    // was armed with. Measured in the L2 round: a 150 s watchdog left over from
    // an earlier send landed in the middle of a *later* one and killed it — on
    // the Ask button that was a wrong status line, but the route script writes
    // a note, so it became a wrong answer in the user's AI folder
    // ("(not sent) The host did not answer" while the host had answered).
    SendInk: func(body, strokes)
    begin
        :RadioHold();
        self.inkPartIndex := 0;
        self.inkPartAck := nil;
        self.inkMetrics := [];
        self.inkMetricIndex := 0;
        self.inkBody := body;
        self.inkBusy := true;
        self.inkGotReply := nil;
        self.inkBindRetried := nil;
        :SetStatus("Sending page 1/" & self.inkTotalParts);
        :ArmInkWatch();
        if self.linkID then return :InkOpen();
        call GetGlobalFn('InetGrabLink) with (nil, self, 'InkGrabbed);
        return nil;
    end,

    // A multipart stream gets one full vision-call budget per part. Incrementing
    // the ticket makes every earlier delayed call harmless.
    ArmInkWatch: func()
    begin
        if not self.inkBusy then return nil;
        self.inkSeq := self.inkSeq + 1;
        AddDelayedCall(func(view, seq) try view:InkExpired(seq) onexception |evt.ex| do nil,
            [self, self.inkSeq], 150000);
        return nil;
    end,

    InkExpired: func(seq)
    begin
        if seq <> self.inkSeq then return nil;
        if not self.inkBusy then return nil;
        self.inkBusy := nil;
        :SetStatus("The host did not answer");
        return :InkDone();
    end,

    InkGrabbed: func(id, state, error)
    begin
        try
        begin
            if self.inkEndpoint then return nil;
            if error then return :InkFailed("No network link");
            self.linkID := id;
            if state.linkStatus <> 'connected then return nil;
            return :InkOpen();
        end
        onexception |evt.ex| do
            try :InkFailed("Link callback failed") onexception |evt.ex| do nil;
        return nil;
    end,

    InkOpen: func()
    begin
        :ToolStart();
        if self.inkEndpoint then return nil;
        self.inkOpenTicks := Ticks();
        self.inkEndpoint := {_proto: self.endpointClass, _parent: self,
            ExceptionHandler: func(error)
                try self._parent:InkDropped() onexception |evt.ex| do nil};
        try
        begin
            self.inkEndpoint:Instantiate(self.inkEndpoint, [
                {label: "inet", type: 'service, opCode: opSetRequired, result: nil},
                {
                    label: "ilid", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {arglist: [self.linkID], typeList: ['struct, 'ulong]},
                },
                {
                    label: "itsv", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {arglist: [1], typeList: ['struct, 'ulong]},
                },
            ]);
            self.inkEndpoint:Bind(nil, {
                async: true, reqTimeout: 10000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    try
                    begin
                        if result then self._parent:InkBindFailed("Ink bind error " & result)
                        else self._parent:InkBound();
                    end
                    onexception |evt.ex| do nil,
            });
        end
        onexception |evt.ex| do :InkFailed("Could not reach the host");
        return nil;
    end,

    // The ink POST's half of the same rule. Rebinding means throwing the failed
    // endpoint away and opening a new one; inkBody is still held, because it is
    // only consumed in :InkPost, which a failed bind never reached.
    InkBindFailed: func(message)
    begin
        if self.inkBindRetried then return :InkFailed(message);
        self.inkBindRetried := true;
        :SetStatus("Ink bind retry");
        AddDelayedCall(func(view) try view:InkRebind() onexception |evt.ex| do nil,
            [self], 5000);
        return nil;
    end,

    InkRebind: func()
    begin
        if not self.inkBusy then return nil;
        if self.inkEndpoint then
        begin
            try self.inkEndpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.inkEndpoint := nil;
        end;
        return :InkOpen();
    end,

    InkBound: func()
    begin
        self.inkBindRetried := nil;
        local address := self.serverAddress;
        try
            self.inkEndpoint:connect([
                {
                    label: "itrs", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {
                        arglist: [address[0], address[1], address[2], address[3], self.inkPort],
                        typeList: ['struct, 'byte, 'byte, 'byte, 'byte, 'short],
                    },
                },
            ], {
                async: true, reqTimeout: 45000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    try
                    begin
                        if result then self._parent:InkFailed("Ink connect error " & result)
                        else self._parent:InkPost();
                    end
                    onexception |evt.ex| do nil,
            })
        onexception |evt.ex.comm| do :InkFailed("Ink connect exception");
        return nil;
    end,

    InkPost: func()
    begin
        local body := self.inkBody;
        self.inkBody := nil;
        if body = nil then return nil;
        if (self.inkMetrics <> nil) and (Length(self.inkMetrics) > 0) then
        begin
            local metric := self.inkMetrics[Length(self.inkMetrics) - 1];
            if not metric.ready and (self.inkOpenTicks <> nil) then
            begin
                metric.endpoint := metric.endpoint
                    + (((Ticks() - self.inkOpenTicks) * 1000) div 60);
                metric.ready := true;
            end;
        end;
        self.inkOpenTicks := nil;
        self.inkSendTicks := Ticks();
        try
        self.inkEndpoint:SetInputSpec({
            _parent: self,
            form: 'string,
            termination: {endSequence: "\r\n"},
            discardAfter: 1024,
            // ponytail: the vision call measures ~9 s; the input spec waits for
            // it asynchronously, so the app stays live the whole time.
            reqTimeout: 150000,
            InputScript: func(endpoint, data, terminator, options)
                try self._parent:HandleInkLine(data) onexception |evt.ex| do nil,
            CompletionScript: func(endpoint, options, result)
                try self._parent:InkDropped() onexception |evt.ex| do nil,
        })
        onexception |evt.ex.comm| do return :InkFailed("Ink input exception");
        local request := Clone("POST /ink HTTP/1.0\r\nHost: 10.42.0.1\r\n"
            & "Content-Type: application/x-newton-strokes\r\nContent-Length: ");
        StrMunger(request, 536870911, nil, "" & StrLen(body)
            & "\r\nConnection: close\r\n\r\n", 0, nil);
        StrMunger(request, 536870911, nil, body, 0, nil);
        try self.inkEndpoint:output(request, nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                try
                begin
                    if result then self._parent:InkFailed("Ink send error " & result)
                    else self._parent:InkSent();
                end
                onexception |evt.ex| do nil,
        })
        onexception |evt.ex.comm| do return :InkFailed("Ink send exception");
        return nil;
    end,

    InkSent: func()
    begin
        if self.inkSendTicks = nil then return nil;
        self.inkSendMS := ((Ticks() - self.inkSendTicks) * 1000) div 60;
        self.inkSendTicks := nil;
        return nil;
    end,

    // The reading joins the conversation instead of living on its own status
    // line, so the transcript is the one place answers appear.
    HandleInkLine: func(line)
    begin
        if BeginsWith(line, "STATUS ") then
        begin
            local at := StrPos(line, " ", 7);
            if at <> nil then at := StrPos(line, " ", at + 1);
            if at <> nil then :SetStatus(SubStr(line, at + 1, StrLen(line) - at - 3));
            :ArmInkWatch();
            return nil;
        end;
        if BeginsWith(line, "INKP ") then
        begin
            self.inkPartAck := true;
            :ArmInkWatch();
            return nil;
        end;
        if BeginsWith(line, "INKERR ") then
        begin
            self.inkGotReply := true;
            local message := SubStr(line, 7, StrLen(line) - 9);
            :AppendLine("ERROR: " & message);
            :ShowTranscript();
            :SetStatus(message);
            return nil;
        end;
        if not BeginsWith(line, "INK ") then return nil;
        self.inkGotReply := true;
        local reading := SubStr(line, 4, StrLen(line) - 6);
        if self.askThinned then :AppendLine("Note: ink thinned to fit ("
            & self.askRaw & " points sent as " & self.askPoints & ")");
        :AppendLine("Ink: " & reading);
        :AppendLine("");
        :ShowTranscript();
        self.lastReply := reading;
        :SetStatus("Ready");
        return nil;
    end,

    InkDropped: func()
    begin
        if not self.inkBusy then return nil;
        if self.inkPartAck and ((self.inkPartIndex + 1) < self.inkTotalParts) then
        begin
            self.inkPartIndex := self.inkPartIndex + 1;
            self.inkPartAck := nil;
            :SetStatus("Sending page " & (self.inkPartIndex + 1) & "/"
                & self.inkTotalParts);
            AddDelayedCall(func(view) try view:InkNext() onexception |evt.ex| do nil,
                [self], 1000);
            return nil;
        end;
        self.inkBusy := nil;
        if not self.inkGotReply then :SetStatus("The host sent no reading");
        return :InkDone();
    end,

    // Each HTTP/1.0 part closes its connection. Dispose only that endpoint,
    // then build the next body after its request storage can be collected, and
    // open the next connection on the same linkID. Grabbing a second NIE link
    // is the hardware-proven -16009 failure.
    InkNext: func()
    begin
        if not self.inkBusy then return nil;
        local disposeStart := Ticks();
        if self.inkEndpoint then
        begin
            try self.inkEndpoint:SetInputSpec(nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.inkEndpoint := nil;
        end;
        AddArraySlot(self.inkMetrics, {part: self.inkPartIndex,
            total: self.inkTotalParts, build: self.inkBuildMS,
            send: self.inkSendMS,
            endpoint: ((Ticks() - disposeStart) * 1000) div 60, ready: nil});
        self.inkSendMS := nil;
        self.inkBody := :EncodeNextInkPage();
        if self.inkBody = nil then
        begin
            self.askPartCapped := true;
            self.inkTotalParts := self.inkPartIndex;
            return :InkFailed(:CapNotice());
        end;
        return :InkOpen();
    end,

    InkFailed: func(message)
    begin
        self.inkBusy := nil;
        self.inkBody := nil;
        self.inkSendTicks := nil;
        self.askStrokes := nil;
        :SetStatus(message);
        return :InkDone();
    end,

    // ponytail: disposing the endpoint inside its own callback raised -48200 in
    // the ink Stage 3 round; let the close settle first. The ink endpoint goes
    // away after one second; the idle timer then stops the shared tools endpoint
    // and releases their NIE link after five seconds.
    InkDone: func()
    begin
        AddDelayedCall(func(view) try view:InkStop() onexception |evt.ex| do nil, [self], 1000);
        return nil;
    end,

    InkStop: func()
    begin
        local disposeStart := Ticks();
        if self.inkEndpoint then
        begin
            try self.inkEndpoint:SetInputSpec(nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.inkEndpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.inkEndpoint := nil;
        end;
        if (self.inkSendMS <> nil) and (self.inkMetrics <> nil) then
            AddArraySlot(self.inkMetrics, {part: self.inkPartIndex + 1,
                total: self.inkTotalParts, build: self.inkBuildMS,
                send: self.inkSendMS,
                endpoint: ((Ticks() - disposeStart) * 1000) div 60, ready: true});
        self.inkBody := nil;
        self.inkSendTicks := nil;
        self.inkSendMS := nil;
        self.inkHint := nil;
        self.inkMode := nil;
        self.askStrokes := nil;
        // Start the five-second idle period after callback-safe disposal. This
        // also leaves a full heartbeat window to publish the final timing.
        :ArmRadioIdle();
        :ReleaseLink();
        return nil;
    end,

    Dropped: func()
    begin
        if self.stopping then return nil;
        :SetStatus("Offline");
        :ArmRadioIdle();
        :Stop();
    end,

    Failed: func(message)
    begin
        if self.stopping then return nil;
        self.pendingPrompt := nil;
        self.pendingPromptLabel := nil;
        :SetStatus(message);
        :ArmRadioIdle();
        // ponytail: let the peer-close FSM settle before InetReleaseLink.
        AddDelayedCall(func(view) try view:Stop() onexception |evt.ex| do nil, [self], 1000);
    end,

    // ================= the /tools channel (was HarnessToolsR10P) =============
    //
    // The host holds a long poll on 18081 and pushes "TOOLS <id> <op> [arg]";
    // this answers with three escaped lines and polls again. It is the R10P
    // transport unchanged — same 3 s heartbeat, same 4 s watchdog, same
    // async output specs with form: 'string — with three differences forced by
    // living inside the chat app rather than beside it:
    //
    //   1. every name is prefixed Tool*, because NewtonScript symbols are
    //      case-insensitive and Stop/Bound/Connected/ArmInput/Grabbed all
    //      already exist here;
    //   2. it never grabs its own NIE link when the chat already holds one, and
    //      never releases a link another connection is still using;
    //   3. its retry loop watches toolStopping, not the chat's stopping slot,
    //      so a chat reconnect does not silently kill the tools channel.
    //
    // EF14 changes only the lifecycle: InstallScript creates the package-level
    // Notes agent but does not start networking. Connect/InkOpen starts this poll
    // on the already-held NIE link, and RadioExpired stops every endpoint after
    // the active send/reply round has been idle for five seconds.
    //
    // Why one package at all: two apps meant two NIE clients fighting over the
    // single broker slot, which is what raised the cosmetic Communications
    // alerts in the 2026-08-03 hardware test (docs/parallel-emulators.md warns
    // about exactly this), and it meant the human installing two packages.

    ToolStart: func()
    begin
        if not self.radioHeld then return nil;
        self.toolStopping := nil;
        if self.toolEndpoint then return nil;
        if self.linkID then return :ToolOpen();
        call GetGlobalFn('InetGrabLink) with (nil, self, 'ToolGrabbed);
        return nil;
    end,

    ToolGrabbed: func(id, state, error)
    begin
        try
        begin
            if self.toolStopping then return nil;
            if self.toolEndpoint then return nil;
            if error then return :ToolRetry();
            self.linkID := id;
            // NIE progress is not failure: everything before 'connected is ignored.
            if state.linkStatus <> 'connected then return nil;
            return :ToolOpen();
        end
        onexception |evt.ex| do try :ToolRetry() onexception |evt.ex| do nil;
        return nil;
    end,

    ToolOpen: func()
    begin
        if self.toolEndpoint then return nil;
        try
        begin
            // Every endpoint here carries an ExceptionHandler, and that is what
            // buys silence. An unsolicited disconnect has no CompletionScript to
            // land in, and "If no ExceptionHandler method is specified, the
            // exception is passed up the handler chain. Exceptions that are not
            // caught are displayed as warning messages to the user"
            // (refs/NewtonProgrammerRef20.txt:57321-57323) — that warning is the
            // modal "Communications — Sorry, a problem has occurred" slip the
            // hardware test complained about. Catching it turns a modal alert
            // into a one-second reconnect the human never sees.
            self.toolEndpoint := {_proto: self.endpointClass, _parent: self,
                ExceptionHandler: func(error)
                    try self._parent:ToolRetry() onexception |evt.ex| do nil};
            self.toolEndpoint:Instantiate(self.toolEndpoint, [
                {label: "inet", type: 'service, opCode: opSetRequired, result: nil},
                {label: "ilid", type: 'option, opCode: opSetRequired, result: nil,
                 form: 'template, data: {arglist: [self.linkID], typeList: ['struct, 'ulong]}},
                {label: "itsv", type: 'option, opCode: opSetRequired, result: nil,
                 form: 'template, data: {arglist: [1], typeList: ['struct, 'ulong]}},
            ]);
            self.toolEndpoint:Bind(nil, {
                async: true, reqTimeout: 10000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    try
                    begin
                        if result then self._parent:ToolBindFailed()
                        else self._parent:ToolBound();
                    end
                    onexception |evt.ex| do nil,
            });
        end
        onexception |evt.ex| do :ToolRetry();
        return nil;
    end,

    // The tools channel already retries forever, so "surfacing the error" is not
    // what this buys — there is no status line on a headless agent. What it buys
    // is the *first* retry being a slow one: a bind that failed because the
    // previous endpoint has not finished going away needs five seconds, not the
    // ordinary one, and hammering it is how the fourth test's `-60047` repeated.
    ToolBindFailed: func()
    begin
        if self.toolBindRetried then return :ToolRetry();
        self.toolBindRetried := true;
        self.toolStopping := true;
        :ToolStop();
        AddDelayedCall(func(who) try who:ToolResume() onexception |evt.ex| do nil,
            [self], 5000);
        return nil;
    end,

    ToolBound: func()
    begin
        if self.toolStopping then return nil;
        self.toolBindRetried := nil;
        local address := self.serverAddress;
        try
            self.toolEndpoint:connect([{
                label: "itrs", type: 'option, opCode: opSetRequired, result: nil,
                form: 'template,
                data: {arglist: [address[0], address[1], address[2], address[3], self.toolPort],
                       typeList: ['struct, 'byte, 'byte, 'byte, 'byte, 'short]},
            }], {
                async: true, reqTimeout: 45000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    try
                    begin
                        if result then self._parent:ToolRetry()
                        else self._parent:ToolConnected();
                    end
                    onexception |evt.ex| do nil,
            })
        onexception |evt.ex.comm| do :ToolRetry();
        return nil;
    end,

    ToolConnected: func()
    begin
        if self.toolStopping then return nil;
        self.toolReady := true;
        self.toolMisses := 0;
        :ToolPoll();
        // The watchdog only starts once there is something to watch, and it
        // reschedules itself from here on — so it must be started ONCE, not once
        // per connection. See :ToolWatch for what the missing guard cost.
        if not self.toolWatching then
        begin
            self.toolWatching := true;
            AddDelayedCall(func(view) try view:ToolWatch() onexception |evt.ex| do nil,
                [self], 4000);
        end;
        return nil;
    end,

    ToolPoll: func()
    begin
        if not self.toolReady then return nil;
        try self.toolEndpoint:Output("POLL\r\n", nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                try
                begin
                    if result then self._parent:ToolRetry()
                    else self._parent:ToolArmInput();
                end
                onexception |evt.ex| do nil,
        })
        onexception |evt.ex.comm| do :ToolRetry();
        return nil;
    end,

    ToolArmInput: func()
    begin
        if not self.toolReady then return nil;
        try self.toolEndpoint:SetInputSpec({
            _parent: self,
            form: 'string,
            termination: {endSequence: "\r\n"},
            discardAfter: 512,
            InputScript: func(endpoint, data, terminator, options)
                try
                begin
                    // Any line at all — heartbeat included — proves the link.
                    self._parent.toolMisses := 0;
                    if BeginsWith(data, "TOOLS ") then self._parent:ToolDispatch(data);
                    if self._parent.toolReady then self._parent:ToolArmInput();
                end
                onexception |evt.ex| do nil,
        })
        onexception |evt.ex.comm| do :ToolRetry();
        return nil;
    end,

    // 4 s, deliberately above the host's 3 s heartbeat cadence
    // (pkg_publisher.py:77). A faster watchdog forces false reconnects — one of
    // the measured footguns in docs/newton-networking-lessons.md §2.
    //
    // EF6 found the second half of that footgun, and it is worse than a fast
    // watchdog: **a duplicated one**. This chain reschedules itself, and until
    // this round :ToolConnected started a fresh chain on every connect, so each
    // reconnect left the old chain running and added another. N chains means
    // toolMisses is incremented N times per 4 s, three chains cross the
    // threshold in one period, and the channel reconnects continuously.
    // Measured on instance ef6round against the host's own log: **15 reconnects
    // in 60 seconds** (one every 4 s), every one of them the Newton closing the
    // socket mid-response ("persistent Newton connection closed mid-response").
    // With one chain the host's 3 s heartbeat always resets the counter before
    // the 4 s tick and the connection simply stays up.
    //
    // This was always latent; it only became visible when EF6 made the poll
    // package-wide and it ran for minutes instead of for as long as a window was
    // open. It is very probably the "stale-poll 504s after window-close cycles"
    // the fifth hardware test reported.
    ToolWatch: func()
    begin
        if self.toolStopping then
        begin
            // Let :ToolConnected start a fresh chain; do not leave a dead flag
            // behind that would suppress the watchdog forever.
            self.toolWatching := nil;
            return nil;
        end;
        if self.toolReady then
        begin
            self.toolMisses := self.toolMisses + 1;
            if self.toolMisses > 2 then :ToolRetry();
        end;
        AddDelayedCall(func(view) try view:ToolWatch() onexception |evt.ex| do nil, [self], 4000);
        return nil;
    end,

    ToolReply: func()
    begin
        if self.toolID = nil then return :ToolRetry();
        local response := self.toolID & "\r\n" & self.toolOutcome
            & "\r\n" & :Escape(self.toolValue) & "\r\n";
        try self.toolEndpoint:Output(response, nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                try
                begin
                    if result then self._parent:ToolRetry()
                    else self._parent:ToolReplySent();
                end
                onexception |evt.ex| do nil,
        })
        onexception |evt.ex.comm| do :ToolRetry();
        return nil;
    end,

    ToolReplySent: func()
    begin
        if self.toolStopping then return nil;
        local heartbeat := StrEqual(self.toolID, "0");
        self.toolID := nil;
        self.toolOutcome := nil;
        self.toolValue := nil;
        // InputScript has already re-armed input, so this only sends the poll.
        try self.toolEndpoint:Output("POLL\r\n", nil, {
            form: 'string, async: true, reqTimeout: 10000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                try
                begin
                    if result then self._parent:ToolRetry();
                end
                onexception |evt.ex| do nil,
        })
        onexception |evt.ex.comm| do :ToolRetry();
        if not heartbeat then :ArmRadioIdle();
        return nil;
    end,

    ToolDecodeArg: func(value)
    begin
        if value = nil then return nil;
        local digits := "0123456789ABCDEF";
        local out := "";
        local index := 0;
        while index < StrLen(value) do
        begin
            if (value[index] = $%) and ((index + 2) < StrLen(value)) then
            begin
                local hi := StrPos(digits, SubStr(value, index + 1, 1), 0);
                local lo := StrPos(digits, SubStr(value, index + 2, 1), 0);
                if (hi <> nil) and (lo <> nil) then
                begin
                    out := out & Chr((hi * 16) + lo);
                    index := index + 3;
                end
                else
                begin
                    out := out & SubStr(value, index, 1);
                    index := index + 1;
                end;
            end
            else
            begin
                out := out & SubStr(value, index, 1);
                index := index + 1;
            end;
        end;
        return out;
    end,

    PkgProtected: func(identity)
    begin
        if BeginsWith(identity, "EggFreckles") or BeginsWith(identity, "-Loader")
        or BeginsWith(identity, "-HarnessLoader") then return true;
        foreach protected in [
            "NewtsCape:NewtsCape", "JPEGConvert:NewtsCape",
            "Dock ZC & TCP/IP:Kallisys", "PT100:Scrawl",
            "BASIC:NSBASIC", "Runtime:NSBASIC", " Newton Devices",
            "Newton Internet Enabler", "NIE Ethernet Module", "Internet Setup",
            "LucentWaveLAN:Noguchi", "Farallon Enet", "3C589", "z3ComDrv:clli"
        ] do if StrEqual(identity, protected) then return true;
        return nil;
    end,

    PkgFind: func(identity)
    begin
        local stores := GetStores();
        if stores = nil then return nil;
        foreach store in stores do
        begin
            local package := GetPkgRef(identity, store);
            if package then return package;
        end;
        return nil;
    end,

    PkgRemove: func(identity)
    begin
        if identity = nil or StrLen(identity) = 0 then return "identity required";
        if :PkgProtected(identity) then return "protected package: " & identity;
        local root := nil;
        try root := GetRoot().(Intern(identity)) onexception |evt.ex| do root := nil;
        if root then try root:Close() onexception |evt.ex| do nil;
        local removed := nil;
        local stores := GetStores();
        if stores <> nil then
            foreach store in stores do
            begin
                // The two-argument store form is load-bearing: one-argument
                // GetPkgRef fails silently on this ROM.
                local package := GetPkgRef(identity, store);
                if package then
                begin
                    SafeRemovePackage(package);
                    removed := true;
                end;
            end;
        if not removed then return "not installed: " & identity;
        if :PkgFind(identity) then return "remove not confirmed: " & identity;
        return "removed " & identity;
    end,

    PkgFinish: func(outcome, value)
    begin
        if self.pkgEndpoint then
        begin
            try self.pkgEndpoint:SetInputSpec(nil) onexception |evt.ex.comm| do nil;
            try self.pkgEndpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.pkgEndpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.pkgEndpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.pkgEndpoint := nil;
        end;
        self.pkgInput := nil;
        self.pkgBinary := nil;
        self.toolOutcome := outcome;
        self.toolValue := value;
        :ToolReply();
        return nil;
    end,

    PkgInstallStart: func(name)
    begin
        // ponytail: pkg_install exists only inside the active-send window; no
        // background keepalive. EF14 closes the tools channel about 5 s idle.
        if name = nil or StrLen(name) < 5
        or StrPos(name, ".pkg", 0) <> StrLen(name) - 4 then
            return :PkgFinish("error", "basename must end in .pkg");
        local allowed := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.";
        for index := 0 to StrLen(name) - 1 do
            if StrPos(allowed, SubStr(name, index, 1), 0) = nil then
                return :PkgFinish("error", "bad package basename");
        if self.pkgEndpoint then return :PkgFinish("error", "install already active");
        if self.linkID = nil then return :PkgFinish("error", "active send link is gone");
        self.pkgName := name;
        self.pkgHeader := "";
        self.pkgLength := nil;
        self.pkgOffset := 0;
        self.pkgChunk := 0;
        self.pkgInstalledIdentity := nil;
        try
        begin
            self.pkgEndpoint := {_proto: self.endpointClass, _parent: self,
                ExceptionHandler: func(error)
                    try self._parent:PkgFinish("error", "package connection failed")
                    onexception |evt.ex| do nil};
            self.pkgEndpoint:Instantiate(self.pkgEndpoint, [
                {label: "inet", type: 'service, opCode: opSetRequired, result: nil},
                {label: "ilid", type: 'option, opCode: opSetRequired, result: nil,
                 form: 'template, data: {arglist: [self.linkID], typeList: ['struct, 'ulong]}},
                {label: "itsv", type: 'option, opCode: opSetRequired, result: nil,
                 form: 'template, data: {arglist: [1], typeList: ['struct, 'ulong]}},
            ]);
            self.pkgEndpoint:Bind(nil, {
                async: true, reqTimeout: 10000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    try
                    begin
                        if result then self._parent:PkgFinish("error", "package bind failed")
                        else self._parent:PkgBound();
                    end
                    onexception |evt.ex| do nil,
            });
        end
        onexception |evt.ex| do return :PkgFinish("error", "package endpoint failed");
        return nil;
    end,

    PkgBound: func()
    begin
        local address := self.serverAddress;
        try self.pkgEndpoint:connect([{
            label: "itrs", type: 'option, opCode: opSetRequired, result: nil,
            form: 'template,
            data: {arglist: [address[0], address[1], address[2], address[3], self.toolPort],
                   typeList: ['struct, 'byte, 'byte, 'byte, 'byte, 'short]},
        }], {
            async: true, reqTimeout: 45000, _parent: self,
            CompletionScript: func(endpoint, options, result)
                try
                begin
                    if result then self._parent:PkgFinish("error", "package connect failed")
                    else self._parent:PkgConnected();
                end
                onexception |evt.ex| do nil,
        })
        onexception |evt.ex| do :PkgFinish("error", "package connect failed");
        return nil;
    end,

    PkgConnected: func()
    begin
        try self.pkgInput := GetDefaultStore():NewVBO('package, 1024)
        onexception |evt.ex| do return :PkgFinish("error", "no header buffer");
        :PkgArmHeader();
        try self.pkgEndpoint:Output(
            "GET /" & self.pkgName & " HTTP/1.0\r\nHost: 10.42.0.1\r\nConnection: close\r\n\r\n",
            nil, {form: 'string, async: true, reqTimeout: 10000, _parent: self,
                CompletionScript: func(endpoint, options, result)
                    try if result then self._parent:PkgFinish("error", "package request failed")
                    onexception |evt.ex| do nil})
        onexception |evt.ex| do :PkgFinish("error", "package request failed");
        return nil;
    end,

    PkgArmHeader: func()
    begin
        self.pkgEndpoint:SetInputSpec({
            _parent: self, form: 'binary,
            target: {data: self.pkgInput, offset: 0},
            termination: {byteCount: 1024}, discardAfter: 1024,
            InputScript: func(endpoint, data, terminator, options)
                try endpoint._parent:PkgHeaderReceived()
                onexception |evt.ex| do
                    try endpoint._parent:PkgFinish("error", "bad package header")
                    onexception |evt.ex| do nil,
        });
        return nil;
    end,

    PkgHeaderReceived: func()
    begin
        local bodyStart := nil;
        for index := 0 to 1023 do
            if bodyStart = nil then
            begin
                self.pkgHeader := self.pkgHeader & Chr(ExtractByte(self.pkgInput, index));
                if (index >= 3) and StrEqual(
                    SubStr(self.pkgHeader, index - 3, 4), "\r\n\r\n") then
                    bodyStart := index + 1;
            end;
        if bodyStart = nil then return :PkgFinish("error", "package header too long");
        if not BeginsWith(self.pkgHeader, "HTTP/1.0 200") then
            return :PkgFinish("error", "package not staged");
        local lengthStart := StrPos(self.pkgHeader, "Content-Length:", 0);
        if lengthStart = nil then return :PkgFinish("error", "missing package length");
        self.pkgLength := Floor(StringToNumber(SubStr(self.pkgHeader,
            lengthStart + 16, StrLen(self.pkgHeader) - lengthStart - 20)));
        if self.pkgLength <= 0 or self.pkgLength > 524288 then
            return :PkgFinish("error", "bad package length");
        try self.pkgBinary := GetDefaultStore():NewVBO('package, self.pkgLength)
        onexception |evt.ex| do return :PkgFinish("error", "no package buffer");
        self.pkgOffset := 1024 - bodyStart;
        if self.pkgOffset > self.pkgLength then return :PkgFinish("error", "package body too long");
        BinaryMunger(self.pkgBinary, 0, self.pkgOffset,
            self.pkgInput, bodyStart, self.pkgOffset);
        return :PkgArmBody();
    end,

    PkgArmBody: func()
    begin
        self.pkgChunk := self.pkgLength - self.pkgOffset;
        if self.pkgChunk > 8192 then self.pkgChunk := 8192;
        self.pkgEndpoint:SetInputSpec({
            _parent: self, form: 'binary,
            target: {data: self.pkgBinary, offset: self.pkgOffset},
            termination: {byteCount: self.pkgChunk}, discardAfter: self.pkgChunk,
            InputScript: func(endpoint, data, terminator, options)
                try endpoint._parent:PkgBodyReceived()
                onexception |evt.ex| do
                    try endpoint._parent:PkgFinish("error", "package receive failed")
                    onexception |evt.ex| do nil,
        });
        return nil;
    end,

    PkgBodyReceived: func()
    begin
        self.pkgOffset := self.pkgOffset + self.pkgChunk;
        if self.pkgOffset = self.pkgLength then
        begin
            AddDelayedCall(func(view) try view:PkgInstallNow() onexception |evt.ex| do nil,
                [self], 1000);
            return nil;
        end;
        return :PkgArmBody();
    end,

    PkgInstallNow: func()
    begin
        try
        begin
            GetDefaultStore():SuckPackageFromBinary(self.pkgBinary, {
                _parent: self, callbackFrequency: 8192,
                callback: func(progress)
                    self._parent.pkgInstalledIdentity := progress.packageName,
            });
            if self.pkgInstalledIdentity and :PkgFind(self.pkgInstalledIdentity) then
                return :PkgFinish("result", "installed " & self.pkgInstalledIdentity);
            return :PkgFinish("error", "install not confirmed");
        end
        onexception |evt.ex| do return :PkgFinish("error", "package install failed");
    end,

    ToolDispatch: func(line)
    begin
        local tokens := StrTokenize(line, " \r\n");
        local marker := call tokens with ();
        local requestID := call tokens with ();
        local op := call tokens with ();
        local argument := :ToolDecodeArg(call tokens with ());
        if marker = nil or requestID = nil or op = nil then return nil;
        if not StrEqual(requestID, "0") then :RadioHold();
        self.toolID := requestID;
        try
        begin
            if StrEqual(op, "ping") then
            begin
                self.toolOutcome := "result";
                self.toolValue := "pong";
                if StrEqual(requestID, "0") and (self.inkMetrics <> nil)
                    and (self.inkMetricIndex < Length(self.inkMetrics))
                    and self.inkMetrics[self.inkMetricIndex].ready then
                begin
                    local metric := self.inkMetrics[self.inkMetricIndex];
                    self.toolValue := "INKTIME page " & metric.part & "/" & metric.total
                        & " build " & metric.build & " send " & metric.send
                        & " endpoint " & metric.endpoint;
                    self.inkMetricIndex := self.inkMetricIndex + 1;
                end;
            end
            else if StrEqual(op, "front_app") then
            begin
                self.toolOutcome := "result";
                self.toolValue := :FrontApp();
            end
            else if StrEqual(op, "get_note") then
            begin
                // Same nil guard + Floor as pkg_list: a missing argument must
                // not throw, and StringToNumber yields a Real on this ROM.
                local ordinal := 0;
                if argument <> nil then ordinal := StringToNumber(argument);
                if ordinal = nil then ordinal := 0 else ordinal := Floor(ordinal);
                if ordinal < 1 or ordinal > 64 then
                begin
                    self.toolOutcome := "error";
                    self.toolValue := "note ordinal must be 1..64";
                end
                else
                begin
                    self.toolOutcome := "result";
                    self.toolValue := :GetNote(ordinal);
                end;
            end
            else if StrEqual(op, "note_list") then
            begin
                local ordinal := 0;
                if argument <> nil then ordinal := StringToNumber(argument);
                if ordinal = nil then ordinal := 0 else ordinal := Floor(ordinal);
                local total := :NoteCount();
                // Paged for the same reason pkg_list is, and capped at the
                // same 64 as get_note: one reply must never walk an
                // arbitrarily long soup and starve the heartbeat.
                local limit := total;
                if limit > 64 then limit := 64;
                if ordinal = 0 then
                begin
                    self.toolOutcome := "result";
                    self.toolValue := "count=" & total;
                end
                else if ordinal < 1 or ordinal > limit then
                begin
                    self.toolOutcome := "error";
                    self.toolValue := "note ordinal must be 1.." & limit;
                end
                else
                begin
                    self.toolOutcome := "result";
                    self.toolValue := :NoteEntry(ordinal, total);
                end;
            end
            else if StrEqual(op, "note_probe") then
            begin
                self.toolOutcome := "result";
                self.toolValue := :NoteProbe();
            end
            else if StrEqual(op, "battery") then
            begin
                self.toolOutcome := "result";
                self.toolValue := :BatteryInfo();
            end
            else if StrEqual(op, "store_info") then
            begin
                self.toolOutcome := "result";
                self.toolValue := :StoreInfo();
            end
            else if StrEqual(op, "pkg_install") then
            begin
                :PkgInstallStart(argument);
                return nil;
            end
            else if StrEqual(op, "pkg_remove") then
            begin
                self.toolOutcome := "result";
                self.toolValue := :PkgRemove(argument);
                if BeginsWith(self.toolValue, "protected ")
                or BeginsWith(self.toolValue, "identity ")
                or BeginsWith(self.toolValue, "remove not ") then
                    self.toolOutcome := "error";
            end
            else if StrEqual(op, "pkg_list") then
            begin
                local ordinal := 0;
                if argument <> nil then ordinal := StringToNumber(argument);
                // StringToNumber returns a Real on this ROM, and an array
                // cannot be indexed by a Real: packages[1.0 - 1] throws
                // evt.ex.fr.type;type.ref.frame. Floor it back to an integer.
                if ordinal = nil then ordinal := 0 else ordinal := Floor(ordinal);
                local total := :PkgCount();
                if ordinal = 0 then
                begin
                    self.toolOutcome := "result";
                    self.toolValue := "count=" & total;
                end
                else if ordinal < 1 or ordinal > total then
                begin
                    self.toolOutcome := "error";
                    self.toolValue := "package ordinal must be 1.." & total;
                end
                else
                begin
                    self.toolOutcome := "result";
                    self.toolValue := :PkgEntry(ordinal, total);
                end;
            end
            else
            begin
                self.toolOutcome := "unknown_op";
                self.toolValue := "unknown op: " & op;
            end;
        end
        onexception |evt.ex| do
        begin
            local exception := CurrentException();
            self.toolOutcome := "error";
            if HasSlot(exception, 'error) then self.toolValue := "" & exception.error;
            else if HasSlot(exception, 'name) then self.toolValue := "" & exception.name;
            else self.toolValue := "Newton error";
        end;
        :ToolReply();
        return nil;
    end,

    ToolRetry: func()
    begin
        if self.toolStopping then return nil;
        self.toolStopping := true;
        :ToolStop();
        AddDelayedCall(func(view) try view:ToolResume() onexception |evt.ex| do nil, [self], 1000);
        return nil;
    end,

    ToolResume: func()
    begin
        // On the agent this is always nil: it protos to the read-only template,
        // whose `stopping` no view instance can ever write. Kept as a belt: the
        // one thing that must stop this loop is toolStopping, which :NotesHook
        // and RemoveScript both set.
        if self.stopping or not self.radioHeld then return nil;
        self.toolStopping := nil;
        return :ToolStart();
    end,

    ToolStop: func()
    begin
        self.toolReady := nil;
        if self.toolEndpoint then
        begin
            try self.toolEndpoint:SetInputSpec(nil) onexception |evt.ex.comm| do nil;
            try self.toolEndpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.toolEndpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.toolEndpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.toolEndpoint := nil;
        end;
        :ReleaseLink();
        return nil;
    end,

    // ---- the fixed operations themselves, lifted from R10P unchanged ----

    FrontApp: func()
    begin
        local app := GetView('viewFrontMostApp);
        if app = nil then return "";
        local symbol := app.appSymbol;
        return GetAppName(symbol) & " (" & symbol & ")";
    end,

    NumStr: func(value)
    begin
        if value = nil then return "?";
        try
        begin
            if IsInteger(value) then return "" & value;
            return "" & Floor(value);
        end
        onexception |evt.ex| do return "?";
        return "?";
    end,

    SlotOr: func(frame, tag)
    begin
        if not IsFrame(frame) then return nil;
        if not HasSlot(frame, tag) then return nil;
        return frame.(tag);
    end,

    BatteryInfo: func()
    begin
        local count := nil;
        try count := BatteryCount()
        onexception |evt.ex| do count := nil;

        local out := "count=" & :NumStr(count);

        local status := nil;
        try status := BatteryStatus(0)
        onexception |evt.ex| do status := nil;
        if not IsFrame(status) then return out & " status=none";

        local capacity := :SlotOr(status, 'batteryCapacity);
        if capacity = nil then out := out & " cap=?"
        else out := out & " cap=" & :NumStr(capacity) & "%";

        local charge := :SlotOr(status, 'chargeState);
        if charge = nil then out := out & " charge=?"
        else out := out & " charge=" & charge;

        local ac := :SlotOr(status, 'acPower);
        if ac = nil then out := out & " ac=?"
        else out := out & " ac=" & ac;

        local kind := :SlotOr(status, 'batteryType);
        if kind = nil then out := out & " type=?"
        else out := out & " type=" & kind;

        return out;
    end,

    StoreInfo: func()
    begin
        local stores := GetStores();
        if stores = nil then return "stores=0";
        local out := "";
        for index := 0 to Length(stores) - 1 do
        begin
            if StrLen(out) > 0 then out := out & "\n";
            out := out & :StoreLine(stores[index]);
        end;
        if StrLen(out) = 0 then return "stores=0";
        return out;
    end,

    StoreLine: func(store)
    begin
        local name := nil;
        try name := store:GetName()
        onexception |evt.ex| do name := nil;
        if name = nil then name := "?";

        local total := nil;
        try total := store:TotalSize()
        onexception |evt.ex| do total := nil;

        local used := nil;
        try used := store:UsedSize()
        onexception |evt.ex| do used := nil;

        local free := nil;
        if IsInteger(total) and IsInteger(used) then free := total - used;

        local readOnly := "?";
        try
        begin
            if store:IsReadOnly() then readOnly := "y" else readOnly := "n";
        end
        onexception |evt.ex| do readOnly := "?";

        return name & " total=" & :NumStr(total) & " used=" & :NumStr(used)
            & " free=" & :NumStr(free) & " ro=" & readOnly;
    end,

    PkgCount: func()
    begin
        local packages := GetPackages();
        if packages = nil then return 0;
        return Length(packages);
    end,

    PkgEntry: func(ordinal, total)
    begin
        local packages := GetPackages();
        if packages = nil then return "" & ordinal & "/" & total & " ?";
        local package := packages[ordinal - 1];
        if not IsFrame(package) then return "" & ordinal & "/" & total & " ?";

        local title := :SlotOr(package, 'title);
        if title = nil then title := "?" else title := "" & title;

        local size := :SlotOr(package, 'size);

        local storeName := "?";
        local store := :SlotOr(package, 'store);
        if store <> nil then
        begin
            local resolved := nil;
            try resolved := store:GetName()
            onexception |evt.ex| do resolved := nil;
            if resolved <> nil then storeName := resolved;
        end;

        return "" & ordinal & "/" & total & " " & title & "|" & :NumStr(size)
            & "|" & storeName & "|id=" & title;
    end,

    ExceptionName: func()
    begin
        local exception := CurrentException();
        try
        begin
            if IsFrame(exception) then
            begin
                if HasSlot(exception, 'name) then return "" & exception.name;
                if HasSlot(exception, 'error) then return "" & exception.error;
            end;
        end
        onexception |evt.ex| do return "evt.ex";
        return "evt.ex";
    end,

    SlotNames: func(frame)
    begin
        local out := "";
        try
            foreach tag, value in frame do
            begin
                if StrLen(out) > 0 then out := out & ",";
                out := out & tag;
            end
        onexception |evt.ex| do out := out & "!" & :ExceptionName();
        return "[" & out & "]";
    end,

    NoteProbe: func()
    begin
        try return :NoteProbeSteps()
        onexception |evt.ex| do return "probe!" & :ExceptionName();
    end,

    NoteProbeSteps: func()
    begin
        local out := "";
        local stores := nil;
        local targetStore := nil;
        try
        begin
            stores := GetStores();
            out := "stores=" & Length(stores);
        end
        onexception |evt.ex| do out := "stores!" & :ExceptionName();

        if stores <> nil then
            for index := 0 to Length(stores) - 1 do
            begin
                local store := stores[index];
                out := out & ";s" & index & "=";
                try out := out & store:GetName()
                onexception |evt.ex| do out := out & "name!" & :ExceptionName();

                local hasSoup := nil;
                try
                begin
                    hasSoup := store:HasSoup(ROM_paperRollSoupName);
                    if hasSoup then out := out & ":paper=1" else out := out & ":paper=0";
                end
                onexception |evt.ex| do out := out & ":paper!" & :ExceptionName();
                if targetStore = nil and hasSoup then targetStore := store;
            end;

        local soup := nil;
        if targetStore = nil then out := out & ";first=none"
        else
        begin
            try
            begin
                soup := targetStore:GetSoup(ROM_paperRollSoupName);
                out := out & ";soup=get";
            end
            onexception |evt.ex| do out := out & ";soup!" & :ExceptionName();
        end;
        if soup <> nil then
            try out := out & ",class=" & ClassOf(soup)
            onexception |evt.ex| do out := out & ",class!" & :ExceptionName();

        local cursor := nil;
        if soup <> nil then
            try
            begin
                cursor := soup:Query(nil);
                out := out & ";cursor=get";
            end
            onexception |evt.ex| do out := out & ";cursor!" & :ExceptionName();
        if cursor <> nil then
            try out := out & ",class=" & ClassOf(cursor)
            onexception |evt.ex| do out := out & ",class!" & :ExceptionName();

        local entry := nil;
        local gotEntry := nil;
        if cursor <> nil then
            try
            begin
                entry := cursor:Entry();
                gotEntry := true;
                out := out & ";entry=get";
            end
            onexception |evt.ex| do out := out & ";entry!" & :ExceptionName();
        if gotEntry then
        begin
            try out := out & ",class=" & ClassOf(entry)
            onexception |evt.ex| do out := out & ",class!" & :ExceptionName();
            try
            begin
                if entry = nil then out := out & ",kind=nil"
                else if entry = 'deleted then out := out & ",kind=deleted"
                else if IsFrame(entry) then out := out & ",kind=frame"
                else out := out & ",kind=other";
            end
            onexception |evt.ex| do out := out & ",kind!" & :ExceptionName();
            if IsFrame(entry) then out := out & ",slots=" & :SlotNames(entry);
        end;

        local sysData := nil;
        local sysOK := nil;
        if gotEntry then
            try
            begin
                sysData := GetSysEntryData(entry, 'data);
                sysOK := true;
                out := out & ";sysdata=ok";
            end
            onexception |evt.ex| do out := out & ";sysdata!" & :ExceptionName();
        if sysOK then
            try out := out & ",class=" & ClassOf(sysData)
            onexception |evt.ex| do out := out & ",class!" & :ExceptionName();

        local directData := nil;
        local directOK := nil;
        if gotEntry then
            try
            begin
                directData := entry.data;
                directOK := true;
                out := out & ";direct=ok";
            end
            onexception |evt.ex| do out := out & ";direct!" & :ExceptionName();
        if directOK then
            try out := out & ",class=" & ClassOf(directData)
            onexception |evt.ex| do out := out & ",class!" & :ExceptionName();

        local data := nil;
        local dataOK := nil;
        if directOK then
        begin
            data := directData;
            dataOK := true;
            out := out & ";textvia=direct";
        end
        else if sysOK then
        begin
            data := sysData;
            dataOK := true;
            out := out & ";textvia=sys";
        end
        else out := out & ";textvia=none";

        if dataOK then
        begin
            try out := out & ",class=" & ClassOf(data)
            onexception |evt.ex| do out := out & ",class!" & :ExceptionName();
            local dataIsArray := nil;
            try
            begin
                dataIsArray := IsArray(data);
                if dataIsArray then out := out & ",array=1" else out := out & ",array=0";
            end
            onexception |evt.ex| do out := out & ",array!" & :ExceptionName();
            if dataIsArray then
            begin
                local dataLength := nil;
                try
                begin
                    dataLength := Length(data);
                    out := out & ",len=" & dataLength;
                end
                onexception |evt.ex| do out := out & ",len!" & :ExceptionName();
                if dataLength <> nil and dataLength > 0 then
                begin
                    local first := nil;
                    local firstOK := nil;
                    try
                    begin
                        first := data[0];
                        firstOK := true;
                        out := out & ";item0=get";
                    end
                    onexception |evt.ex| do out := out & ";item0!" & :ExceptionName();
                    if firstOK then
                    begin
                        try out := out & ",class=" & ClassOf(first)
                        onexception |evt.ex| do out := out & ",class!" & :ExceptionName();
                        if IsFrame(first) then out := out & ",slots=" & :SlotNames(first)
                        else out := out & ",slots=n/a";
                    end;
                end;
            end;
        end;
        return out;
    end,

    // The R10J cursor walk, unchanged, lifted out so note_list and get_note
    // share one implementation. Returns the ordinal-th entry in ascending
    // timeStamp order across every store that has the paperroll soup, or nil.
    // Walk cost is O(ordinal), never O(soup) -- twelfth finding.
    // This is deliberately still timeStamp order: an ordinal is a paging cursor
    // for one conversation, and the agent asks for "note 7 of 25", not for the
    // newest. "Newest" is Ask's problem, and Ask uses :FindNewest().
    NoteAt: func(ordinal)
    begin
        local cursors := [];
        local entries := [];
        foreach store in GetStores() do
            if store:HasSoup(ROM_paperRollSoupName) then
            begin
                local cursor := store:GetSoup(ROM_paperRollSoupName):Query({indexPath: 'timeStamp});
                AddArraySlot(cursors, cursor);
                AddArraySlot(entries, cursor:Entry());
            end;
        if Length(entries) = 0 then return nil;

        local entry := nil;
        for position := 1 to ordinal do
        begin
            local selected := nil;
            entry := nil;
            for index := 0 to Length(entries) - 1 do
            begin
                local candidate := entries[index];
                if candidate <> nil and candidate <> 'deleted then
                    if entry = nil or GetSysEntryData(candidate, 'timeStamp) < GetSysEntryData(entry, 'timeStamp) then
                    begin
                        entry := candidate;
                        selected := index;
                    end;
            end;
            if entry = nil then return nil;
            if position < ordinal then entries[selected] := cursors[selected]:Next();
        end;
        return entry;
    end,

    NoteText: func(entry)
    begin
        local data := GetSysEntryData(entry, 'data);
        local text := "";
        if IsArray(data) then foreach item in data do
            if item.viewStationery = 'para then
            begin
                if StrLen(text) > 0 then text := text & "\n";
                if IsString(item.text) then text := text & item.text;
                else text := text & DecodeRichString(item.text, ROM_fontSystem10).text;
            end;
        return text;
    end,

    GetNote: func(ordinal)
    begin
        local entry := :NoteAt(ordinal);
        if entry = nil then return "";
        return :NoteText(entry);
    end,

    NoteCount: func()
    begin
        local total := 0;
        foreach store in GetStores() do
            if store:HasSoup(ROM_paperRollSoupName) then
            begin
                local counted := nil;
                try counted := store:GetSoup(ROM_paperRollSoupName)
                    :Query({indexPath: 'timeStamp}):CountEntries()
                onexception |evt.ex| do counted := nil;
                if IsInteger(counted) then total := total + counted;
            end;
        return total;
    end,

    // One short ASCII line: no newlines, no "|" (the field separator), capped.
    OneLine: func(text, limit)
    begin
        local out := "";
        local length := StrLen(text);
        local kept := length;
        if kept > limit then kept := limit;
        local i := 0;
        while i < kept do
        begin
            local ch := SubStr(text, i, 1);
            if ch = "\n" or ch = "\r" or ch = "\t" or ch = "|" then out := out & " "
            else out := out & ch;
            i := i + 1;
        end;
        if length > limit then out := out & "...";
        return out;
    end,

    // Notepad entries usually have no title at all -- every entry on the
    // seeded flash had title = nil -- so fall back to the note's first
    // characters, which is what makes the listing readable.
    NoteLabel: func(entry)
    begin
        local title := nil;
        try title := GetSysEntryData(entry, 'title)
        onexception |evt.ex| do title := nil;
        if title <> nil and not IsString(title) then
            try title := DecodeRichString(title, ROM_fontSystem10).text
            onexception |evt.ex| do title := nil;
        if IsString(title) and StrLen(title) > 0 then return :OneLine(title, 32);

        local text := "";
        try text := :NoteText(entry)
        onexception |evt.ex| do text := "";
        if not IsString(text) or StrLen(text) = 0 then return "(untitled)";
        return :OneLine(text, 32);
    end,

    NoteEntry: func(ordinal, total)
    begin
        local entry := :NoteAt(ordinal);
        if entry = nil then return "" & ordinal & "/" & total & " ?|?";
        local stamp := nil;
        try stamp := GetSysEntryData(entry, 'timeStamp)
        onexception |evt.ex| do stamp := nil;
        return "" & ordinal & "/" & total & " " & :NoteLabel(entry)
            & "|" & :NumStr(stamp);
    end,

    Escape: func(text)
    begin
        local out := "";
        local i := 0;
        while i < StrLen(text) do
        begin
            local ch := SubStr(text, i, 1);
            if ch = "\\" then out := out & "\\\\";
            else if ch = "\"" then out := out & "\\\"";
            else if ch = "\r" then out := out & "\\r";
            else if ch = "\n" then out := out & "\\n";
            else if ch = "\t" then out := out & "\\t";
            else out := out & ch;
            i := i + 1;
        end;
        return out;
    end,

    stepChildren: [
        {
            _proto: protoTitle,
            viewBounds: {left: 0, top: 2, right: 304, bottom: 24},
            title: kAppTitle,
            titleHeight: 18,
        },
        {
            _proto: protoStaticText,
            viewBounds: {left: 14, top: 32, right: 290, bottom: 206},
            viewFont: ROM_fontSystem10,
            // ponytail: protoStaticText defaults to vjLeftH + oneLineOnly, which
            // draws the whole transcript on one clipped line. Drop oneLineOnly.
            viewJustify: vjLeftH,
            // Fixing the line height is what makes the row window exact: 174 px
            // of pane divided by 14 is the twelve rows kVisibleRows promises.
            viewLineSpacing: 14,
            // ponytail: a live paragraph rejects an empty string, so it never
            // starts empty; this doubles as the empty-conversation hint.
            text: "Type a prompt below, then tap Send.",
        },
        {
            _proto: protoDivider,
            viewBounds: {left: 0, top: 214, right: 290, bottom: 232},
            viewFont: ROM_fontSystem10Bold,
            title: "Prompt",
        },
        {
            _proto: protoInputLine,
            viewBounds: {left: 14, top: 236, right: 290, bottom: 354},
            viewFont: ROM_fontSystem10,
            // protoInputLine defaults to oneLineOnly. Removing that flag makes
            // the taller field usable as a multi-line handwriting area.
            viewJustify: vjLeftH,
            viewLineSpacing: 24,
            text: "",
            ViewKeyDownScript: func(key, flags)
            begin
                if (key = kReturnKey) or (key = kEnterKey) then
                begin
                    self:Parent():SendPrompt();
                    return true;
                end;
                return nil;
            end,
        },
        {
            _proto: protoStaticText,
            viewBounds: {left: 14, top: 364, right: 168, bottom: 380},
            viewFont: ROM_fontSystem9,
            text: "Offline",
        },
        {
            _proto: protoTextButton,
            viewBounds: {left: 178, top: 360, right: 230, bottom: 382},
            text: "New",
            buttonClickScript: func() self:Parent():NewChat(),
        },
        {
            _proto: protoTextButton,
            viewBounds: {left: 238, top: 360, right: 290, bottom: 382},
            text: "Send",
            buttonClickScript: func() self:Parent():SendPrompt(),
        },
        // Filing Ask replies back into their source note remains a follow-up.
    ],
};

{
    app: kAppSymbol,
    text: kAppLabel,
    // What Extras draws above "Egg Freckles". A part frame's `icon` slot is a
    // bitmap frame; without it the ROM falls back to the generic blank-package
    // picture, which is what every build up to EF4 shipped.
    icon: kAppIcon,
    theForm: mainView,

    // "The InstallScript function in a package part is executed when an
    // application or auto part is activated on the Newton or whenever the
    // Newton is reset" (Guide:5209-5210) — which is exactly what the two Notes
    // hooks need, because the slot they write is RAM and a reset rebuilds
    // the Notepad's view frame without it (evidence §6). It is deliberately one
    // line: "the system executes a deep clone of the InstallScript function …
    // keep [it] as small as possible … If you need to execute a lot of code,
    // you might want to make a method in the application base template and send
    // it a message from your InstallScript" (Ref:2818-2826).
    InstallScript: func(partFrame)
        try partFrame.theForm:NotesHook(4, 'install)
        onexception |evt.ex| do nil,

    // "Any changes that you make to the system in the InstallScript function
    // must be reversed in the RemoveScript function" (Guide:5223-5234). This
    // one cannot delegate the way InstallScript does: "because the application
    // has been removed, the theForm slot contains an invalid reference"
    // (Ref:2864-2882). So the rebuild is repeated here, and only here.
    //
    // It removes OUR entry and nothing else — never RemoveSlot on routeScripts,
    // which restores the ROM array exactly and would silently discard an item
    // another package appended after us (design §1).
    //
    // It deliberately does NOT RemoveFolder("AI"): RemoveScript runs on every
    // deactivation, package replacement included, so deleting the folder would
    // unfile every answer the user had kept each time they installed a newer
    // Egg Freckles. The folder is the user's data by then.
    RemoveScript: func(frame)
    begin
        try
        begin
            local paperroll := GetRoot().paperroll;
            if IsFrame(paperroll) and IsArray(paperroll.routeScripts) then
            begin
                local rebuilt := [];
                local dropped := nil;
                foreach item in paperroll.routeScripts do
                    if IsFrame(item) and (item.aiHook = frame.app) then
                    begin
                        dropped := true;
                        // EF6: the tools long poll belongs to this agent now, so
                        // removing the package is what stops it — closing the
                        // window no longer does and must not. The flag is set
                        // first and separately: it is a plain slot write that
                        // cannot throw, and it stops the 4 s watchdog and the
                        // retry loop even if the ToolStop message below cannot
                        // be delivered (the package's code is going away, and
                        // the agent's methods live in it).
                        if IsFrame(item.agent) then
                        begin
                            item.agent.toolStopping := true;
                            try item.agent:ToolStop()
                            onexception |evt.ex| do nil;
                            try item.agent:CloseProgress()
                            onexception |evt.ex| do nil;
                        end;
                    end
                    else AddArraySlot(rebuilt, item);
                if dropped then paperroll.routeScripts := rebuilt;
            end;
        end
        onexception |evt.ex| do nil;
        return nil;
    end,
}
