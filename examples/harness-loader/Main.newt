kAppSymbol := '|-HarnessLoaderZC38:jbfly|;
kVersion := "2.2";
kAppTitle := "ZC38 Loader " & kVersion;

mainView := {
    _proto: protoFloatNGo,
    viewJustify: vjParentFullH + vjParentFullV,
    viewBounds: {left: 16, top: 72, right: -16, bottom: -72},
    title: kAppTitle,
    appSymbol: kAppSymbol,
    endpointClass: {
        _proto: protoBasicEndpoint,
        ExceptionHandler: func(error)
        begin
            local text := "X";
            if HasSlot(error, 'name) then text := text & "\nn=" & error.name;
            if HasSlot(error, 'data) then text := text & "\ne=" & error.data;
            if HasSlot(error, 'debug) then text := text & "\nd=" & error.debug;
            self._parent:SetStatus(text);
        end,
    },
    serverAddress: [10, 42, 0, 1],
    serverPort: 18081,
    endpoint: nil,
    linkID: nil,
    resultView: nil,
    lastStatus: nil,
    filenameView: nil,
    packageName: nil,
    packageBinary: nil,
    contentLength: nil,
    bodyOffset: 0,
    bodyChunk: 0,
    installedIdentity: nil,
    allowedChars: "-._0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz",
    attempt: 0,
    stopping: nil,

    ToggleServer: func(button)
    begin
        if self.serverAddress[0] = 10 then
            self.serverAddress := [192, 168, 1, 11]
        else
            self.serverAddress := [10, 42, 0, 1];
        SetValue(button, 'text,
            if self.serverAddress[0] = 10 then "Server: Mars" else "Server: LAN");
    end,

    SetStatus: func(message)
    begin
        self.lastStatus := message;
        SetValue(self.resultView, 'text, message);
    end,

    Stop: func(reason)
    begin
        if self.stopping then return nil;
        self.stopping := true;
        if self.endpoint then
        begin
            try self.endpoint:SetInputSpec(nil) onexception |evt.ex.comm| do nil;
            try self.endpoint:Disconnect(true, nil) onexception |evt.ex.comm| do nil;
            try self.endpoint:UnBind(nil) onexception |evt.ex.comm| do nil;
            try self.endpoint:Dispose() onexception |evt.ex.comm| do nil;
            self.endpoint := nil;
        end;
        if self.linkID then
        begin
            :SetStatus("Stop " & reason);
            call GetGlobalFn('InetReleaseLink) with (self.linkID, self, 'Released);
            self.linkID := nil;
        end;
    end,

    Released: func(id, state, error) nil,

    Install: func(resultView)
    begin
        self.resultView := resultView;
        if self.filenameView = nil then return :SetStatus("No filename field");
        self.packageName := DecodeRichString(self.filenameView:GetRichString(), self.filenameView.viewFont).text;
        if (self.packageName = nil) or (StrLen(self.packageName) < 5)
        or (StrPos(self.packageName, ".pkg", 0) <> StrLen(self.packageName) - 4) then
            return :SetStatus("Enter .pkg name");
        for index := 0 to StrLen(self.packageName) - 1 do
            if StrPos(self.allowedChars, SubStr(self.packageName, index, 1), 0) = nil then
                return :SetStatus("Bad filename");
        self.attempt := 1;
        :TryFetch();
    end,

    TryFetch: func()
    begin
        :Stop("TryFetch");
        self.stopping := nil;
        self.packageBinary := nil;
        self.contentLength := nil;
        self.bodyOffset := 0;
        self.bodyChunk := 0;
        :SetStatus("Try " & self.attempt & "/2");
        call GetGlobalFn('InetGrabLink) with (nil, self, 'Grabbed);
    end,

    Grabbed: func(id, state, error)
    begin
        // ponytail: once the endpoint exists, late link notifications have no job.
        if self.endpoint then return nil;
        if error then return :Failed("Link: " & error);
        self.linkID := id;
        if state.linkStatus <> 'connected then return nil;
        :Resolved(nil, nil);
    end,

    Resolved: func(results, error)
    begin
        local address := self.serverAddress;
        local callName := "Instantiate";
        self.endpoint := {_proto: self.endpointClass, _parent: self};
        try
        begin
            // ponytail: endpoint frame FIRST, options second -- per the Programmer's
            // Guide. Round 7B's options-first order is what threw -48400 kNSErrNotAFrame.
            self.endpoint:Instantiate(self.endpoint, [
                {label: "inet", type: 'service, opCode: opSetRequired, result: nil},
                {
                    label: "ilid", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {arglist: [self.linkID], typeList: ['struct, 'ulong]},
                },
                {
                    label: "itsv", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {arglist: [1], typeList: ['struct, 'ulong]},
                },
            ]);
            callName := "Bind";
            self.endpoint:Bind(nil, {async: nil, reqTimeout: 10000});
            callName := "connect";
            :SetStatus("Connecting");
            self.endpoint:connect([
                {
                    label: "itrs", type: 'option, opCode: opSetRequired, result: nil,
                    form: 'template,
                    data: {
                        arglist: [address[0], address[1], address[2], address[3], self.serverPort],
                        typeList: ['struct, 'byte, 'byte, 'byte, 'byte, 'short],
                    },
                },
            ], {async: nil, reqTimeout: 45000});
            // ponytail: async:nil means connect returns synchronously -- completionScript
            // is never invoked, which is why r11c/r11d sat at "Connecting" forever.
            // Go straight on. Switch to async + completionScript only if we need overlap.
            callName := "Download";
            :Connected(nil, nil);
        end
        onexception |evt.ex| do
        begin
            local exception := CurrentException();
            local exceptionError := call GetGlobalFn('InetGetExceptionError) with (exception);
            :SetStatus(callName & " failed: " & exceptionError);
        end;
    end,

    Connected: func(result, error)
    begin
        if error then return :Failed("Connect: " & error);
        :DownloadPackage();
    end,

    ParseContentLength: func(headers)
    begin
        local start := StrPos(headers, "Content-Length:", 0);
        local finish;
        if start = nil then return nil;
        start := start + StrLen("Content-Length:");
        while (start < StrLen(headers)) and (SubStr(headers, start, 1) = " ") do
            start := start + 1;
        finish := start;
        while (finish < StrLen(headers))
        and (StrPos("0123456789", SubStr(headers, finish, 1), 0) <> nil) do
            finish := finish + 1;
        if finish = start then return nil;
        return StringToNumber(SubStr(headers, start, finish - start));
    end,

    InstallNow: func(binary)
    begin
        self.installedIdentity := nil;
        try
        begin
            GetDefaultStore():SuckPackageFromBinary(binary, {
                _parent: self,
                callbackFrequency: 8192,
                callback: func(progress)
                    self._parent.installedIdentity := progress.packageName,
            });
            if self.installedIdentity
            and GetPkgRef(self.installedIdentity, GetDefaultStore()) then
                :SetStatus(self.installedIdentity & " installed")
            else
                :SetStatus("Install not confirmed");
        end
        onexception |evt.ex| do
        begin
            local exception := CurrentException();
            local code := call GetGlobalFn('InetGetExceptionError) with (exception);
            :SetStatus("Install failed: " & code);
        end;
    end,

    InstallBinaryLater: func(binary)
    begin
        AddDelayedCall(func(view, theBinary) view:InstallNow(theBinary),
            [self, binary], 1000);
    end,

    ReportCallbackException: func(callbackName, endpoint, exception)
    begin
        local exceptionText := self.lastStatus;
        local exceptionError := call GetGlobalFn('InetGetExceptionError) with (exception);
        if HasSlot(exception, 'name) then
            exceptionText := exceptionText & "\nn=" & exception.name;
        exceptionText := exceptionText & "\ne=" & exceptionError;
        :SetStatus(exceptionText);
        endpoint:SetInputSpec(nil);
    end,

    ArmHeader: func()
    begin
        self.endpoint:SetInputSpec({
            _parent: self,
            form: 'string,
            termination: {endSequence: "\r\n\r\n"},
            discardAfter: 4096,
            InputScript: func(endpoint, data, terminator, options)
            begin
                try endpoint._parent:HeaderReceived(data)
                onexception |evt.ex| do
                    endpoint._parent:ReportCallbackException("Header", endpoint, CurrentException());
            end,
        });
        return nil;
    end,

    HeaderReceived: func(headers)
    begin
        if not BeginsWith(headers, "HTTP/1.0 200") then
            return :Failed("HTTP not 200");
        self.contentLength := :ParseContentLength(headers);
        if (self.contentLength = nil) or (self.contentLength <= 0)
        or (self.contentLength > 524288) then
            return :Failed("Bad Content-Length");
        try self.packageBinary := GetDefaultStore():NewVBO('package, self.contentLength)
        onexception |evt.ex| do return :Failed("No package buffer");
        :SetStatus("Got 0/" & self.contentLength);
        // ponytail: endSequence leaves the body queued; receive it directly into the package VBO.
        return :ArmBody();
    end,

    ArmBody: func()
    begin
        self.bodyChunk := self.contentLength - self.bodyOffset;
        if self.bodyChunk > 8192 then self.bodyChunk := 8192;
        self.endpoint:SetInputSpec({
            _parent: self,
            form: 'binary,
            target: {data: self.packageBinary, offset: self.bodyOffset},
            termination: {byteCount: self.bodyChunk},
            discardAfter: self.bodyChunk,
            InputScript: func(endpoint, data, terminator, options)
            begin
                try endpoint._parent:BodyReceived()
                onexception |evt.ex| do
                    endpoint._parent:ReportCallbackException("Body", endpoint, CurrentException());
            end,
        });
        return nil;
    end,

    BodyReceived: func()
    begin
        self.bodyOffset := self.bodyOffset + self.bodyChunk;
        :SetStatus("Got " & self.bodyOffset & "/" & self.contentLength);
        if self.bodyOffset = self.contentLength then return :InputReceived();
        return :ArmBody();
    end,

    InputReceived: func()
    begin
        :InstallBinaryLater(self.packageBinary);
        :SetStatus(self.packageName & " installing");
        return nil;
    end,

    DownloadPackage: func()
    begin
        :ArmHeader();
        :SetStatus("GET /" & self.packageName & "...");
        self.endpoint:output(
            "GET /" & self.packageName & " HTTP/1.0\r\nHost: 10.42.0.1\r\nConnection: close\r\n\r\n",
            nil,
            {
                form: 'string,
                async: true,
                reqTimeout: 10000,
                _parent: self,
                CompletionScript: func(endpoint, options, result)
                    if result then self._parent:Failed("Request: " & result),
            });
        return nil;
    end,

    Failed: func(message)
    begin
        if self.stopping then return nil;
        self.stopping := true;
        local retry := self.attempt < 2;
        if retry then
        begin
            self.attempt := self.attempt + 1;
            :SetStatus("Retry: " & message);
        end else
            :SetStatus("Failed twice:\n" & message & "\nTap retry");
        AddDeferredCall(
            func(view, status)
            begin
                view.stopping := nil;
                view:Stop("Failed");
                view:SetStatus(status);
            end,
            [self, self.lastStatus]);
        // ponytail: teardown must run first; then one deferred retry handles transient failures.
        if retry then AddDeferredCall(func(view) view:TryFetch(), [self]);
    end,

    stepChildren: [
        {
            _proto: protoStaticText,
            viewJustify: vjParentFullH + vjParentTopV,
            viewBounds: {left: 12, top: 14, right: -12, bottom: 82},
            text: kAppTitle & "\nFile:",
            viewFont: ROM_fontSystem12Bold,
        },
        {
            _proto: protoInputLine,
            // ponytail: bind the live child at setup; pixel offsets and child order both drift.
            ViewSetupDoneScript: func()
            begin
                inherited:?ViewSetupDoneScript();
                self:Parent().filenameView := self;
            end,
            viewJustify: vjParentFullH + vjParentTopV,
            viewBounds: {left: 20, top: 90, right: -20, bottom: 116},
            // ponytail: prefill the usual target; a 1997 stylus should not retype this each round.
            text: "install.pkg",
            viewFont: ROM_fontSystem10,
        },
        {
            _proto: protoTextButton,
            viewJustify: vjParentFullH + vjParentFullV,
            viewBounds: {left: 20, top: 126, right: -20, bottom: 158},
            text: "Server: Mars",
            viewFont: ROM_fontSystem10,
            buttonClickScript: func() self:Parent():ToggleServer(self),
        },
        {
            _proto: protoTextButton,
            viewJustify: vjParentFullH + vjParentFullV,
            viewBounds: {left: 20, top: 166, right: -20, bottom: -12},
            text: "Install",
            viewFont: ROM_fontSystem12Bold,
            buttonClickScript: func() self:Parent():Install(self),
        },
    ],
};

{
    app: kAppSymbol,
    text: kAppTitle,
    theForm: mainView,
}
